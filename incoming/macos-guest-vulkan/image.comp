#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, rgba32ui) uniform readonly uimage2D inputs[2];
layout(set = 0, binding = 1, rgba32ui) uniform readonly uimage2D tail;
layout(set = 0, binding = 2, std430) writeonly buffer Output { uint values[]; } result;
void main() {
    result.values[0] = imageLoad(inputs[0], ivec2(0)).r;
    result.values[1] = imageLoad(inputs[1], ivec2(0)).r;
    result.values[2] = imageLoad(tail, ivec2(0)).r;
}

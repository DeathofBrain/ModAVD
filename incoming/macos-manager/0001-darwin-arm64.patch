@@ -0,0 +1,92 @@
+//go:build darwin
+
+package update
+
+import (
+	"archive/zip"
+	"bytes"
+	"modavd/internal/jsonord"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestDarwinExecutableModes(t *testing.T) {
+	var data bytes.Buffer
+	w := zip.NewWriter(&data)
+	h := &zip.FileHeader{Name: "tools/modavd", Method: zip.Store}
+	h.SetMode(0755)
+	entry, err := w.CreateHeader(h)
+	if err != nil {
+		t.Fatal(err)
+	}
+	entry.Write([]byte("test executable"))
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	zr, err := zip.NewReader(bytes.NewReader(data.Bytes()), int64(data.Len()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	dir := t.TempDir()
+	dst := filepath.Join(dir, "extracted")
+	if err := os.WriteFile(dst, []byte("old"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := extractEntry(zipEntry{"tools/modavd", zr.File[0]}, dst); err != nil {
+		t.Fatal(err)
+	}
+	copy := filepath.Join(dir, "copied")
+	if err := os.WriteFile(copy, []byte("old"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := copyFile(dst, copy); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{dst, copy} {
+		st, err := os.Stat(path)
+		if err != nil || st.Mode().Perm() != 0755 {
+			t.Fatalf("lost executable mode at %s: %v %v", path, st, err)
+		}
+	}
+}
+
+func TestDarwinManifestAndSettings(t *testing.T) {
+	version, ok := ParseVersion("v0.36.0")
+	if !ok {
+		t.Fatal("version")
+	}
+	manifest, err := jsonord.Parse([]byte(`{"version":"v0.36.0","build":36,"platform":"mac-arm64"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := checkPackageManifest(manifest.Obj(), version); err != nil {
+		t.Fatal(err)
+	}
+	manifest.Obj().Set("platform", jsonord.NewString("win-x64"))
+	if err := checkPackageManifest(manifest.Obj(), version); err == nil {
+		t.Fatal("Windows package accepted")
+	}
+	saved := settingsPath
+	path := filepath.Join(t.TempDir(), "settings.json")
+	settingsPath = func() string { return path }
+	defer func() { settingsPath = saved }()
+	if s := LoadSettings(); s.Source != SourceGitHub || s.HasCDK() {
+		t.Fatalf("defaults: %+v", s)
+	}
+	if _, err := SaveSettings(SourceMirrorChyan, nil); err != nil {
+		t.Fatal(err)
+	}
+	if s := LoadSettings(); s.Source != SourceMirrorChyan || s.HasCDK() {
+		t.Fatalf("saved: %+v", s)
+	}
+	st, err := os.Stat(path)
+	if err != nil || st.Mode().Perm() != 0600 {
+		t.Fatalf("settings permissions: %v %v", st, err)
+	}
+	b, err := os.ReadFile(path)
+	if err != nil || strings.Contains(string(b), "cdk") {
+		t.Fatalf("unexpected credential: %s %v", b, err)
+	}
+}

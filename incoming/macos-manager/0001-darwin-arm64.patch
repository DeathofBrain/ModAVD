+//go:build darwin
+
+package root
+
+import (
+	"modavd/internal/jsonord"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestDarwinAppRootAndAtomicReplacement(t *testing.T) {
+	r := newRoot(t)
+	writeFile(t, r.MetadataPath(), []byte(`{"generation":1}`))
+	exe := filepath.Join(r.Dir, "ModAVD.app", "Contents", "MacOS", "ModAVD")
+	got, err := resolve("", "", exe)
+	if err != nil || got.Dir != r.Dir {
+		t.Fatalf("app root: %v %v", got, err)
+	}
+	reader, err := os.Open(r.MetadataPath())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	if err := r.UpdateMetadata(func(o *jsonord.Obj) error { o.Set("generation", jsonord.NewInt(2)); return nil }); err != nil {
+		t.Fatal(err)
+	}
+	var original [16]byte
+	n, err := reader.Read(original[:])
+	if err != nil || string(original[:n]) != `{"generation":1}` {
+		t.Fatalf("existing reader changed: %q %v", original[:n], err)
+	}
+	if value, _ := r.MetadataLoose().Obj().Get("generation").Int(); value != 2 {
+		t.Fatal("replacement not committed")
+	}
+	if !NativeARM64 || AdbBinary != "adb" || QemuHostDir != "darwin-aarch64" || ReleasePlatform != "mac-arm64" {
+		t.Fatal("wrong runtime profile")
+	}
+}
+
+func TestDarwinLocalPackageContract(t *testing.T) {
+	r := newRoot(t)
+	// Literal paths mirror ports/macos/package.py, rather than deriving the fixture from Manager's profile.
+	files := map[string]string{
+		"sdk/platform-tools/adb":                                           "fixture",
+		"sdk/emulator/emulator":                                            "fixture",
+		"sdk/emulator/qemu/darwin-aarch64/qemu-system-aarch64":             "fixture",
+		"sdk/emulator/qemu/darwin-aarch64/qemu-system-aarch64-headless":    "fixture free-page-reporting",
+		"sdk/emulator/source.properties":                                   "Pkg.Revision=37.2.10\nPkg.BuildId=mas-36\n",
+		"sdk/system-images/android-34/google_apis/arm64-v8a/system.img":    "fixture",
+		"sdk/system-images/android-34/google_apis/arm64-v8a/vendor.img":    "fixture",
+		"sdk/system-images/android-34/google_apis/arm64-v8a/kernel-ranchu": "fixture",
+		"sdk/system-images/android-34/google_apis/arm64-v8a/ramdisk.img":   "fixture",
+		"components/modavd-ime.apk":                                        "fixture",
+		"modavd-manifest.json":                                             `{"schema":1,"version":"0.36.0","build":36,"platform":"mac-arm64","channel":"local-development"}`,
+	}
+	for path, contents := range files {
+		writeFile(t, filepath.Join(r.Dir, path), []byte(contents))
+	}
+	if missing := r.Missing(); len(missing) != 0 {
+		t.Fatalf("local package rejected: %v", missing)
+	}
+	if r.VersionText() != "0.36.0" || r.EmulatorVersion() != "37.2.10" {
+		t.Fatalf("package version = %s / %s", r.VersionText(), r.EmulatorVersion())
+	}
+	if r.ImeAPK() != filepath.Join(r.Dir, "components", "modavd-ime.apk") {
+		t.Fatal("host IME package path mismatch")
+	}
+	for _, component := range r.Components() {
+		if component.ID == "launcher" && (component.Installed || !component.Optional) {
+			t.Fatal("--without-launcher package must remain valid")
+		}
+	}
+	if err := os.Remove(filepath.Join(r.Dir, "sdk/system-images/android-34/google_apis/arm64-v8a/vendor.img")); err != nil {
+		t.Fatal(err)
+	}
+	if missing := r.Missing(); len(missing) != 1 || missing[0] != SystemImageName {
+		t.Fatalf("partial package must be rejected: %v", missing)
+	}
+}

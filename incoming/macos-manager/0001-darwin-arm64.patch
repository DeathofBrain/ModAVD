+/*
+#cgo LDFLAGS: -framework Foundation -framework Security
+#include <libproc.h>
+#include <sys/proc_info.h>
+#include <sys/sysctl.h>
+#include <sys/socket.h>
+#include <sys/mman.h>
+#include <netinet/in.h>
+#include <mach/mach.h>
+#include <Security/Security.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <string.h>
+
+static int process_info(int pid, struct proc_bsdinfo *b) {
+    return proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, b, sizeof(*b));
+}
+static unsigned long long cpu_time(int pid) {
+    struct proc_taskinfo t;
+    if (proc_pidinfo(pid, PROC_PIDTASKINFO, 0, &t, sizeof(t)) != sizeof(t)) return 0;
+    return t.pti_total_user + t.pti_total_system;
+}
+static int process_args(int pid, char *buf, size_t *size) {
+    int mib[3] = {CTL_KERN, KERN_PROCARGS2, pid};
+    return sysctl(mib, 3, buf, size, NULL, 0);
+}
+static int argument_limit(void) {
+    int limit = 0; size_t size = sizeof(limit); int mib[2] = {CTL_KERN, KERN_ARGMAX};
+    if (sysctl(mib, 2, &limit, &size, NULL, 0) != 0) return 0;
+    return limit;
+}
+static int listen_port(int pid, int fd) {
+    struct socket_fdinfo info;
+    if (proc_pidfdinfo(pid, fd, PROC_PIDFDSOCKETINFO, &info, sizeof(info)) != sizeof(info)) return 0;
+    if (info.psi.soi_kind != SOCKINFO_TCP || info.psi.soi_proto.pri_tcp.tcpsi_state != 1) return 0;
+    return ntohs((uint16_t)info.psi.soi_proto.pri_tcp.tcpsi_ini.insi_lport);
+}
+static unsigned long long available_memory(void) {
+    vm_statistics64_data_t v;
+    mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+    vm_size_t page;
+    mach_port_t h = mach_host_self();
+    if (host_page_size(h, &page) != KERN_SUCCESS ||
+        host_statistics64(h, HOST_VM_INFO64, (host_info64_t)&v, &count) != KERN_SUCCESS) {
+        mach_port_deallocate(mach_task_self(), h); return 0;
+    }
+    mach_port_deallocate(mach_task_self(), h);
+    return (v.free_count + v.inactive_count + v.purgeable_count) * (unsigned long long)page;
+}
+static int shm_exists(const char *name) {
+    int fd = shm_open(name, O_RDONLY, 0); if (fd < 0) return 0; close(fd); return 1;
+}
+// Store a per-user wrapping key in Keychain; the encrypted settings file remains portable only within that login.
+static OSStatus keychain_key(const char *account, unsigned char *key, int create) {
+    CFStringRef accountString = CFStringCreateWithCString(NULL, account, kCFStringEncodingUTF8);
+    if (!accountString) return errSecAllocate;
+    CFMutableDictionaryRef query = CFDictionaryCreateMutable(NULL, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(query, kSecClass, kSecClassGenericPassword);
+    CFDictionarySetValue(query, kSecAttrService, CFSTR("org.modavd.manager.settings"));
+    CFDictionarySetValue(query, kSecAttrAccount, accountString);
+    CFDictionarySetValue(query, kSecReturnData, kCFBooleanTrue);
+    CFTypeRef data = NULL;
+    OSStatus status = SecItemCopyMatching(query, &data);
+    if (status == errSecSuccess) {
+        if (CFGetTypeID(data) == CFDataGetTypeID() && CFDataGetLength((CFDataRef)data) == 32)
+            memcpy(key, CFDataGetBytePtr((CFDataRef)data), 32);
+        else status = errSecDecode;
+        CFRelease(data);
+    } else if (status == errSecItemNotFound && create) {
+        status = SecRandomCopyBytes(kSecRandomDefault, 32, key);
+        if (status == errSecSuccess) {
+            CFDictionaryRemoveValue(query, kSecReturnData);
+            CFDataRef value = CFDataCreate(NULL, key, 32);
+            CFDictionarySetValue(query, kSecValueData, value);
+            status = SecItemAdd(query, NULL);
+            CFRelease(value);
+        }
+    }
+    CFRelease(query);
+    CFRelease(accountString);
+    if (status == errSecDuplicateItem && create) return keychain_key(account, key, 0);
+    return status;
+}
+*/
+import "C"
+
+import (
+	"bytes"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+	"unsafe"
+)
+
+// Created is the process start time in Unix microseconds on Darwin. Never compare identities across hosts.
+type Process struct {
+	PID, PPID uint32
+	Name      string
+	Created   uint64
+}
+type Listener struct {
+	Port int
+	PID  uint32
+}
+type StartOptions struct {
+	Dir        string
+	Env        []string
+	Output     *os.File
+	OutputPath string
+}
+type FileLock struct{ f *os.File }
+
+var OrphanHelper string
+
+const SpawnHelperArg = "__spawn"
+
+func HideCommand(cmd *exec.Cmd) {}
+func FindProcess(pid uint32) (Process, bool) {
+	var b C.struct_proc_bsdinfo
+	if C.process_info(C.int(pid), &b) != C.int(unsafe.Sizeof(b)) {
+		return Process{}, false
+	}
+	return Process{PID: pid, PPID: uint32(b.pbi_ppid), Name: C.GoString(&b.pbi_name[0]),
+		Created: uint64(b.pbi_start_tvsec)*1000000 + uint64(b.pbi_start_tvusec)}, true
+}
+func ListProcesses() ([]Process, error) {
+	n := C.proc_listallpids(nil, 0)
+	if n <= 0 {
+		return nil, errors.New("proc_listallpids failed")
+	}
+	ids := make([]C.int, int(n)+128)
+	n = C.proc_listallpids(unsafe.Pointer(&ids[0]), C.int(len(ids)*4))
+	if n < 0 {
+		return nil, errors.New("proc_listallpids failed")
+	}
+	var result []Process
+	for _, id := range ids[:min(int(n), len(ids))] {
+		if p, ok := FindProcess(uint32(id)); ok {
+			result = append(result, p)
+		}
+	}
+	return result, nil
+}
+func ProcessName(pid uint32) string { p, _ := FindProcess(pid); return p.Name }
+func (p Process) current() bool {
+	q, ok := FindProcess(p.PID)
+	return ok && (p.Created == 0 || p.Created == q.Created)
+}
+func (p Process) Alive() bool {
+	if !p.current() {
+		return false
+	}
+	var b C.struct_proc_bsdinfo
+	return C.process_info(C.int(p.PID), &b) == C.int(unsafe.Sizeof(b)) && b.pbi_status != 5
+}
+func (p Process) StartedAt() time.Time {
+	if p.Created == 0 {
+		return time.Time{}
+	}
+	return time.UnixMicro(int64(p.Created))
+}
+func (p Process) CommandLine() ([]string, error) {
+	if !p.current() {
+		return nil, os.ErrProcessDone
+	}
+	limit := int(C.argument_limit())
+	if limit < 4096 {
+		return nil, errors.New("cannot read kern.argmax")
+	}
+	buf := make([]byte, limit)
+	size := C.size_t(len(buf))
+	if rc, err := C.process_args(C.int(p.PID), (*C.char)(unsafe.Pointer(&buf[0])), &size); rc != 0 {
+		return nil, fmt.Errorf("cannot read argv for pid %d: %w", p.PID, err)
+	}
+	buf = buf[:int(size)]
+	if len(buf) < 4 {
+		return nil, errors.New("short process arguments")
+	}
+	argc := int(binary.NativeEndian.Uint32(buf[:4]))
+	buf = buf[4:]
+	// Executable path precedes padding and then argc NUL-terminated arguments.
+	end := bytes.IndexByte(buf, 0)
+	if end < 0 {
+		return nil, errors.New("invalid process arguments")
+	}
+	buf = bytes.TrimLeft(buf[end:], "\x00")
+	args := make([]string, 0, argc)
+	for len(args) < argc {
+		end = bytes.IndexByte(buf, 0)
+		if end < 0 {
+			break
+		}
+		args = append(args, string(buf[:end]))
+		buf = buf[end+1:]
+	}
+	if len(args) != argc {
+		return nil, errors.New("incomplete process arguments")
+	}
+	return args, nil
+}
+func (p Process) ImagePath() (string, error) {
+	if !p.current() {
+		return "", os.ErrProcessDone
+	}
+	buf := make([]byte, 4096)
+	n := C.proc_pidpath(C.int(p.PID), unsafe.Pointer(&buf[0]), C.uint32_t(len(buf)))
+	if n <= 0 {
+		return "", fmt.Errorf("cannot read executable for pid %d", p.PID)
+	}
+	return string(bytes.TrimRight(buf[:int(n)], "\x00")), nil
+}
+func (p Process) Wait(d time.Duration) bool {
+	until := time.Now().Add(d)
+	for p.Alive() {
+		if time.Now().After(until) {
+			return false
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	return true
+}
+
+// Darwin cannot query the exit status of an arbitrary detached process. Never fabricate success.
+func (p Process) ExitCode() (uint32, bool) { return 0, false }
+func (p Process) CPUTime() (time.Duration, bool) {
+	if !p.current() {
+		return 0, false
+	}
+	return time.Duration(C.cpu_time(C.int(p.PID))), true
+}
+func (p Process) Kill() error {
+	if !p.current() {
+		return nil
+	}
+	err := syscall.Kill(int(p.PID), syscall.SIGKILL)
+	if err == syscall.ESRCH {
+		return nil
+	}
+	return err
+}
+func KillTree(p Process) error {
+	if !p.current() {
+		return nil
+	}
+	all, err := ListProcesses()
+	if err != nil {
+		return err
+	}
+	for _, q := range all {
+		if q.PPID == p.PID {
+			if err := KillTree(q); err != nil {
+				return err
+			}
+		}
+	}
+	return p.Kill()
+}
+func Listeners() ([]Listener, error) {
+	processes, err := ListProcesses()
+	if err != nil {
+		return nil, err
+	}
+	var result []Listener
+	for _, p := range processes {
+		n := C.proc_pidinfo(C.int(p.PID), C.PROC_PIDLISTFDS, 0, nil, 0)
+		if n <= 0 {
+			continue
+		}
+		fds := make([]C.struct_proc_fdinfo, int(n)/int(unsafe.Sizeof(C.struct_proc_fdinfo{}))+16)
+		n = C.proc_pidinfo(C.int(p.PID), C.PROC_PIDLISTFDS, 0, unsafe.Pointer(&fds[0]), C.int(len(fds)*int(unsafe.Sizeof(fds[0]))))
+		if n <= 0 {
+			continue
+		}
+		for _, fd := range fds[:int(n)/int(unsafe.Sizeof(fds[0]))] {
+			if fd.proc_fdtype != C.PROX_FDTYPE_SOCKET {
+				continue
+			}
+			port := int(C.listen_port(C.int(p.PID), C.int(fd.proc_fd)))
+			if port > 0 {
+				result = append(result, Listener{port, p.PID})
+			}
+		}
+	}
+	return result, nil
+}
+func ListenerPID(port int) (uint32, bool, error) {
+	ls, e := Listeners()
+	for _, l := range ls {
+		if l.Port == port {
+			return l.PID, true, e
+		}
+	}
+	return 0, false, e
+}
+func BusyPorts(ports []int) ([]int, error) {
+	ls, e := Listeners()
+	set := map[int]bool{}
+	for _, l := range ls {
+		set[l.Port] = true
+	}
+	var busy []int
+	for _, p := range ports {
+		if set[p] {
+			busy = append(busy, p)
+		}
+	}
+	return busy, e
+}
+func TryLock(path string) (*FileLock, bool, error) { return Lock(path, 0) }
+func Lock(path string, timeout time.Duration) (*FileLock, bool, error) {
+	if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+		return nil, false, err
+	}
+	f, e := os.OpenFile(path, os.O_RDWR|os.O_CREATE, 0600)
+	if e != nil {
+		return nil, false, e
+	}
+	until := time.Now().Add(timeout)
+	for {
+		e = syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
+		if e == nil {
+			return &FileLock{f}, true, nil
+		}
+		if e != syscall.EWOULDBLOCK {
+			f.Close()
+			return nil, false, e
+		}
+		if !time.Now().Before(until) {
+			f.Close()
+			return nil, false, nil
+		}
+		time.Sleep(25 * time.Millisecond)
+	}
+}
+func (l *FileLock) Unlock() {
+	if l != nil && l.f != nil {
+		syscall.Flock(int(l.f.Fd()), syscall.LOCK_UN)
+		l.f.Close()
+		l.f = nil
+	}
+}
+func StartDetached(exe string, args []string, opt StartOptions) (Process, error) {
+	cmd := exec.Command(exe, args...)
+	cmd.Dir = opt.Dir
+	cmd.Env = opt.Env
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true}
+	output := opt.Output
+	var opened *os.File
+	if output == nil {
+		path := opt.OutputPath
+		if path == "" {
+			path = os.DevNull
+		} else {
+			if e := os.MkdirAll(filepath.Dir(path), 0755); e != nil {
+				return Process{}, e
+			}
+		}
+		var e error
+		opened, e = os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_APPEND, 0600)
+		if e != nil {
+			return Process{}, e
+		}
+		defer opened.Close()
+		output = opened
+	}
+	input, e := os.Open(os.DevNull)
+	if e != nil {
+		return Process{}, e
+	}
+	defer input.Close()
+	cmd.Stdin = input
+	cmd.Stdout = output
+	cmd.Stderr = output
+	if e := cmd.Start(); e != nil {
+		return Process{}, e
+	}
+	pid := uint32(cmd.Process.Pid)
+	p, ok := FindProcess(pid)
+	if !ok {
+		p = Process{PID: pid}
+	}
+	go cmd.Wait()
+	return p, nil
+}
+
+type spawnRequest struct {
+	Exe  string
+	Args []string
+	Opt  StartOptions
+}
+
+func StartOrphan(exe string, args []string, opt StartOptions) (Process, error) {
+	if OrphanHelper == "" {
+		return StartDetached(exe, args, opt)
+	}
+	req, e := json.Marshal(spawnRequest{exe, args, opt})
+	if e != nil {
+		return Process{}, e
+	}
+	cmd := exec.Command(OrphanHelper, SpawnHelperArg)
+	cmd.Stdin = bytes.NewReader(req)
+	cmd.Stderr = os.Stderr
+	out, e := cmd.Output()
+	if e != nil {
+		return Process{}, fmt.Errorf("spawn helper: %w", e)
+	}
+	var p Process
+	if e = json.Unmarshal(out, &p); e != nil {
+		return p, e
+	}
+	if p.PID == 0 {
+		return p, errors.New("spawn helper returned no pid")
+	}
+	return p, nil
+}
+func SpawnHelperMain(args []string, stdout *os.File) int {
+	if len(args) != 0 {
+		return 2
+	}
+	var req spawnRequest
+	if json.NewDecoder(os.Stdin).Decode(&req) != nil {
+		return 2
+	}
+	p, e := StartDetached(req.Exe, req.Args, req.Opt)
+	if e != nil {
+		fmt.Fprintln(os.Stderr, e)
+		return 1
+	}
+	if json.NewEncoder(stdout).Encode(p) != nil {
+		return 1
+	}
+	return 0
+}
+func DiskFree(path string) (uint64, error) {
+	var s syscall.Statfs_t
+	for {
+		err := syscall.Statfs(path, &s)
+		if err == nil {
+			return s.Bavail * uint64(s.Bsize), nil
+		}
+		parent := filepath.Dir(path)
+		if parent == path {
+			return 0, err
+		}
+		path = parent
+	}
+}
+func AvailableMemoryMB() (uint64, error) {
+	n := uint64(C.available_memory())
+	if n == 0 {
+		return 0, errors.New("host_statistics64 failed")
+	}
+	return n / (1024 * 1024), nil
+}
+func SetAboveNormalPriority(p Process) error {
+	if !p.current() {
+		return os.ErrProcessDone
+	}
+	return syscall.Setpriority(syscall.PRIO_PROCESS, int(p.PID), 0)
+}
+func BigL3CPUs() (uint64, []int, bool) { return 0, nil, false } // Apple Silicon scheduling belongs to the OS.
+func SetAffinity(p Process, mask uint64) error {
+	return errors.New("CPU affinity is not available on Darwin")
+}
+func SharedMemoryExists(name string) bool {
+	name = strings.TrimPrefix(name, "SHM_")
+	c := C.CString(name)
+	defer C.free(unsafe.Pointer(c))
+	return C.shm_exists(c) != 0
+}
+
+var keyMu sync.Mutex
+
+func wrappingKey(entropy []byte, create bool) ([]byte, error) {
+	keyMu.Lock()
+	defer keyMu.Unlock()
+	h := sha256.Sum256(entropy)
+	account := C.CString(hex.EncodeToString(h[:]))
+	defer C.free(unsafe.Pointer(account))
+	key := make([]byte, 32)
+	flag := C.int(0)
+	if create {
+		flag = 1
+	}
+	status := C.keychain_key(account, (*C.uchar)(unsafe.Pointer(&key[0])), flag)
+	if status != 0 {
+		return nil, fmt.Errorf("Keychain OSStatus %d", int(status))
+	}
+	return key, nil
+}
+func Protect(data, entropy []byte) ([]byte, error) {
+	key, e := wrappingKey(entropy, true)
+	if e != nil {
+		return nil, e
+	}
+	block, e := aes.NewCipher(key)
+	if e != nil {
+		return nil, e
+	}
+	g, e := cipher.NewGCM(block)
+	if e != nil {
+		return nil, e
+	}
+	nonce := make([]byte, g.NonceSize())
+	if _, e = rand.Read(nonce); e != nil {
+		return nil, e
+	}
+	return g.Seal(nonce, nonce, data, entropy), nil
+}
+func Unprotect(data, entropy []byte) ([]byte, error) {
+	key, e := wrappingKey(entropy, false)
+	if e != nil {
+		return nil, e
+	}
+	block, e := aes.NewCipher(key)
+	if e != nil {
+		return nil, e
+	}
+	g, e := cipher.NewGCM(block)
+	if e != nil {
+		return nil, e
+	}
+	if len(data) < g.NonceSize() {
+		return nil, errors.New("invalid encrypted data")
+	}
+	return g.Open(nil, data[:g.NonceSize()], data[g.NonceSize():], entropy)
+}

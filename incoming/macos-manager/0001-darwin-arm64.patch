+		{name: "launched install", install: true, pending: true},
+		{name: "owed install", owed: true, install: true, pending: true},
+		{name: "game starts during upload", owed: true, gameAfterUpload: true, fixes: 1, pushes: 1, pending: true},
+		{name: "wrong mounted hash", fixes: 2, pushes: 1, mounted: "MOUNTED " + vkfix.FixSHA256},
+		{name: "missing mounted hash", fixes: 2, pushes: 1, mounted: "MOUNTED"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r, err := root.New(t.TempDir())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := os.MkdirAll(r.AvdHome(), 0o755); err != nil {
+				t.Fatal(err)
+			}
+			var logs []string
+			m := New(r, logx.New(func(_ logx.Level, msg string) { logs = append(logs, msg) }))
+			if tc.install {
+				lock, ok, err := host.TryLock(m.guestLockPath(3))
+				if err != nil || !ok {
+					t.Fatal(err)
+				}
+				defer lock.Unlock()
+			}
+			fixes, pushes := 0, 0
+			remote := "/data/local/tmp/vulkanfix.sh"
+			command := "su 0 sh " + remote + " " + vkfix.ARM64OrigSHA256 + " " + vkfix.ARM64FixSHA256 + " " + vkfix.ARM64CacheName
+			library := filepath.Join(r.GuestPatchDir(), vkfix.ARM64CacheName)
+			fx := vulkanFixIO{remote: remote, library: func() string { return library }, waitBack: func(before string) bool {
+				if before != "1234" {
+					t.Fatal(before)
+				}
+				return true
+			}}
+			fx.shell = func(cmd string, _ time.Duration) adb.Result {
+				switch cmd {

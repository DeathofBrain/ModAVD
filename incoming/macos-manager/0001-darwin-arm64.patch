new file mode 100644
index 0000000..73ad789
--- /dev/null
+++ b/internal/emu/vkprobe_darwin.go
@@ -0,0 +1,79 @@
+//go:build darwin
+
+package emu
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"os/exec"
+	"strings"
+	"time"
+)
+
+const VulkanProbeArg = "__vkprobe"
+
+type vkProbe struct {
+	Supported  bool
+	Name       string
+	ProbeError string
+}
+
+func (m *Manager) probeVulkan(ctx context.Context, useCache bool) vkProbe { return probeDarwinGPU(ctx) }
+func probeDarwinGPU(ctx context.Context) vkProbe {
+	ctx, cancel := context.WithTimeout(ctx, 20*time.Second)
+	defer cancel()
+	data, err := exec.CommandContext(ctx, "/usr/sbin/system_profiler", "SPDisplaysDataType", "-json").Output()
+	if err != nil {
+		return vkProbe{ProbeError: err.Error()}
+	}
+	return parseDarwinGPU(data)
+}
+
+func parseDarwinGPU(data []byte) vkProbe {
+	var output struct {
+		Displays []map[string]any `json:"SPDisplaysDataType"`
+	}
+	if err := json.Unmarshal(data, &output); err != nil {
+		return vkProbe{ProbeError: err.Error()}
+	}
+	var result vkProbe
+	for _, d := range output.Displays {
+		for _, key := range []string{"spdisplays_metal", "spdisplays_mtlgpufamilysupport"} {
+			if metalSupported(d[key]) {
+				result.Supported = true
+			}
+		}
+		if n, ok := d["sppci_model"].(string); ok {
+			result.Name = n
+		}
+	}
+	return result
+}
+func metalSupported(v any) bool {
+	s, ok := v.(string)
+	if !ok {
+		return false
+	}
+	// system_profiler uses symbolic values on current macOS. Accept known
+	// positive values only: "unsupported" also contains the word "supported".
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "supported", "spdisplays_supported", "spdisplays_metal1", "spdisplays_metal2", "spdisplays_metal3", "spdisplays_metal4":
+		return true
+	}
+	return false
+}
+func RunVulkanProbe(w io.Writer) int {
+	returnCode := 0
+	if json.NewEncoder(w).Encode(probeDarwinGPU(context.Background())) != nil {
+		returnCode = 1
+	}
+	return returnCode
+}
+func vulkanItemFromProbe(p vkProbe) CheckItem {
+	// Preserve the existing check identifier; Darwin uses the emulator's bundled graphics stack over Metal.
+	if p.ProbeError != "" {
+		return CheckItem{ID: "vulkan", Title: "图形加速", OK: nil, Reason: "GPU 检查失败: " + p.ProbeError}
+	}
+	return CheckItem{ID: "vulkan", Title: "图形加速", OK: checkOK(p.Supported), Reason: p.Name + "（Metal；Vulkan 能力须由模拟器运行验证）"}
+}

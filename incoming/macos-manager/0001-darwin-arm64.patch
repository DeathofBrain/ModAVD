index 0000000..621d506
--- /dev/null
+++ b/internal/guest/vulkanfix_script_unix_test.go
@@ -0,0 +1,116 @@
+//go:build darwin || linux
+
+package guest
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// Every guest command is replaced by a fixture executable. The actual embedded
+// shell script runs, but only the test's temporary state directory is writable.
+func TestVulkanFixRestartFailureRollback(t *testing.T) {
+	const original = "1111111111111111111111111111111111111111111111111111111111111111"
+	const fixed = "2222222222222222222222222222222222222222222222222222222222222222"
+	const foreign = "3333333333333333333333333333333333333333333333333333333333333333"
+	const mock = `#!/bin/sh
+tool=${0##*/}
+read -r mode < "$VKFIX_FIXTURE/mode"
+printf '%s %s\n' "$tool" "$*" >> "$VKFIX_FIXTURE/calls"
+case "$tool" in
+grep) [ -f "$VKFIX_FIXTURE/mounted" ]; exit $? ;;
+awk) [ ! -f "$VKFIX_FIXTURE/mounted" ] || /usr/bin/awk "$1" "$2" "$3" "$VKFIX_FIXTURE/mounted"; exit 0 ;;
+sha256sum)
+  hash=$VKFIX_FIXED
+  if [ "$1" = /vendor/lib64/libvulkan_enc.so ]; then
+    if [ ! -f "$VKFIX_FIXTURE/mounted" ]; then hash=$VKFIX_ORIGINAL
+    else read -r line < "$VKFIX_FIXTURE/mounted"; case "$line" in foreign*) hash=$VKFIX_FOREIGN ;; esac
+    fi
+  fi
+  printf '%s  %s\n' "$hash" "$1" ;;
+ls) printf 'u:object_r:vendor_file:s0 %s\n' "$2" ;;
+stat)
+  inode=10:20
+  if [ "$3" = /vendor/lib64/libvulkan_enc.so ] && [ -f "$VKFIX_FIXTURE/mounted" ]; then
+    read -r line < "$VKFIX_FIXTURE/mounted"; case "$line" in foreign*) inode=30:40 ;; esac
+  fi
+  printf '%s\n' "$inode" ;;
+mount)
+  [ "$mode" != mount_failure ] || exit 1
+  printf 'own 1 2 /source /vendor/lib64/libvulkan_enc.so rw - ext4 /dev/data rw\n' > "$VKFIX_FIXTURE/mounted"
+  if [ "$mode" = mount_stacked ]; then
+    printf 'foreign 1 2 /other /vendor/lib64/libvulkan_enc.so rw - ext4 /dev/data rw\n' >> "$VKFIX_FIXTURE/mounted"
+  fi ;;
+umount)
+  [ "$mode" != rollback_failure ] || exit 1
+  /bin/rm "$VKFIX_FIXTURE/mounted" ;;
+setprop)
+  case "$mode" in
+    success) exit 0 ;;
+    mount_replaced) printf 'foreign 1 2 /other /vendor/lib64/libvulkan_enc.so rw - ext4 /dev/data rw\n' > "$VKFIX_FIXTURE/mounted" ;;
+  esac
+  exit 1 ;;
+chmod|chcon|cp|rm) exit 0 ;;
+*) exit 90 ;;
+esac
+`
+	for _, tc := range []struct {
+		mode, want         string
+		success, unmounted bool
+	}{
+		{mode: "success", want: "MOUNTED " + fixed, success: true},
+		{mode: "restart_failure", want: "FAILED restart rollback-ok", unmounted: true},
+		{mode: "rollback_failure", want: "FAILED restart rollback-failed-umount"},
+		{mode: "mount_replaced", want: "FAILED restart rollback-skipped-mount-changed"},
+		{mode: "mount_stacked", want: "FAILED restart rollback-skipped-mount-changed"},
+		{mode: "mount_failure", want: "FAILED mount-call", unmounted: true},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			dir := t.TempDir()
+			bin := filepath.Join(dir, "bin")
+			if err := os.Mkdir(bin, 0o755); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(dir, "mode"), []byte(tc.mode+"\n"), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			program := filepath.Join(bin, "fixture")
+			if err := os.WriteFile(program, []byte(mock), 0o700); err != nil {
+				t.Fatal(err)
+			}
+			for _, name := range []string{"grep", "awk", "sha256sum", "ls", "stat", "mount", "umount", "setprop", "chmod", "chcon", "cp", "rm"} {
+				if err := os.Symlink(program, filepath.Join(bin, name)); err != nil {
+					t.Fatal(err)
+				}
+			}
+			script, err := Script(VulkanFix)
+			if err != nil {
+				t.Fatal(err)
+			}
+			path := filepath.Join(dir, "vulkanfix.sh")
+			if err := os.WriteFile(path, script, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			cmd := exec.Command("/bin/sh", path, original, fixed, "libvulkan_enc.arm64-khrfix-bindlock2.so")
+			cmd.Env = append(os.Environ(), "PATH="+bin+":/usr/bin:/bin", "VKFIX_FIXTURE="+dir, "VKFIX_ORIGINAL="+original, "VKFIX_FIXED="+fixed, "VKFIX_FOREIGN="+foreign)
+			output, err := cmd.CombinedOutput()
+			if (err == nil) != tc.success || strings.TrimSpace(string(output)) != tc.want {
+				t.Fatalf("output=%q error=%v", output, err)
+			}
+			_, statErr := os.Stat(filepath.Join(dir, "mounted"))
+			if os.IsNotExist(statErr) != tc.unmounted {
+				t.Fatalf("mount state: %v", statErr)
+			}
+			calls, err := os.ReadFile(filepath.Join(dir, "calls"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if (tc.mode == "mount_replaced" || tc.mode == "mount_stacked") && strings.Contains(string(calls), "umount ") {
+				t.Fatal("attempted to unmount a replacement owned by another writer")
+			}
+		})
+	}
+}

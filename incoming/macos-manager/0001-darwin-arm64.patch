diff --git a/internal/emu/check_darwin_test.go b/internal/emu/check_darwin_test.go
new file mode 100644
index 0000000..96a74c1
--- /dev/null
+++ b/internal/emu/check_darwin_test.go
@@ -0,0 +1,44 @@
+//go:build darwin
+
+package emu
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestDarwinAccelCheck(t *testing.T) {
+	// Actual signed mas-36 / 37.2.10 output on the Apple M4 QA host.
+	actual := "accel:\n0\nHypervisor.Framework OS X Version 26.6\naccel\n"
+	for _, tc := range []struct {
+		name string
+		code int
+		out  string
+		want bool
+	}{
+		{"actual_hvf", 0, actual, true},
+		{"crlf", 0, strings.ReplaceAll(actual, "\n", "\r\n"), true},
+		{"nonzero_exit", 1, actual, false},
+		{"empty_output", 0, "", false},
+		{"failure", 0, "Hypervisor.Framework is only supported on OS X 10.10 and above", false},
+		{"denied", 0, "Hypervisor.Framework unavailable: permission denied", false},
+		{"windows_text", 0, "WHPX(10.0.26200) is installed and usable.", false},
+		{"incomplete_version", 0, "Hypervisor.Framework OS X Version", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			res := parseAccelCheck(tc.code, tc.out)
+			if res.OK != tc.want || res.Detail != strings.TrimSpace(tc.out) {
+				t.Fatalf("parseAccelCheck = %+v; want OK=%v", res, tc.want)
+			}
+		})
+	}
+	res := parseAccelCheck(0, actual)
+	item := accelItem(res, accelSummary(res.Detail))
+	if item.OK == nil || !*item.OK || !item.Blocking || item.Reason != "可用（HVF；macOS 26.6）" {
+		t.Fatalf("actual HVF check rejected: %+v", item)
+	}
+	failed := accelItem(accelResult{}, "permission denied")
+	if failed.OK == nil || *failed.OK || !failed.Blocking || !strings.Contains(failed.Reason, "Hypervisor.framework") || strings.Contains(failed.Reason, "Windows") || failed.Advice != accelAdvice {
+		t.Fatalf("Darwin failure item = %+v", failed)
+	}
+}

+	writeFixture(t, blocker, []byte("untracked blocker"), 0644)
+	extra := map[string]string{"tools/blocked/asset.txt": "new resource"}
+	f := newSources(t, 37, zipOf(t, 37, pkgFiles(37, extra), false))
+	u := f.updater(r)
+	st, err := u.Install(context.Background())
+	if errs.CodeOf(err) != errs.Internal || st.Phase != phaseSwapping {
+		t.Fatalf("expected recoverable file failure: %+v %v", st, err)
+	}
+	if got := read(t, r, "tools/blocked"); got != "untracked blocker" {
+		t.Fatalf("untracked blocker was changed: %q", got)
+	}
+	assertProtected(t, r)
+	if err := os.Rename(blocker, blocker+".saved"); err != nil {
+		t.Fatal(err)
+	}
+	requests := f.requests.Load()
+	st, err = u.Recover(context.Background())
+	if err != nil || st.Phase != phaseIdle || st.CurrentVersion != "v0.37.0" || st.Recovered == "" {
+		t.Fatalf("recover after conflict removed: %+v %v", st, err)
+	}
+	if f.requests.Load() != requests {
+		t.Fatal("recover contacted an update source")
+	}
+	assertPackage(t, r, 37, extra)
+}

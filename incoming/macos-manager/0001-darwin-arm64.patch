index 0000000..f92d2b3
--- /dev/null
+++ b/internal/emu/logfiles_darwin_test.go
@@ -0,0 +1,172 @@
+//go:build darwin
+
+package emu
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"modavd/internal/host"
+	"modavd/internal/logx"
+)
+
+func auditLog(t *testing.T, dir, name string, age time.Duration) string {
+	t.Helper()
+	p := filepath.Join(dir, name)
+	if err := os.WriteFile(p, []byte("12345678"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	at := time.Now().Add(-age)
+	if err := os.Chtimes(p, at, at); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func TestDarwinPruneProtectsOpenLogsCount(t *testing.T) {
+	dir := t.TempDir()
+	active := auditLog(t, dir, "mas_0-active.log", time.Hour)
+	f, err := os.OpenFile(active, os.O_WRONLY|os.O_APPEND, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	old := auditLog(t, dir, "mas_0-old.log", time.Minute)
+	newest := auditLog(t, dir, "mas_0-new.log", 0)
+	n, freed, err := pruneLogDir(dir, 0, 1, 1024, logx.Nop())
+	if err != nil || n != 1 || freed != 8 {
+		t.Fatalf("prune = %d %d %v", n, freed, err)
+	}
+	for _, p := range []string{active, newest} {
+		if _, err := os.Stat(p); err != nil {
+			t.Fatal(p, err)
+		}
+	}
+	if _, err := os.Stat(old); !os.IsNotExist(err) {
+		t.Fatalf("closed old log remains: %v", err)
+	}
+	if _, err := f.WriteString("still visible"); err != nil {
+		t.Fatal(err)
+	}
+	if b, err := os.ReadFile(active); err != nil || string(b) != "12345678still visible" {
+		t.Fatalf("active log lost: %q %v", b, err)
+	}
+}
+
+func TestDarwinPruneProtectsOtherProcessLogAndRoot(t *testing.T) {
+	dir := t.TempDir()
+	active := auditLog(t, dir, "logcat-mas_1-active.txt", time.Hour)
+	f, err := os.OpenFile(active, os.O_WRONLY|os.O_APPEND, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("/bin/sleep", "30")
+	cmd.Stdout, cmd.Stderr = f, f
+	if err := cmd.Start(); err != nil {
+		f.Close()
+		t.Fatal(err)
+	}
+	f.Close() // Only the unrelated Manager-like child retains the output descriptor.
+	t.Cleanup(func() { cmd.Process.Kill(); cmd.Wait() })
+	closed := auditLog(t, dir, "mas_0-old.log", time.Minute)
+	n, freed, err := pruneLogDir(dir, 0, 10, 0, logx.Nop())
+	if err != nil || n != 1 || freed != 8 {
+		t.Fatalf("prune = %d %d %v", n, freed, err)
+	}
+	if _, err := os.Stat(active); err != nil {
+		t.Fatal("other instance active log removed", err)
+	}
+	if _, err := os.Stat(closed); !os.IsNotExist(err) {
+		t.Fatal("closed file remains", err)
+	}
+	// Once the exact writer exits, the formerly active file becomes eligible without stale PID records.
+	cmd.Process.Kill()
+	cmd.Wait()
+	n, freed, err = pruneLogDir(dir, 0, 10, 0, logx.Nop())
+	if err != nil || n != 1 || freed != 8 {
+		t.Fatalf("after exit = %d %d %v", n, freed, err)
+	}
+}
+
+func TestDarwinPruneProtectsIndependentManualWriter(t *testing.T) {
+	dir := t.TempDir()
+	active := auditLog(t, dir, "mas_4-manual.log", time.Hour)
+	// The shell exits after starting an ordinary, orphaned sleep. The writer is
+	// neither a Manager-named executable nor a child of this Manager process.
+	cmd := exec.Command("/bin/sh", "-c", "sleep 30 >> \"$1\" 2>&1 < /dev/null & echo $!", "writer", active)
+	b, err := cmd.Output()
+	if err != nil {
+		t.Fatal(err)
+	}
+	pid, err := strconv.Atoi(strings.TrimSpace(string(b)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, ok := host.FindProcess(uint32(pid))
+	if !ok || p.PPID == uint32(os.Getpid()) || strings.Contains(strings.ToLower(p.Name), "modavd") {
+		t.Fatalf("not an independent writer: %+v", p)
+	}
+	proc, err := os.FindProcess(pid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { proc.Kill() })
+	auditLog(t, dir, "mas_0-closed.log", time.Minute)
+	n, _, err := pruneLogDir(dir, 0, 1, 0, logx.Nop())
+	if err != nil || n != 1 {
+		t.Fatalf("prune = %d %v", n, err)
+	}
+	if _, err := os.Stat(active); err != nil {
+		t.Fatal("manual writer log removed", err)
+	}
+}
+
+func TestDarwinLogDirectoryLockHelper(t *testing.T) {
+	dir := os.Getenv("MODAVD_TEST_LOG_LOCK_DIR")
+	if dir == "" {
+		return
+	}
+	unlock, err := lockLogDirectory(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unlock()
+	if err := os.WriteFile(filepath.Join(dir, "child-acquired"), []byte("ok"), 0600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestDarwinLogDirectorySerializesProcesses(t *testing.T) {
+	dir := t.TempDir()
+	unlock, err := lockLogDirectory(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unlock()
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command(exe, "-test.run=^TestDarwinLogDirectoryLockHelper$")
+	cmd.Env = append(os.Environ(), "MODAVD_TEST_LOG_LOCK_DIR="+dir)
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { cmd.Process.Kill(); cmd.Wait() })
+	time.Sleep(100 * time.Millisecond)
+	if _, err := os.Stat(filepath.Join(dir, "child-acquired")); !os.IsNotExist(err) {
+		t.Fatal("concurrent writer bypassed lock")
+	}
+	unlock()
+	if err := cmd.Wait(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "child-acquired")); err != nil {
+		t.Fatal(err)
+	}
+}

diff --git a/internal/host/openfiles_darwin.go b/internal/host/openfiles_darwin.go
new file mode 100644
index 0000000..18d24cb
--- /dev/null
+++ b/internal/host/openfiles_darwin.go
@@ -0,0 +1,74 @@
+//go:build darwin && cgo
+
+package host
+
+/*
+#include <libproc.h>
+#include <sys/proc_info.h>
+#include <unistd.h>
+#include <string.h>
+static int log_process_owner(int pid) {
+    struct proc_bsdinfo b;
+    if (proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, &b, sizeof(b)) != sizeof(b)) return -1;
+    return b.pbi_uid == getuid();
+}
+static int log_fd_path(int pid, int fd, char *path, int size) {
+    struct vnode_fdinfowithpath v;
+    if (proc_pidfdinfo(pid, fd, PROC_PIDFDVNODEPATHINFO, &v, sizeof(v)) != sizeof(v)) return -1;
+    if (strlcpy(path, v.pvip.vip_path, size) >= size) return -1;
+    return 0;
+}
+*/
+import "C"
+
+import (
+	"fmt"
+	"os"
+	"unsafe"
+)
+
+// OpenFiles returns vnode paths held by this process identity, including inherited stdout/stderr.
+// Other users are outside this user's Manager ownership. A changed PID identity or unreadable
+// live descriptor fails closed so a caller cannot interpret a partial snapshot as safe to unlink.
+func (p Process) OpenFiles() ([]string, error) {
+	if p.Created == 0 || !p.current() {
+		return nil, os.ErrProcessDone
+	}
+	owner := C.log_process_owner(C.int(p.PID))
+	if owner == 0 {
+		return nil, nil
+	}
+	if owner < 0 {
+		if !p.current() {
+			return nil, os.ErrProcessDone
+		}
+		return nil, fmt.Errorf("cannot inspect owner of pid %d", p.PID)
+	}
+	n := C.proc_pidinfo(C.int(p.PID), C.PROC_PIDLISTFDS, 0, nil, 0)
+	if n <= 0 {
+		return nil, fmt.Errorf("cannot list file descriptors of pid %d", p.PID)
+	}
+	fds := make([]C.struct_proc_fdinfo, int(n)/int(C.sizeof_struct_proc_fdinfo)+64)
+	size := len(fds) * int(C.sizeof_struct_proc_fdinfo)
+	n = C.proc_pidinfo(C.int(p.PID), C.PROC_PIDLISTFDS, 0, unsafe.Pointer(&fds[0]), C.int(size))
+	if n <= 0 || int(n) >= size {
+		return nil, fmt.Errorf("incomplete file descriptor snapshot of pid %d", p.PID)
+	}
+	var paths []string
+	for _, fd := range fds[:int(n)/int(C.sizeof_struct_proc_fdinfo)] {
+		if fd.proc_fdtype != C.PROX_FDTYPE_VNODE {
+			continue
+		}
+		buf := make([]byte, 4096)
+		if C.log_fd_path(C.int(p.PID), C.int(fd.proc_fd), (*C.char)(unsafe.Pointer(&buf[0])), C.int(len(buf))) != 0 {
+			// A descriptor can close during enumeration. Retry a complete snapshot on the next
+			// pruning attempt rather than risk missing a writer that reused this descriptor.
+			return nil, fmt.Errorf("cannot inspect pid %d descriptor %d", p.PID, fd.proc_fd)
+		}
+		paths = append(paths, C.GoString((*C.char)(unsafe.Pointer(&buf[0]))))
+	}
+	if !p.current() {
+		return nil, os.ErrProcessDone
+	}
+	return paths, nil
+}

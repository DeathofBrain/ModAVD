+++ b/internal/vkfix/arm64_test.go
@@ -0,0 +1,60 @@
+package vkfix
+
+import (
+	"bytes"
+	"os"
+	"testing"
+
+	"modavd/internal/errs"
+)
+
+func TestARM64PatchRejectsUnsupportedInput(t *testing.T) {
+	for _, data := range [][]byte{nil, []byte("not an ELF"), make([]byte, 4409384)} {
+		if out, err := PatchARM64(data); out != nil || errs.CodeOf(err) != errs.Unsupported {
+			t.Fatalf("unexpected input accepted: output=%d error=%v", len(out), err)
+		}
+	}
+}
+
+func TestARM64PatchRealLibrary(t *testing.T) {
+	originalPath := os.Getenv("MODAVD_TEST_ARM64_VK_ORIGINAL")
+	fixedPath := os.Getenv("MODAVD_TEST_ARM64_VK_FIXED")
+	if originalPath == "" || fixedPath == "" {
+		t.Skip("set MODAVD_TEST_ARM64_VK_ORIGINAL and MODAVD_TEST_ARM64_VK_FIXED for exact library regression")
+	}
+	original, err := os.ReadFile(originalPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want, err := os.ReadFile(fixedPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := bytes.Clone(original)
+	profile := ARM64Profile()
+	got, err := profile.Patch(original)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, want) || SHA256Hex(got) != profile.FixSHA256 || !bytes.Equal(original, before) {
+		t.Fatal("ARM64 patch differs from independently validated candidate or changed input")
+	}
+	again, err := profile.Patch(original)
+	if err != nil || !bytes.Equal(got, again) {
+		t.Fatalf("non-deterministic patch: %v", err)
+	}
+	got[0] ^= 1
+	if !bytes.Equal(original, before) || bytes.Equal(got, again) {
+		t.Fatal("patch output shares input or another output's storage")
+	}
+	flipped := bytes.Clone(original)
+	flipped[len(flipped)/2] ^= 1
+	for _, bad := range [][]byte{flipped, original[:len(original)-1], append(bytes.Clone(original), 0), want} {
+		if out, err := profile.Patch(bad); out != nil || errs.CodeOf(err) != errs.Unsupported {
+			t.Fatalf("modified/truncated/patched input accepted: %v", err)
+		}
+	}
+	if out, err := X86Profile().Patch(original); out != nil || errs.CodeOf(err) != errs.Unsupported {
+		t.Fatal("x86 profile accepted ARM64 library")
+	}
+}

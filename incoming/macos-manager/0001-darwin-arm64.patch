new file mode 100644
index 0000000..c756dc7
--- /dev/null
+++ b/internal/emu/check_memory_test.go
@@ -0,0 +1,58 @@
+//go:build windows || darwin
+
+package emu
+
+import (
+	"encoding/json"
+	"errors"
+	"testing"
+)
+
+func TestMemoryCheckBudget(t *testing.T) {
+	for _, tc := range []struct {
+		memory    int
+		available uint64
+		want      bool
+	}{
+		{6144, 5120, false},
+		{3072, 5120, true},
+		{4096, 5120, false},
+		{3072, 4608, true},
+		{3072, 4607, false},
+		{3072, 0, false},
+	} {
+		item := memoryItem(tc.memory, tc.available, nil)
+		if item.OK == nil || *item.OK != tc.want || !item.Blocking || item.Memory == nil {
+			t.Fatalf("memoryItem(%d, %d) = %+v", tc.memory, tc.available, item)
+		}
+		budget := item.Memory
+		if budget.InstanceMB != tc.memory || budget.AvailableMB != tc.available || budget.OverheadMB != hostMemoryOverheadMB {
+			t.Fatalf("budget differs from actual threshold: %+v", budget)
+		}
+		encoded, err := json.Marshal(item)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var wire struct {
+			Memory MemoryCheck `json:"memory"`
+		}
+		if err = json.Unmarshal(encoded, &wire); err != nil || wire.Memory != *budget {
+			t.Fatalf("budget JSON mismatch: %s, %v", encoded, err)
+		}
+	}
+	item := memoryItem(3072, 0, errors.New("probe unavailable"))
+	if item.OK != nil || item.Memory != nil || !item.Blocking {
+		t.Fatalf("unknown memory fabricated a budget: %+v", item)
+	}
+	encoded, err := json.Marshal(item)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wire map[string]any
+	if err = json.Unmarshal(encoded, &wire); err != nil {
+		t.Fatal(err)
+	}
+	if _, exists := wire["memory"]; exists {
+		t.Fatalf("unknown budget emitted: %s", encoded)
+	}
+}

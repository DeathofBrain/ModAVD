diff --git a/internal/emu/darwin_test.go b/internal/emu/darwin_test.go
new file mode 100644
index 0000000..8991be8
--- /dev/null
+++ b/internal/emu/darwin_test.go
@@ -0,0 +1,84 @@
+//go:build darwin
+
+package emu
+
+import (
+	"context"
+	"modavd/internal/avd"
+	"modavd/internal/errs"
+	"modavd/internal/host"
+	"modavd/internal/root"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestDarwinLaunchContract(t *testing.T) {
+	for _, headless := range []bool{false, true} {
+		args := buildLaunchArgs("mas_3", 20030, 4096, headless)
+		for _, arg := range []string{"20030,20031", "20032", "-grpc-use-token", "-no-snapshot", "virtio-balloon-pci,free-page-reporting=on"} {
+			if !slices.Contains(args, arg) {
+				t.Errorf("missing %s: %q", arg, args)
+			}
+		}
+		if slices.Contains(args, "-no-window") != headless {
+			t.Fatalf("window mode: %q", args)
+		}
+	}
+	if shmName(3) != "videmulator20030" {
+		t.Fatal("Windows SHM prefix leaked")
+	}
+	if note := tuneHostScheduling(host.Process{}); !strings.Contains(note, "macOS 默认调度") {
+		t.Fatal(note)
+	}
+	r, err := root.New(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := avd.Create(r, 3, avd.CreateOptions{MemoryMB: 4096, CPU: 4, DataPartitionGB: 64, FPS: 60}); err != nil {
+		t.Fatal(err)
+	}
+	m := New(r, nil)
+	if _, err := m.Bridge(context.Background(), 3, "install"); errs.CodeOf(err) != errs.Unsupported {
+		t.Fatalf("ARM64 attempted native bridge install: %v", err)
+	}
+}
+
+func TestDarwinEmulatorEnvInChildProcess(t *testing.T) {
+	t.Setenv("ANDROID_EMU_VK_HIDE_REBAR", "1")
+	t.Setenv("android_emu_vk_hide_rebar", "case-sensitive-value")
+	t.Setenv("__GL_SHADER_DISK_CACHE_PATH", "inherited-nvidia-cache")
+	r, err := root.New(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	m := New(r, nil)
+	output := filepath.Join(t.TempDir(), "child-env.txt")
+	// Exercise the actual Darwin launch helper's duplicate handling. Only these fixture variables are printed.
+	_, err = host.StartDetached("/bin/sh", []string{"-c",
+		`printf '%s\n' "$ANDROID_EMU_VK_HIDE_REBAR" "$ANDROID_AVD_HOME" "$ANDROID_ADB_SERVER_PORT" "$android_emu_vk_hide_rebar" "$__GL_SHADER_DISK_CACHE_PATH"`,
+	}, host.StartOptions{Env: m.emulatorEnv(r.ShaderCacheDir()), OutputPath: output})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "0\n" + r.AvdHome() + "\n20050\ncase-sensitive-value\ninherited-nvidia-cache\n"
+	until := time.Now().Add(5 * time.Second)
+	for {
+		got, err := os.ReadFile(output)
+		if err == nil && string(got) == want {
+			break
+		}
+		if !time.Now().Before(until) {
+			t.Fatalf("child env = %q, %v; want %q", got, err, want)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	for _, env := range emulatorGPUEnv(r.ShaderCacheDir()) {
+		if strings.HasPrefix(env, "__GL_") {
+			t.Fatalf("NVIDIA cache override leaked into Darwin: %s", env)
+		}
+	}
+}

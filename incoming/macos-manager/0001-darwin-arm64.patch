@@ -0,0 +1,51 @@
+//go:build darwin
+
+package emu
+
+import "testing"
+
+func TestDarwinGPUActualProfilerOutput(t *testing.T) {
+	// Actual Apple M4 fields from system_profiler SPDisplaysDataType -json
+	// on the macOS 26.6 QA host; display identity fields omitted.
+	actual := []byte(`{"SPDisplaysDataType":[{"_name":"Apple M4","spdisplays_mtlgpufamilysupport":"spdisplays_metal4","sppci_model":"Apple M4"}]}`)
+	got := parseDarwinGPU(actual)
+	if !got.Supported || got.Name != "Apple M4" || got.ProbeError != "" {
+		t.Fatalf("actual profiler output rejected: %+v", got)
+	}
+	item := vulkanItemFromProbe(got)
+	if item.OK == nil || !*item.OK || item.Blocking {
+		t.Fatalf("Metal host check = %+v", item)
+	}
+	if got := parseDarwinGPU([]byte(`not JSON`)); got.Supported || got.ProbeError == "" {
+		t.Fatalf("bad profiler data accepted: %+v", got)
+	}
+}
+
+func TestDarwinMetalSupportValues(t *testing.T) {
+	for _, tc := range []struct {
+		value any
+		want  bool
+	}{
+		{"spdisplays_metal3", true},
+		{"spdisplays_metal4", true},
+		{"spdisplays_supported", true},
+		{"Supported", true},
+		{"spdisplays_unsupported", false},
+		{"Unsupported", false},
+		{"Not supported", false},
+		{"spdisplays_metal_disabled", false},
+		{"spdisplays_metal999", false},
+		{"", false},
+		{nil, false},
+		{true, false},
+	} {
+		if got := metalSupported(tc.value); got != tc.want {
+			t.Errorf("metalSupported(%v) = %v; want %v", tc.value, got, tc.want)
+		}
+	}
+	// A positive-looking value on an unrelated key is no evidence of Metal.
+	got := parseDarwinGPU([]byte(`{"SPDisplaysDataType":[{"sppci_model":"fixture","unrelated_metal_status":"supported","spdisplays_metal":"spdisplays_unsupported"}]}`))
+	if got.Supported {
+		t.Fatalf("unsupported GPU accepted: %+v", got)
+	}
+}

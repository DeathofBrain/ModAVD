index 0000000..9456a9f
--- /dev/null
+++ b/internal/update/native_package_darwin.go
@@ -0,0 +1,506 @@
+//go:build darwin
+
+package update
+
+import (
+	"archive/zip"
+	"crypto/sha256"
+	"debug/macho"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"modavd/internal/root"
+)
+
+const nativeFormat = "modavd-macos-update-v1"
+const nativeManifestName = "modavd-update-manifest.json"
+
+type nativeFile struct {
+	Type   string            `json:"type"`
+	Mode   uint32            `json:"mode,omitempty"`
+	Size   int64             `json:"size,omitempty"`
+	SHA256 string            `json:"sha256"`
+	Target string            `json:"target,omitempty"`
+	Xattrs map[string]string `json:"xattrs,omitempty"`
+}
+type nativeManifest struct {
+	Schema   int                   `json:"schema"`
+	Format   string                `json:"format"`
+	Version  string                `json:"version"`
+	Build    int                   `json:"build"`
+	Platform string                `json:"platform"`
+	Units    []string              `json:"units"`
+	Files    map[string]nativeFile `json:"files"`
+}
+
+var nativeAllowedUnits = map[string]bool{
+	"sdk/emulator": true, "ModAVD.app": true, "tools": true,
+	"components": true, "licenses": true, "provenance": true,
+	"modavd-manifest.json": true, "PACKAGE-MANIFEST.json": true,
+	"BUILD-RECEIPT.json": true, "README.md": true, "README.zh-CN.txt": true,
+	"CHANGELOG.md": true, "LICENSE": true, "NOTICE": true, "VERSION": true,
+	"SHA256SUMS": true, ".modavd-macos-package.json": true,
+}
+
+func nativeCleanPath(p string) bool {
+	if p == "" || p == "." || path.IsAbs(p) || path.Clean(p) != p || strings.ContainsAny(p, "\\\x00") || strings.HasPrefix(p, "../") {
+		return false
+	}
+	for _, c := range p {
+		if c < 32 {
+			return false
+		}
+	}
+	return true
+}
+func (m *nativeManifest) unit(p string) string {
+	for _, u := range m.Units {
+		if p == u || strings.HasPrefix(p, u+"/") {
+			return u
+		}
+	}
+	return ""
+}
+func digestBytes(b []byte) string { s := sha256.Sum256(b); return hex.EncodeToString(s[:]) }
+
+// validateNativeManifest validates the complete graph before any archive path is written.
+// Symlinks may contain '..', but every resolution step stays inside its move unit.
+func validateNativeManifest(m *nativeManifest) (Version, error) {
+	v, ok := ParseVersion(m.Version)
+	if !ok || m.Schema != 1 || m.Format != nativeFormat || m.Platform != "mac-arm64" || m.Build != v.Build || len(m.Files) == 0 || len(m.Files) > maxEntries {
+		return Version{}, packageError("macOS 更新清单格式、平台或版本不正确")
+	}
+	units := map[string]bool{}
+	for _, u := range m.Units {
+		if !nativeAllowedUnits[u] || units[u] {
+			return Version{}, packageError("更新包含不允许的单元: %s", u)
+		}
+		units[u] = true
+	}
+	for _, u := range []string{"sdk/emulator", "ModAVD.app", "tools", manifestName} {
+		if !units[u] {
+			return Version{}, packageError("更新缺少单元: %s", u)
+		}
+	}
+	graph := map[string]string{}
+	fold := map[string]string{}
+	add := func(p, kind string) error {
+		key := strings.ToLower(p)
+		if old, ok := fold[key]; ok && old != p {
+			return packageError("更新存在大小写路径冲突: %s / %s", old, p)
+		}
+		fold[key] = p
+		if old, ok := graph[p]; ok && old != kind {
+			return packageError("更新路径类型冲突: %s", p)
+		}
+		graph[p] = kind
+		return nil
+	}
+	var signatureBytes int
+	for p, s := range m.Files {
+		if err := validateNativeXattrs(s.Xattrs); err != nil {
+			return Version{}, err
+		}
+		for _, value := range s.Xattrs {
+			signatureBytes += len(value)
+		}
+		if signatureBytes > 12<<20 {
+			return Version{}, packageError("签名扩展属性总量太大")
+		}
+		if !nativeCleanPath(p) || m.unit(p) == "" || !sha256Hex.MatchString(s.SHA256) || s.Mode & ^uint32(0777) != 0 {
+			return Version{}, packageError("清单路径或属性不安全: %s", p)
+		}
+		if s.Type != "file" && s.Type != "symlink" {
+			return Version{}, packageError("不支持的文件类型: %s", p)
+		}
+		if s.Type == "file" && (s.Size < 0 || s.Target != "") {
+			return Version{}, packageError("文件记录不正确: %s", p)
+		}
+		if s.Type == "symlink" && (len(s.Xattrs) != 0 || s.Target == "" || path.IsAbs(s.Target) || strings.ContainsAny(s.Target, "\\\x00") || digestBytes([]byte(s.Target)) != s.SHA256) {
+			return Version{}, packageError("符号链接不安全: %s", p)
+		}
+		if err := add(p, s.Type); err != nil {
+			return Version{}, err
+		}
+		for d := path.Dir(p); d != "."; d = path.Dir(d) {
+			if err := add(d, "dir"); err != nil {
+				return Version{}, err
+			}
+		}
+	}
+	for _, u := range m.Units {
+		if _, ok := graph[u]; !ok {
+			return Version{}, packageError("更新单元为空: %s", u)
+		}
+	}
+	for p, spec := range m.Files {
+		if spec.Type != "symlink" {
+			continue
+		}
+		unit := m.unit(p)
+		stack := strings.Split(unit, "/")
+		floor := len(stack)
+		todo := strings.Split(strings.TrimPrefix(p, unit+"/"), "/")
+		expansions := 0
+		for len(todo) > 0 {
+			part := todo[0]
+			todo = todo[1:]
+			if part == "" || part == "." {
+				continue
+			}
+			if part == ".." {
+				if len(stack) <= floor {
+					return Version{}, packageError("链接越过更新单元: %s", p)
+				}
+				stack = stack[:len(stack)-1]
+				continue
+			}
+			prefix := strings.Join(append(append([]string{}, stack...), part), "/")
+			kind, ok := graph[prefix]
+			if !ok {
+				return Version{}, packageError("悬空符号链接: %s", p)
+			}
+			if kind == "symlink" {
+				expansions++
+				if expansions > 64 {
+					return Version{}, packageError("符号链接循环: %s", p)
+				}
+				todo = append(strings.Split(m.Files[prefix].Target, "/"), todo...)
+				continue
+			}
+			if len(todo) > 0 && kind != "dir" {
+				return Version{}, packageError("链接穿过普通文件: %s", p)
+			}
+			stack = append(stack, part)
+		}
+	}
+	return v, nil
+}
+
+func readNativeManifest(p string) (*nativeManifest, error) {
+	b, err := os.ReadFile(p)
+	if err != nil {
+		return nil, err
+	}
+	if len(b) > 16<<20 {
+		return nil, packageError("更新清单太大")
+	}
+	var m nativeManifest
+	dec := json.NewDecoder(strings.NewReader(string(b)))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&m); err != nil {
+		return nil, packageError("更新清单读不懂: %v", err)
+	}
+	if _, err := validateNativeManifest(&m); err != nil {
+		return nil, err
+	}
+	return &m, nil
+}
+
+func extractNativePackage(archive, dst, topDir string, check func() error) (*nativeManifest, error) {
+	zr, closer, err := openZip(archive)
+	if err != nil {
+		return nil, err
+	}
+	defer closer.Close()
+	if len(zr.File) > maxEntries {
+		return nil, packageError("更新包条目太多")
+	}
+	entries := map[string]*zip.File{}
+	fold := map[string]bool{}
+	var total uint64
+	for _, f := range zr.File {
+		name, err := zipName(f)
+		if err != nil {
+			return nil, err
+		}
+		if topDir != "" {
+			prefix := strings.TrimRight(topDir, "/") + "/"
+			if name == prefix {
+				continue
+			}
+			if !strings.HasPrefix(name, prefix) {
+				return nil, packageError("更新包目录不正确")
+			}
+			name = strings.TrimPrefix(name, prefix)
+		}
+		name = strings.TrimSuffix(name, "/")
+		if !nativeCleanPath(name) || fold[strings.ToLower(name)] {
+			return nil, packageError("更新包路径不安全或重复: %s", name)
+		}
+		fold[strings.ToLower(name)] = true
+		if f.Mode().IsDir() {
+			continue
+		}
+		if !f.Mode().IsRegular() && f.Mode()&os.ModeSymlink == 0 {
+			return nil, packageError("更新包含特殊文件: %s", name)
+		}
+		if f.UncompressedSize64 > maxUnpackedBytes || total > maxUnpackedBytes-f.UncompressedSize64 {
+			return nil, packageError("更新包解开后太大")
+		}
+		total += f.UncompressedSize64
+		entries[name] = f
+	}
+	mf := entries[nativeManifestName]
+	if mf == nil || !mf.Mode().IsRegular() || mf.UncompressedSize64 > 16<<20 {
+		return nil, packageError("缺少 macOS 更新清单")
+	}
+	rc, err := mf.Open()
+	if err != nil {
+		return nil, err
+	}
+	b, err := io.ReadAll(io.LimitReader(rc, 16<<20+1))
+	rc.Close()
+	if err != nil {
+		return nil, err
+	}
+	var m nativeManifest
+	dec := json.NewDecoder(strings.NewReader(string(b)))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&m); err != nil {
+		return nil, packageError("更新清单读不懂: %v", err)
+	}
+	if _, err := validateNativeManifest(&m); err != nil {
+		return nil, err
+	}
+	if len(entries) != len(m.Files)+1 {
+		return nil, packageError("更新包与清单条目不一致")
+	}
+	for p, s := range m.Files {
+		f := entries[p]
+		if f == nil {
+			return nil, packageError("更新包缺少 %s", p)
+		}
+		if (f.Mode()&os.ModeSymlink != 0) != (s.Type == "symlink") {
+			return nil, packageError("文件类型不符: %s", p)
+		}
+		if s.Type == "file" && (uint64(s.Size) != f.UncompressedSize64 || uint32(f.Mode().Perm()) != s.Mode) {
+			return nil, packageError("文件属性不符: %s", p)
+		}
+	}
+	if err := removeTree(dst); err != nil {
+		return nil, err
+	}
+	if err := os.MkdirAll(dst, 0755); err != nil {
+		return nil, err
+	}
+	keys := make([]string, 0, len(m.Files))
+	for p := range m.Files {
+		keys = append(keys, p)
+	}
+	sort.Strings(keys)
+	for _, p := range keys {
+		if m.Files[p].Type == "file" {
+			if err := extractEntryChecked(zipEntry{p, entries[p]}, filepath.Join(dst, filepath.FromSlash(p)), check); err != nil {
+				return nil, err
+			}
+			if err := os.Chmod(filepath.Join(dst, filepath.FromSlash(p)), os.FileMode(m.Files[p].Mode)); err != nil {
+				return nil, err
+			}
+			if err := restoreNativeXattrs(filepath.Join(dst, filepath.FromSlash(p)), m.Files[p].Xattrs); err != nil {
+				return nil, err
+			}
+		}
+	}
+	for _, p := range keys {
+		s := m.Files[p]
+		if s.Type != "symlink" {
+			continue
+		}
+		f := entries[p]
+		if f.UncompressedSize64 > 4096 {
+			return nil, packageError("链接目标太长: %s", p)
+		}
+		rc, err := f.Open()
+		if err != nil {
+			return nil, err
+		}
+		b, err := io.ReadAll(io.LimitReader(rc, 4097))
+		rc.Close()
+		if err != nil || string(b) != s.Target {
+			return nil, packageError("链接内容不符: %s", p)
+		}
+		dstPath := filepath.Join(dst, filepath.FromSlash(p))
+		if err := os.MkdirAll(filepath.Dir(dstPath), 0755); err != nil {
+			return nil, err
+		}
+		if err := os.Symlink(s.Target, dstPath); err != nil {
+			return nil, err
+		}
+	}
+	if err := os.WriteFile(filepath.Join(dst, nativeManifestName), b, 0644); err != nil {
+		return nil, err
+	}
+	return &m, nil
+}
+
+// verifyNativeTree uses Lstat/WalkDir: it never follows archive links while hashing.
+func verifyNativeTree(base string, m *nativeManifest) error {
+	return verifyNativeTreeAt(m, func(p string) string { return filepath.Join(base, filepath.FromSlash(p)) })
+}
+
+func verifyNativeTreeAt(m *nativeManifest, at func(string) string) error {
+	if _, err := validateNativeManifest(m); err != nil {
+		return err
+	}
+	seen := map[string]bool{}
+	for _, unit := range m.Units {
+		unitPath := at(unit)
+		err := filepath.WalkDir(unitPath, func(p string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			if d.IsDir() {
+				return nil
+			}
+			rel, err := filepath.Rel(unitPath, p)
+			if err != nil {
+				return err
+			}
+			if rel == "." {
+				rel = unit
+			} else {
+				rel = unit + "/" + filepath.ToSlash(rel)
+			}
+			s, ok := m.Files[rel]
+			if !ok {
+				return packageError("清单未列出的文件: %s", rel)
+			}
+			seen[rel] = true
+			info, err := d.Info()
+			if err != nil {
+				return err
+			}
+			if s.Type == "symlink" {
+				if info.Mode()&os.ModeSymlink == 0 {
+					return packageError("链接被替换: %s", rel)
+				}
+				target, err := os.Readlink(p)
+				if err != nil || target != s.Target {
+					return packageError("链接内容不符: %s", rel)
+				}
+				return nil
+			}
+			if !info.Mode().IsRegular() || info.Size() != s.Size || uint32(info.Mode().Perm()) != s.Mode {
+				return packageError("文件属性不符: %s", rel)
+			}
+			sum, err := hashFile(p)
+			if err != nil || sum != s.SHA256 {
+				return packageError("文件内容不符: %s", rel)
+			}
+			attrs, err := nativeXattrs(p)
+			if err != nil || len(attrs) != len(s.Xattrs) {
+				return packageError("签名扩展属性不符: %s", rel)
+			}
+			for key, value := range attrs {
+				if s.Xattrs[key] != value {
+					return packageError("签名扩展属性不符: %s", rel)
+				}
+			}
+			return nil
+		})
+		if err != nil {
+			return err
+		}
+	}
+	if len(seen) != len(m.Files) {
+		return packageError("更新文件缺失")
+	}
+	return nil
+}
+
+func arm64MachO(p string) (bool, error) {
+	f, err := os.Open(p)
+	if err != nil {
+		return false, err
+	}
+	var magic [4]byte
+	n, err := f.Read(magic[:])
+	f.Close()
+	if n < 4 {
+		return false, nil
+	}
+	m := binary.BigEndian.Uint32(magic[:])
+	if m != macho.Magic32 && m != macho.Magic64 && m != 0xcefaedfe && m != 0xcffaedfe && m != macho.MagicFat && m != 0xbebafeca {
+		return false, nil
+	}
+	if fat, err := macho.OpenFat(p); err == nil {
+		defer fat.Close()
+		for _, a := range fat.Arches {
+			if a.Cpu == macho.CpuArm64 {
+				return true, nil
+			}
+		}
+		return true, packageError("Mach-O 缺少 ARM64: %s", p)
+	}
+	thin, err := macho.Open(p)
+	if err != nil {
+		return true, packageError("Mach-O 损坏: %s", p)
+	}
+	defer thin.Close()
+	if thin.Cpu != macho.CpuArm64 {
+		return true, packageError("Mach-O 不是 ARM64: %s", p)
+	}
+	return true, nil
+}
+
+func verifyDarwinPackage(base string, m *nativeManifest, target Version) error {
+	return verifyDarwinPackageAt(m, target, func(p string) string { return filepath.Join(base, filepath.FromSlash(p)) })
+}
+
+func verifyDarwinPackageAt(m *nativeManifest, target Version, at func(string) string) error {
+	if err := verifyNativeTreeAt(m, at); err != nil {
+		return err
+	}
+	if err := checkEmulator(at("sdk/emulator"), target); err != nil {
+		return err
+	}
+	required := append(managerPaths(), "sdk/emulator/"+root.EmulatorBinary, "sdk/emulator/qemu/"+root.QemuHostDir+"/"+root.QemuBinary, "sdk/emulator/qemu/"+root.QemuHostDir+"/"+root.QemuHeadlessBinary)
+	machos := map[string]bool{}
+	for p, s := range m.Files {
+		if s.Type != "file" {
+			continue
+		}
+		full := at(p)
+		native, err := arm64MachO(full)
+		if err != nil {
+			return err
+		}
+		if native {
+			machos[p] = true
+			if out, err := exec.Command("/usr/bin/codesign", "--verify", "--strict", full).CombinedOutput(); err != nil {
+				return packageError("原生文件签名核对失败 %s: %s", p, strings.TrimSpace(string(out)))
+			}
+		}
+	}
+	for _, p := range required {
+		if !machos[p] {
+			return packageError("必需文件不是真实 ARM64 Mach-O: %s", p)
+		}
+	}
+	info := at("ModAVD.app/Contents/Info.plist")
+	out, err := exec.Command("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleExecutable", info).Output()
+	if err != nil || strings.TrimSpace(string(out)) != "ModAVD" {
+		return packageError("应用包 CFBundleExecutable 不正确")
+	}
+	for _, p := range []string{"ModAVD.app", "sdk/emulator"} {
+		out, err := exec.Command("/usr/bin/codesign", "--verify", "--deep", "--strict", at(p)).CombinedOutput()
+		if err != nil {
+			return packageError("签名完整性核对失败 %s: %s", p, strings.TrimSpace(string(out)))
+		}
+	}
+	installed, ok := manifestVersion(filepath.Dir(at(manifestName)))
+	if !ok || installed != target {
+		return packageError("载荷版本清单与更新版本不一致")
+	}
+	return nil
+}
diff --git a/internal/update/native_transaction_darwin.go b/internal/update/native_transaction_darwin.go
new file mode 100644
index 0000000..368d28f
--- /dev/null
+++ b/internal/update/native_transaction_darwin.go
@@ -0,0 +1,484 @@
+//go:build darwin
+
+package update
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"modavd/internal/errs"
+	"modavd/internal/jsonord"
+)
+
+type nativeUnit struct {
+	Path   string `json:"path"`
+	HadOld bool   `json:"had_old"`
+	Step   string `json:"step"` // pending, old_moved, new_moved
+}
+type nativeState struct {
+	Format string `json:"format"`
+	Phase  string `json:"phase"`
+	Target struct {
+		Version string `json:"version"`
+		Source  string `json:"source"`
+		Asset   string `json:"asset_name"`
+	} `json:"target"`
+	ManifestSHA256 string       `json:"manifest_sha256"`
+	From           string       `json:"from"`
+	Units          []nativeUnit `json:"units"`
+}
+
+func (u *Updater) nativeUpdates() bool { return !u.legacyTransactions }
+func (u *Updater) hasNativeTransaction() bool {
+	s, _ := u.l.readState().Get("format").Str()
+	return s == nativeFormat
+}
+func (l layout) nativeStagedVersion(st *jsonord.Obj) (Version, bool) {
+	f, _ := st.Get("format").Str()
+	if f != nativeFormat || phaseOf(st) != phaseStaged || !isDir(filepath.Join(l.stage(), "payload")) {
+		return Version{}, false
+	}
+	v, _ := st.Get("target").Obj().Get("version").Str()
+	return ParseVersion(v)
+}
+func (u *Updater) nativePayload() string { return filepath.Join(u.l.stage(), "payload") }
+func (u *Updater) nativeBackup(p string) string {
+	return filepath.Join(u.l.previous(), "native", filepath.FromSlash(p))
+}
+func (u *Updater) writeNativeState(st *nativeState) error {
+	b, err := json.Marshal(st)
+	if err != nil {
+		return err
+	}
+	v, err := jsonord.Parse(b)
+	if err != nil {
+		return err
+	}
+	return u.l.writeState(v.Obj())
+}
+func (u *Updater) readNativeState() (*nativeState, error) {
+	b, err := os.ReadFile(u.l.state())
+	if err != nil {
+		return nil, err
+	}
+	var st nativeState
+	if err := json.Unmarshal(b, &st); err != nil {
+		return nil, err
+	}
+	if st.Format != nativeFormat {
+		return nil, packageError("更新事务格式错误")
+	}
+	seen := map[string]bool{}
+	for _, unit := range st.Units {
+		if !nativeAllowedUnits[unit.Path] || seen[unit.Path] {
+			return nil, packageError("更新事务单元不安全: %s", unit.Path)
+		}
+		seen[unit.Path] = true
+	}
+	if _, ok := ParseVersion(st.Target.Version); !ok {
+		return nil, packageError("更新事务版本错误")
+	}
+	return &st, nil
+}
+
+func (u *Updater) nativeUpdate(ctx context.Context, install bool) (*Status, error) {
+	u.localOperation = u.Opt.PackagePath != ""
+	if u.hasNativeTransaction() {
+		if pending, err := u.readNativeState(); err == nil && pending.Target.Source == "local" {
+			u.localOperation = true
+		}
+	}
+	st := u.status()
+	if !st.Updatable {
+		return st, errs.New(errs.NotReady, st.NotUpdatableReason)
+	}
+	if (u.Opt.PackagePath == "") != (u.Opt.PackageSHA256 == "") {
+		return st, errs.New(errs.Usage, "本地更新必须同时指定 --package ZIP 和 --sha256 HEX")
+	}
+	lock, err := u.begin(st)
+	if err != nil {
+		return st, err
+	}
+	defer lock.Unlock()
+	if u.Opt.PackagePath != "" || phaseOf(u.l.readState()) != phaseStaged || !u.hasNativeTransaction() {
+		if err := u.prepareNative(ctx, st); err != nil {
+			return u.finish(st), err
+		}
+	}
+	if !install {
+		out := u.finish(st)
+		if out.PreparedVersion != "" {
+			out.Message = displayVersion(out.PreparedVersion) + " 已核对文件与签名，可以离线安装"
+		}
+		return out, nil
+	}
+	if !u.hasNativeTransaction() || phaseOf(u.l.readState()) != phaseStaged {
+		return u.finish(st), nil
+	}
+	ns, err := u.readNativeState()
+	if err != nil {
+		return u.finish(st), err
+	}
+	v, _ := ParseVersion(ns.Target.Version)
+	if cur, ok := LocalVersion(u.Root); ok && !cur.Less(v) {
+		return u.finish(st), packageError("更新包 %s 不比本地 %s 新", v.Display(), cur.Display())
+	}
+	m, err := u.checkedNativeStage(ns)
+	if err != nil {
+		return u.finish(st), err
+	}
+	if err := u.ensureNotInUse("安装"); err != nil {
+		return u.finish(st), err
+	}
+	if err := u.checkSpace(); err != nil {
+		return u.finish(st), err
+	}
+	if err := u.validateNativeDestinations(m); err != nil {
+		return u.finish(st), err
+	}
+	if err := removeTree(u.l.previous()); err != nil {
+		return u.finish(st), err
+	}
+	if cur, ok := LocalVersion(u.Root); ok {
+		ns.From = cur.String()
+	}
+	ns.Phase = phaseSwapping
+	ns.Units = nil
+	for _, p := range m.Units {
+		ns.Units = append(ns.Units, nativeUnit{Path: p, HadOld: lexists(u.l.at(p)), Step: "pending"})
+	}
+	if err := u.writeNativeState(ns); err != nil {
+		return u.finish(st), err
+	}
+	if err := u.completeNativeSwap(ns, m); err != nil {
+		msg, rerr := u.recoverNative()
+		if rerr != nil {
+			return u.finish(st), fmt.Errorf("%w; recovery: %v", err, rerr)
+		}
+		st.Recovered = msg
+		return u.finish(st), err
+	}
+	out := u.finish(st)
+	out.Updated = true
+	out.Message = "已更新到 " + v.Display()
+	return out, nil
+}
+
+func (u *Updater) prepareNative(ctx context.Context, st *Status) (err error) {
+	var archive, source, asset string
+	var expected Version
+	if u.Opt.PackagePath != "" {
+		archive, err = filepath.Abs(u.Opt.PackagePath)
+		if err != nil {
+			return err
+		}
+		want := strings.ToLower(u.Opt.PackageSHA256)
+		if !sha256Hex.MatchString(want) {
+			return errs.New(errs.Usage, "--sha256 必须是 64 位十六进制摘要")
+		}
+		fi, e := os.Lstat(archive)
+		if e != nil || !fi.Mode().IsRegular() {
+			return packageError("本地更新包必须是普通文件")
+		}
+		if err := u.checkSpace(); err != nil {
+			return err
+		}
+		if err := os.MkdirAll(u.l.download(), 0755); err != nil {
+			return err
+		}
+		tmp, e := os.CreateTemp(u.l.download(), "local-*.zip")
+		if e != nil {
+			return e
+		}
+		selected := tmp.Name()
+		if e := tmp.Close(); e != nil {
+			return e
+		}
+		defer os.Remove(selected)
+		if e := copyFileChecked(archive, selected, u.checkSpace); e != nil {
+			return e
+		}
+		sum, e := hashFile(selected)
+		if e != nil || sum != want {
+			return packageError("本地更新包 SHA256 不符")
+		}
+		source, asset = "local", filepath.Base(archive)
+		archive = selected // Extract only the exact bytes whose supplied digest was checked.
+	} else {
+		r, e := u.pick(ctx, st)
+		if e != nil {
+			return e
+		}
+		if r == nil {
+			return nil
+		}
+		if r.incremental {
+			return packageError("macOS 更新需要完整签名包；增量更新尚未提供")
+		}
+		archive, err = u.download(ctx, r)
+		if err != nil {
+			return err
+		}
+		source, asset, expected = r.source, r.assetName, r.version
+		if r.topDir != "" {
+			return packageError("macOS 原生更新包不允许额外顶层目录")
+		}
+	}
+	if err := u.checkSpace(); err != nil {
+		return err
+	}
+	ns := &nativeState{Format: nativeFormat, Phase: phasePreparing}
+	ns.Target.Version = expected.String()
+	ns.Target.Source = source
+	ns.Target.Asset = asset
+	if err := u.writeNativeState(ns); err != nil {
+		return err
+	}
+	defer func() {
+		if err != nil {
+			u.l.abortStaging(err.Error())
+		}
+	}()
+	u.step("extracting", "正在解开 macOS 签名更新包")
+	m, err := extractNativePackage(archive, u.nativePayload(), "", u.checkSpace)
+	if err != nil {
+		return err
+	}
+	v, _ := ParseVersion(m.Version)
+	if source != "local" && v != expected {
+		return packageError("更新包版本与发布版本不一致")
+	}
+	if cur, ok := LocalVersion(u.Root); ok && !cur.Less(v) {
+		return packageError("更新包 %s 不比本地 %s 新", v.Display(), cur.Display())
+	}
+	u.step("verifying", "正在核对 ARM64 文件、应用签名与清单")
+	if err := verifyDarwinPackage(u.nativePayload(), m, v); err != nil {
+		return err
+	}
+	ns.ManifestSHA256, err = hashFile(filepath.Join(u.nativePayload(), nativeManifestName))
+	if err != nil {
+		return err
+	}
+	ns.Target.Version = v.String()
+	ns.Phase = phaseStaged
+	return u.writeNativeState(ns)
+}
+
+func (u *Updater) checkedNativeStage(st *nativeState) (*nativeManifest, error) {
+	mp := filepath.Join(u.nativePayload(), nativeManifestName)
+	sum, err := hashFile(mp)
+	if err != nil || sum != st.ManifestSHA256 {
+		return nil, packageError("暂存清单被修改或丢失")
+	}
+	m, err := readNativeManifest(mp)
+	if err != nil {
+		return nil, err
+	}
+	v, _ := ParseVersion(st.Target.Version)
+	if m.Version != v.String() && "v"+m.Version != v.String() {
+		return nil, packageError("暂存版本不一致")
+	}
+	if err := verifyDarwinPackage(u.nativePayload(), m, v); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
+// No transaction unit may be reached through a symlink in the installed root.
+func (u *Updater) validateNativeDestinations(m *nativeManifest) error {
+	for _, unit := range m.Units {
+		p := u.l.at(unit)
+		for {
+			fi, err := os.Lstat(p)
+			if err == nil && fi.Mode()&os.ModeSymlink != 0 {
+				return packageError("更新目标是符号链接: %s", p)
+			}
+			if err != nil && !os.IsNotExist(err) {
+				return err
+			}
+			if p == u.Root.Dir {
+				break
+			}
+			p = filepath.Dir(p)
+			if p == filepath.Dir(p) {
+				return packageError("更新根目录不正确")
+			}
+		}
+	}
+	return nil
+}
+
+func (u *Updater) completeNativeSwap(st *nativeState, m *nativeManifest) error {
+	if err := u.validateNativeDestinations(m); err != nil {
+		return err
+	}
+	// A cut rename may leave verified units in either location. Verify that
+	// complete candidate, including signatures, before doing another rename.
+	at := func(p string) string {
+		unit := m.unit(p)
+		base := filepath.Join(u.nativePayload(), filepath.FromSlash(unit))
+		if !lexists(base) {
+			base = u.l.at(unit)
+		}
+		if p == unit {
+			return base
+		}
+		return filepath.Join(base, filepath.FromSlash(strings.TrimPrefix(p, unit+"/")))
+	}
+	v, _ := ParseVersion(st.Target.Version)
+	if err := verifyDarwinPackageAt(m, v, at); err != nil {
+		return err
+	}
+	for i := range st.Units {
+		unit := &st.Units[i]
+		src := filepath.Join(u.nativePayload(), filepath.FromSlash(unit.Path))
+		dst := u.l.at(unit.Path)
+		old := u.nativeBackup(unit.Path)
+		if unit.Step == "pending" {
+			if unit.HadOld && !lexists(old) {
+				if !lexists(dst) {
+					return fmt.Errorf("old update unit missing: %s", unit.Path)
+				}
+				if err := os.MkdirAll(filepath.Dir(old), 0755); err != nil {
+					return err
+				}
+				if err := os.Rename(dst, old); err != nil {
+					return err
+				}
+			}
+			unit.Step = "old_moved"
+			if err := u.writeNativeState(st); err != nil {
+				return err
+			}
+		}
+		if unit.Step == "old_moved" {
+			if lexists(src) {
+				if lexists(dst) {
+					return fmt.Errorf("ambiguous update unit: %s", unit.Path)
+				}
+				if err := os.MkdirAll(filepath.Dir(dst), 0755); err != nil {
+					return err
+				}
+				if err := os.Rename(src, dst); err != nil {
+					return err
+				}
+			} else if !lexists(dst) {
+				return fmt.Errorf("new update unit missing: %s", unit.Path)
+			}
+			unit.Step = "new_moved"
+			if err := u.writeNativeState(st); err != nil {
+				return err
+			}
+		}
+	}
+	if err := verifyDarwinPackage(u.Root.Dir, m, v); err != nil {
+		return err
+	}
+	u.recordHistory(st.From, st.Target.Version, st.Target.Source, st.Target.Asset)
+	result := jsonord.NewObject().Obj()
+	result.Set("ok", jsonord.NewBool(true))
+	result.Set("action", jsonord.NewString("update"))
+	result.Set("version", jsonord.NewString(st.Target.Version))
+	if err := u.l.writeState(newState(phaseIdle, "lastResult", objVal(result))); err != nil {
+		return err
+	}
+	u.l.tidyUp(u.l.previous(), u.l.stage(), u.l.pkg())
+	u.l.purgeTrash()
+	return nil
+}
+
+func (u *Updater) recoverNative() (string, error) {
+	st, err := u.readNativeState()
+	if err != nil {
+		return "", err
+	}
+	if st.Target.Source == "local" {
+		u.localOperation = true
+	}
+	switch st.Phase {
+	case phasePreparing:
+		if err := u.l.abortStaging("上次 macOS 更新准备未完成"); err != nil {
+			return "", err
+		}
+		return "已丢弃上次未完成的 macOS 更新暂存", nil
+	case phaseStaged:
+		return "", nil
+	case phaseSwapping:
+		if err := u.ensureNotInUse("恢复更新"); err != nil {
+			return "", err
+		}
+		mp := filepath.Join(u.nativePayload(), nativeManifestName)
+		sum, e := hashFile(mp)
+		if e == nil && sum == st.ManifestSHA256 {
+			if m, e := readNativeManifest(mp); e == nil {
+				if e := u.completeNativeSwap(st, m); e == nil {
+					return "已离线补完 macOS 更新（" + displayVersion(st.Target.Version) + "）", nil
+				}
+			}
+		}
+		st.Phase = "rolling_back"
+		if err := u.writeNativeState(st); err != nil {
+			return "", err
+		}
+		return u.rollbackNative(st)
+	case "rolling_back":
+		if err := u.ensureNotInUse("恢复更新"); err != nil {
+			return "", err
+		}
+		return u.rollbackNative(st)
+	default:
+		return "", packageError("未知 macOS 更新事务状态")
+	}
+}
+
+func (u *Updater) rollbackNative(st *nativeState) (string, error) {
+	// If the staged payload is unavailable/corrupt, restore every unit from
+	// this transaction's backup. This is crash recovery, not a retained rollback.
+	for i := len(st.Units) - 1; i >= 0; i-- {
+		unit := &st.Units[i]
+		if unit.Step == "restored" {
+			continue
+		}
+		old := u.nativeBackup(unit.Path)
+		dst := u.l.at(unit.Path)
+		if lexists(old) {
+			unit.Step = "restoring"
+			if err := u.writeNativeState(st); err != nil {
+				return "", err
+			}
+			if err := removeTree(dst); err != nil {
+				return "", err
+			}
+			if err := os.MkdirAll(filepath.Dir(dst), 0755); err != nil {
+				return "", err
+			}
+			if err := os.Rename(old, dst); err != nil {
+				return "", err
+			}
+		} else if !unit.HadOld && unit.Step != "pending" {
+			if err := removeTree(dst); err != nil {
+				return "", err
+			}
+		} else if unit.HadOld && unit.Step != "pending" && !(unit.Step == "restoring" && lexists(dst)) {
+			return "", fmt.Errorf("cannot restore missing backup: %s", unit.Path)
+		}
+		unit.Step = "restored"
+		if err := u.writeNativeState(st); err != nil {
+			return "", err
+		}
+	}
+	result := jsonord.NewObject().Obj()
+	result.Set("action", jsonord.NewString("update"))
+	result.Set("ok", jsonord.NewBool(false))
+	result.Set("error", jsonord.NewString("上次 macOS 更新损坏，已恢复原单元"))
+	if err := u.l.writeState(newState(phaseIdle, "lastResult", objVal(result))); err != nil {
+		return "", err
+	}
+	u.l.tidyUp(u.l.previous(), u.l.stage(), u.l.pkg())
+	u.l.purgeTrash()
+	return "上次 macOS 更新未完成，已恢复原单元", nil
+}
diff --git a/internal/update/native_windows.go b/internal/update/native_windows.go
new file mode 100644
index 0000000..c9e8db8
--- /dev/null
+++ b/internal/update/native_windows.go
@@ -0,0 +1,17 @@
+//go:build windows
+
+package update
+
+import (
+	"context"
+	"modavd/internal/errs"
+	"modavd/internal/jsonord"
+)
+
+func (u *Updater) nativeUpdates() bool            { return false }
+func (u *Updater) hasNativeTransaction() bool     { return false }
+func (u *Updater) recoverNative() (string, error) { return "", nil }
+func (u *Updater) nativeUpdate(context.Context, bool) (*Status, error) {
+	return u.status(), errs.New(errs.Usage, "本地原生包仅支持 macOS")
+}
+func (l layout) nativeStagedVersion(*jsonord.Obj) (Version, bool) { return Version{}, false }
diff --git a/internal/update/native_xattr_darwin.go b/internal/update/native_xattr_darwin.go
new file mode 100644
index 0000000..e739dad
--- /dev/null
+++ b/internal/update/native_xattr_darwin.go
@@ -0,0 +1,90 @@
+//go:build darwin && cgo
+
+package update
+
+/*
+#include <sys/xattr.h>
+#include <stdlib.h>
+static ssize_t native_getxattr(const char *path,const char *name,void *buf,size_t size) {
+    return getxattr(path,name,buf,size,0,XATTR_NOFOLLOW);
+}
+static int native_setxattr(const char *path,const char *name,const void *buf,size_t size) {
+    return setxattr(path,name,buf,size,0,XATTR_NOFOLLOW);
+}
+*/
+import "C"
+
+import (
+	"encoding/base64"
+	"fmt"
+	"unsafe"
+)
+
+var nativeSignatureAttrs = []string{"com.apple.cs.CodeDirectory", "com.apple.cs.CodeRequirements", "com.apple.cs.CodeSignature", "com.apple.cs.CodeEntitlements"}
+
+func nativeXattrs(p string) (map[string]string, error) {
+	cp := C.CString(p)
+	defer C.free(unsafe.Pointer(cp))
+	out := map[string]string{}
+	for _, name := range nativeSignatureAttrs {
+		cn := C.CString(name)
+		n := C.native_getxattr(cp, cn, nil, 0)
+		if n < 0 {
+			C.free(unsafe.Pointer(cn))
+			continue
+		}
+		if n > 1<<20 {
+			C.free(unsafe.Pointer(cn))
+			return nil, fmt.Errorf("signature metadata too large: %s", p)
+		}
+		b := make([]byte, int(n))
+		var ptr unsafe.Pointer
+		if len(b) > 0 {
+			ptr = unsafe.Pointer(&b[0])
+		}
+		read := C.native_getxattr(cp, cn, ptr, C.size_t(len(b)))
+		C.free(unsafe.Pointer(cn))
+		if read != n {
+			return nil, fmt.Errorf("cannot read signature metadata: %s", p)
+		}
+		out[name] = base64.StdEncoding.EncodeToString(b)
+	}
+	return out, nil
+}
+func validateNativeXattrs(attrs map[string]string) error {
+	for name, value := range attrs {
+		allowed := false
+		for _, key := range nativeSignatureAttrs {
+			allowed = allowed || name == key
+		}
+		if !allowed {
+			return packageError("不允许的签名扩展属性: %s", name)
+		}
+		b, err := base64.StdEncoding.DecodeString(value)
+		if err != nil || len(b) > 1<<20 {
+			return packageError("签名扩展属性格式错误: %s", name)
+		}
+	}
+	return nil
+}
+func restoreNativeXattrs(p string, attrs map[string]string) error {
+	if err := validateNativeXattrs(attrs); err != nil {
+		return err
+	}
+	cp := C.CString(p)
+	defer C.free(unsafe.Pointer(cp))
+	for name, value := range attrs {
+		b, _ := base64.StdEncoding.DecodeString(value)
+		cn := C.CString(name)
+		var ptr unsafe.Pointer
+		if len(b) > 0 {
+			ptr = unsafe.Pointer(&b[0])
+		}
+		result := C.native_setxattr(cp, cn, ptr, C.size_t(len(b)))
+		C.free(unsafe.Pointer(cn))
+		if result != 0 {
+			return packageError("不能恢复签名扩展属性: %s / %s", p, name)
+		}
+	}
+	return nil
+}

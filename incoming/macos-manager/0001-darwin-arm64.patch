+func fatal(msg string) {
+	fmt.Fprintln(os.Stderr, msg)
+	if exe, err := os.Executable(); err == nil {
+		helper := filepath.Join(filepath.Dir(exe), "modavd-webview")
+		if _, err := os.Stat(helper); err == nil {

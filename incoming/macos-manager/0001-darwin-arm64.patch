diff --git a/internal/ui/web/js/checks.js b/internal/ui/web/js/checks.js
new file mode 100644
index 0000000..426b3c5
--- /dev/null
+++ b/internal/ui/web/js/checks.js
@@ -0,0 +1,40 @@
+// Host-check snapshot policy, shared by cards, menus and the viewer. The backend
+// always checks fresh resources before a start; this snapshot is only UI advice.
+const failed = (c) => (c.items || []).filter((x) => x.blocking && x.ok === false);
+const positiveMB = (n) => Number.isSafeInteger(n) && n > 0;
+
+function memoryBudget(c) {
+  const b = (c.items || []).find((x) => x.id === 'memory' && x.blocking)?.memory;
+  return b && positiveMB(b.instance_mb) && Number.isSafeInteger(b.available_mb) && b.available_mb >= 0
+    && Number.isSafeInteger(b.overhead_mb) && b.overhead_mb >= 0 ? b : null;
+}
+
+export function memoryLimited(c) {
+  if (!c || c.ready !== false || !memoryBudget(c)) return false;
+  const failures = failed(c);
+  return failures.length > 0 && failures.every((x) => x.id === 'memory');
+}
+
+export function checkSummary(c) {
+  if (!c) return null;
+  const items = c.items || [];
+  const blockers = failed(c);
+  const hints = items.filter((x) => (x.ok === false && !x.blocking) || x.ok == null);
+  const memoryOnly = memoryLimited(c);
+  const tone = memoryOnly ? 'warn' : !c.ready || blockers.length ? 'err' : hints.length ? 'warn' : 'ok';
+  return { tone, text: memoryOnly ? '内存需调整' : { err: '不能开机', warn: '有提示', ok: '就绪' }[tone], blockers, hints, memoryOnly, n: items.length };
+}
+
+export function bootBlocked(c, memoryMB, afterStop = false) {
+  if (!c) return false;
+  const failures = failed(c);
+  if (failures.some((x) => x.id !== 'memory')) return true;
+  // Preserve a failed response whose reason is unknown to this client.
+  if (c.ready === false && !failures.length) return true;
+  // Restart stops the guest before the backend's fresh memory check. Current
+  // free memory includes the guest still running; do not estimate its release.
+  if (afterStop) return false;
+  const budget = memoryBudget(c);
+  if (!budget || !positiveMB(memoryMB)) return c.ready === false || failures.length > 0;
+  return budget.available_mb < memoryMB + budget.overhead_mb;
+}

+			if restarted != tc.restarted || pending != tc.pending || fixes != tc.fixes || pushes != tc.pushes {
+				t.Fatalf("got restart=%v pending=%v fixes=%d pushes=%d", restarted, pending, fixes, pushes)
+			}
+			if restarted && !strings.Contains(strings.Join(logs, "\n"), vkfix.ARM64FixSHA256) {
+				t.Fatal("ARM64 result hash missing from report")
+			}
+		})
+	}
+}

diff --git a/internal/adb/identity_darwin.go b/internal/adb/identity_darwin.go
new file mode 100644
index 0000000..afad30e
--- /dev/null
+++ b/internal/adb/identity_darwin.go
@@ -0,0 +1,121 @@
+//go:build darwin
+
+package adb
+
+import (
+	"modavd/internal/host"
+	"modavd/internal/root"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+// Match the pinned ConfigDirs::getDiscoveryDirectory: Darwin uses HOME's temporary cache
+// directory, falling back to the emulator user directory only when HOME is empty.
+func EmulatorDiscoveryDir() string {
+	if p := os.Getenv("HOME"); p != "" {
+		return filepath.Join(p, "Library", "Caches", "TemporaryItems", "avd", "running")
+	}
+	return filepath.Join(emulatorUserDir(), "avd", "running")
+}
+func emulatorUserDir() string {
+	if p := os.Getenv("ANDROID_EMULATOR_HOME"); p != "" {
+		return p
+	}
+	// Match the pinned emulator's ConfigDirs::getUserDirectory, including its deprecated SDK_HOME fallback.
+	// ANDROID_USER_HOME is not used by that implementation.
+	for _, key := range []string{"ANDROID_PREFS_ROOT", "ANDROID_SDK_HOME"} {
+		if p := os.Getenv(key); p != "" {
+			sub := filepath.Join(p, ".android")
+			if st, err := os.Stat(sub); err == nil && st.IsDir() {
+				return sub
+			}
+			return p
+		}
+	}
+	p, _ := os.UserHomeDir()
+	if p == "" {
+		p = os.TempDir()
+		if p == "" {
+			p = "/tmp"
+		}
+	}
+	return filepath.Join(p, ".android")
+}
+func samePath(a, b string) bool {
+	if as, err := os.Stat(a); err == nil {
+		if bs, err := os.Stat(b); err == nil {
+			return os.SameFile(as, bs)
+		}
+	}
+	return resolvedPath(a) == resolvedPath(b)
+}
+func resolvedPath(p string) string {
+	q, e := filepath.Abs(p)
+	if e == nil {
+		p = q
+	}
+	p = filepath.Clean(p)
+	// Resolve an existing parent too: a new AVD or cache path may not have its final component yet.
+	base := p
+	var suffix []string
+	for {
+		if q, err := filepath.EvalSymlinks(base); err == nil {
+			for n := len(suffix) - 1; n >= 0; n-- {
+				q = filepath.Join(q, suffix[n])
+			}
+			return q
+		}
+		parent := filepath.Dir(base)
+		if parent == base {
+			return p
+		}
+		suffix = append(suffix, filepath.Base(base))
+		base = parent
+	}
+}
+func pathUnder(p, dir string) bool {
+	rel, e := filepath.Rel(resolvedPath(dir), resolvedPath(p))
+	return e == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && !filepath.IsAbs(rel)
+}
+func runningAvdDir(dir string, p host.Process) string {
+	path := filepath.Join(dir, "pid_"+strconv.FormatUint(uint64(p.PID), 10)+".ini")
+	st, e := os.Stat(path)
+	if e != nil || st.ModTime().Before(p.StartedAt()) {
+		return ""
+	}
+	b, e := os.ReadFile(path)
+	if e != nil {
+		return ""
+	}
+	for _, l := range strings.Split(string(b), "\n") {
+		k, v, ok := strings.Cut(l, "=")
+		if ok && strings.TrimSpace(k) == "avd.dir" {
+			return strings.TrimSpace(v)
+		}
+	}
+	return ""
+}
+func QemuBelongsTo(r *root.Root, p host.Process, i int) bool {
+	target := filepath.Join(r.AvdHome(), root.AvdName(i)+".avd")
+	if avd := runningAvdDir(EmulatorDiscoveryDir(), p); avd != "" {
+		return samePath(avd, target)
+	}
+	// Early startup: require our exact executable and ANDROID_AVD_HOME from the launch record when available.
+	exe, e := p.ImagePath()
+	if e != nil || !pathUnder(exe, filepath.Join(r.RuntimeSDK(), "emulator")) {
+		return false
+	}
+	// A shared runtime SDK can serve several roots: argv matching alone cannot establish ownership.
+	args, e := p.CommandLine()
+	if e != nil {
+		return false
+	}
+	for n, a := range args {
+		if (a == "-datadir" || a == "-content") && n+1 < len(args) {
+			return samePath(args[n+1], target)
+		}
+	}
+	return false
+}

diff --git a/internal/adb/darwin_test.go b/internal/adb/darwin_test.go
new file mode 100644
index 0000000..e104f4e
--- /dev/null
+++ b/internal/adb/darwin_test.go
@@ -0,0 +1,120 @@
+//go:build darwin
+
+package adb
+
+import (
+	"net"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+func tempDir(t *testing.T) string { t.Helper(); return t.TempDir() }
+
+func freePort(t *testing.T) int {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := ln.Addr().(*net.TCPAddr).Port
+	ln.Close()
+	return port
+}
+
+func TestDarwinEnvironmentAndPaths(t *testing.T) {
+	got := mergeEnv([]string{"ANDROID_HOME=old", "android_home=distinct", "UNCHANGED=yes"}, map[string]string{"ANDROID_HOME": "new"})
+	if !slices.Contains(got, "ANDROID_HOME=new") || !slices.Contains(got, "android_home=distinct") || slices.Contains(got, "ANDROID_HOME=old") {
+		t.Fatalf("case-sensitive environment: %q", got)
+	}
+	dir := t.TempDir()
+	real := filepath.Join(dir, "real")
+	if err := os.Mkdir(real, 0755); err != nil {
+		t.Fatal(err)
+	}
+	alias := filepath.Join(dir, "alias")
+	if err := os.Symlink(real, alias); err != nil {
+		t.Fatal(err)
+	}
+	if !samePath(real, alias) || !pathUnder(filepath.Join(alias, "qemu"), real) || pathUnder(real, filepath.Join(dir, "real2")) {
+		t.Fatal("incorrect real-path ownership")
+	}
+}
+
+func TestDarwinEmulatorDiscoveryDirectory(t *testing.T) {
+	home, emulator := t.TempDir(), t.TempDir()
+	t.Setenv("ANDROID_EMULATOR_HOME", emulator)
+	t.Setenv("ANDROID_PREFS_ROOT", t.TempDir())
+	t.Setenv("ANDROID_SDK_HOME", t.TempDir())
+	t.Setenv("ANDROID_USER_HOME", t.TempDir())
+	t.Run("HOME present overrides emulator user directory", func(t *testing.T) {
+		t.Setenv("HOME", home)
+		want := filepath.Join(home, "Library", "Caches", "TemporaryItems", "avd", "running")
+		if got := EmulatorDiscoveryDir(); got != want {
+			t.Fatalf("discovery = %q, want %q", got, want)
+		}
+		if got := emulatorUserDir(); got != emulator {
+			t.Fatalf("user directory = %q, want %q", got, emulator)
+		}
+	})
+	t.Run("empty HOME falls back to emulator user directory", func(t *testing.T) {
+		t.Setenv("HOME", "")
+		want := filepath.Join(emulator, "avd", "running")
+		if got := EmulatorDiscoveryDir(); got != want {
+			t.Fatalf("discovery = %q, want %q", got, want)
+		}
+	})
+}
+
+func TestDarwinEmulatorUserDirectoryEnvironment(t *testing.T) {
+	for _, key := range []string{"ANDROID_EMULATOR_HOME", "ANDROID_PREFS_ROOT", "ANDROID_SDK_HOME"} {
+		t.Setenv(key, "")
+	}
+	// This variable is used by other Android tools, but not by the pinned emulator's ConfigDirs implementation.
+	t.Setenv("ANDROID_USER_HOME", filepath.Join(t.TempDir(), "unrelated"))
+	home, err := os.UserHomeDir()
+	if err != nil {
+		t.Fatal(err)
+	}
+	check := func(want string) {
+		t.Helper()
+		if got := emulatorUserDir(); got != want {
+			t.Fatalf("user directory = %q, want %q", got, want)
+		}
+	}
+	check(filepath.Join(home, ".android"))
+	sdk, prefs, emulator := t.TempDir(), t.TempDir(), t.TempDir()
+	t.Setenv("ANDROID_SDK_HOME", sdk)
+	check(sdk)
+	if err := os.Mkdir(filepath.Join(sdk, ".android"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	check(filepath.Join(sdk, ".android"))
+	t.Setenv("ANDROID_PREFS_ROOT", prefs)
+	check(prefs)
+	if err := os.WriteFile(filepath.Join(prefs, ".android"), nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	check(prefs) // A regular file does not select the subdirectory.
+	if err := os.Remove(filepath.Join(prefs, ".android")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(filepath.Join(prefs, ".android"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	check(filepath.Join(prefs, ".android"))
+	t.Setenv("ANDROID_EMULATOR_HOME", emulator)
+	check(emulator)
+}
+
+func TestDarwinConsoleHomeIgnoresWindowsEnvironment(t *testing.T) {
+	t.Setenv("USERPROFILE", t.TempDir())
+	want, err := os.UserHomeDir()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, err := consoleHomeDir(); err != nil || got != want {
+		t.Fatalf("native console home = %q, %v; want %q", got, err, want)
+	}
+}

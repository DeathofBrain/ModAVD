new file mode 100644
index 0000000..f379e46
--- /dev/null
+++ b/internal/emu/window_darwin.go
@@ -0,0 +1,34 @@
+//go:build darwin
+
+package emu
+
+import (
+	"context"
+	"fmt"
+	"modavd/internal/adb"
+	"modavd/internal/host"
+	"modavd/internal/root"
+	"strconv"
+	"strings"
+)
+
+// Window operations execute on the emulator's Qt event thread. AppKit cannot safely control another process's windows.
+func setWindowVisible(ctx context.Context, p host.Process, name string, i int, visible bool) (int, error) {
+	verb := "hide"
+	if visible {
+		verb = "show"
+	}
+	out, err := adb.Console(ctx, root.ConsolePort(i), "window "+verb, 0)
+	if err != nil {
+		return 0, err
+	}
+	for _, line := range strings.Split(out, "\n") {
+		if value, ok := strings.CutPrefix(strings.TrimSpace(line), "windows="); ok {
+			n, err := strconv.Atoi(value)
+			if err == nil && n >= 0 {
+				return n, nil
+			}
+		}
+	}
+	return 0, fmt.Errorf("控制台没有返回窗口数: %s", out)
+}

+func TestDarwinProcessIdentity(t *testing.T) {
+	p, ok := FindProcess(uint32(os.Getpid()))
+	if !ok || p.Created == 0 || !p.Alive() || p.StartedAt().After(time.Now()) {
+		t.Fatalf("self identity: %+v, found=%v", p, ok)
+	}
+	if args, err := p.CommandLine(); err != nil || len(args) == 0 {
+		t.Fatalf("self argv: %q, %v", args, err)
+	}
+	if path, err := p.ImagePath(); err != nil || !filepath.IsAbs(path) {
+		t.Fatalf("self path: %q, %v", path, err)
+	}
+	stale := p
+	stale.Created++
+	if stale.Alive() {
+		t.Fatal("reused PID accepted")
+	}
+	if _, err := stale.CommandLine(); err == nil {
+		t.Fatal("argv of a reused PID accepted")
+	}
+	if err := stale.Kill(); err != nil || !p.Alive() {
+		t.Fatalf("stale identity touched current process: %v", err)
+	}
+	if _, known := p.ExitCode(); known {
+		t.Fatal("invented an exit status for a running process")
+	}
+}
+
+func TestDarwinListenerOwnership(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	port := ln.Addr().(*net.TCPAddr).Port
+	pid, found, err := ListenerPID(port)
+	if err != nil || !found || pid != uint32(os.Getpid()) {
+		t.Fatalf("listener %d: pid=%d found=%v error=%v", port, pid, found, err)
+	}
+	busy, err := BusyPorts([]int{port})
+	if err != nil || !slices.Contains(busy, port) {
+		t.Fatalf("busy: %v %v", busy, err)
+	}
+}
+
+func TestDarwinFileLock(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "new-directory", "lock")
+	one, ok, err := TryLock(path)
+	if err != nil || !ok {
+		t.Fatalf("first lock: %v %v", ok, err)
+	}
+	defer one.Unlock()
+	if _, ok, err := Lock(path, 50*time.Millisecond); err != nil || ok {
+		t.Fatalf("concurrent lock: %v %v", ok, err)
+	}
+	one.Unlock()
+	two, ok, err := TryLock(path)
+	if err != nil || !ok {
+		t.Fatalf("released lock: %v %v", ok, err)
+	}
+	two.Unlock()
+	two.Unlock()
+}
+
+func TestDarwinOrphanLaunch(t *testing.T) {
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	saved := OrphanHelper
+	OrphanHelper = exe
+	defer func() { OrphanHelper = saved }()
+	started := time.Now()
+	p, err := StartOrphan(exe, []string{"__darwin_child"}, StartOptions{OutputPath: filepath.Join(t.TempDir(), "child.log")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Kill()
+	if time.Since(started) > 5*time.Second || !p.Alive() || p.Created == 0 {
+		t.Fatalf("detached launch: %+v", p)
+	}
+	for until := time.Now().Add(2 * time.Second); time.Now().Before(until); {
+		current, ok := FindProcess(p.PID)
+		if ok && current.PPID == 1 {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	current, ok := FindProcess(p.PID)
+	if !ok || current.PPID != 1 {
+		t.Fatalf("child retained helper parent: %+v", current)
+	}
+	if group, err := syscall.Getpgid(int(p.PID)); err != nil || group != int(p.PID) {
+		t.Fatalf("child retained caller process group: %d %v", group, err)
+	}
+	if args, err := p.CommandLine(); err != nil || !slices.Contains(args, "__darwin_child") {
+		t.Fatalf("child argv: %v %v", args, err)
+	}
+	if err := p.Kill(); err != nil || !p.Wait(3*time.Second) {
+		t.Fatalf("owned child cleanup: %v", err)
+	}
+}

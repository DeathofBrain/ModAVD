@@ -0,0 +1,29 @@
+//go:build darwin
+
+package update
+
+import (
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+)
+
+func removeBestEffort(p string) bool {
+	st, e := os.Lstat(p)
+	if e != nil {
+		return errors.Is(e, fs.ErrNotExist)
+	}
+	if st.IsDir() {
+		entries, e := os.ReadDir(p)
+		if e != nil {
+			return false
+		}
+		for _, entry := range entries {
+			if !removeBestEffort(filepath.Join(p, entry.Name())) {
+				return false
+			}
+		}
+	}
+	return os.Remove(p) == nil
+}
diff --git a/internal/update/remove_windows.go b/internal/update/remove_windows.go
new file mode 100644
index 0000000..152ea9f
--- /dev/null
+++ b/internal/update/remove_windows.go
@@ -0,0 +1,50 @@
+//go:build windows
+
+package update
+
+import (
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"syscall"
+)
+
+const fileAttributeReparsePoint = 0x400
+
+// removeBestEffort removes p and, for a real directory, its contents first; a link or junction is removed as the link
+// itself. Reports whether p is gone.
+func removeBestEffort(p string) bool {
+	st, err := os.Lstat(p)
+	if err != nil {
+		return errors.Is(err, fs.ErrNotExist)
+	}
+	if sys, ok := st.Sys().(*syscall.Win32FileAttributeData); ok && sys.FileAttributes&fileAttributeReparsePoint != 0 {
+		if os.Remove(p) != nil {
+			return syscall.RemoveDirectory(mustUTF16(p)) == nil
+		}
+		return true
+	}
+	if st.IsDir() {
+		entries, _ := os.ReadDir(p)
+		all := true
+		for _, e := range entries {
+			if !removeBestEffort(filepath.Join(p, e.Name())) {
+				all = false
+			}
+		}
+		if !all {
+			return false
+		}
+	}
+	if err := os.Remove(p); err != nil {
+		os.Chmod(p, 0o666)
+		return os.Remove(p) == nil
+	}
+	return true
+}
+
+func mustUTF16(s string) *uint16 {
+	p, _ := syscall.UTF16PtrFromString(s)
+	return p
+}

+//go:build darwin
+
+package host
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestDarwinOpenFilesRejectsStaleIdentity(t *testing.T) {
+	p, ok := FindProcess(uint32(os.Getpid()))
+	if !ok {
+		t.Fatal("self missing")
+	}
+	name := filepath.Join(t.TempDir(), "held")
+	f, err := os.Create(name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	paths, err := p.OpenFiles()
+	if err != nil {
+		t.Fatal(err)
+	}
+	real, err := filepath.EvalSymlinks(name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, path := range paths {
+		found = found || path == real
+	}
+	if !found {
+		t.Fatalf("open file not observed")
+	}
+	p.Created++
+	if _, err := p.OpenFiles(); !errors.Is(err, os.ErrProcessDone) {
+		t.Fatalf("reused PID accepted: %v", err)
+	}
+}

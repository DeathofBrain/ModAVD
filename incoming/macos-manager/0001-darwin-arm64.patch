+//go:build windows
+
+package emu
+
+import (
+	"errors"
+	"io/fs"
+	"os"
+)
+
+func lockLogDirectory(string) (func(), error)           { return func() {}, nil }
+func activeManagedLogs(string) (map[string]bool, error) { return nil, nil }
+func platformFileInUse(path string) (busy, vanished bool) {
+	err := os.Rename(path, path)
+	if err == nil {
+		return false, false
+	}
+	if errors.Is(err, fs.ErrNotExist) {
+		return false, true
+	}
+	if _, err := os.Lstat(path); errors.Is(err, fs.ErrNotExist) {
+		return false, true
+	}
+	return true, false
+}

new file mode 100644
index 0000000..844673c
--- /dev/null
+++ b/internal/emu/gpuenv_darwin.go
@@ -0,0 +1,11 @@
+//go:build darwin
+
+package emu
+
+// MoltenVK's shared unified-memory type is both device-local and host-visible. Hiding ReBAR would remove its
+// guest-visible/coherent/cached flags, so explicitly override a value inherited from a Windows-oriented shell.
+const hideRebar = "0"
+
+func emulatorGPUEnv(_ string) []string {
+	return []string{"ANDROID_EMU_VK_HIDE_REBAR=" + hideRebar}
+}

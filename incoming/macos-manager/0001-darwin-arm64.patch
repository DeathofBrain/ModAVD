new file mode 100644
index 0000000..2c70e4d
--- /dev/null
+++ b/internal/emu/gpuenv_windows.go
@@ -0,0 +1,15 @@
+//go:build windows
+
+package emu
+
+// Keep AUTO-MAS's NVIDIA ReBAR workaround and private driver shader cache on Windows.
+const hideRebar = "1"
+
+func emulatorGPUEnv(shaderCache string) []string {
+	return []string{
+		"__GL_SHADER_DISK_CACHE=1",
+		"__GL_SHADER_DISK_CACHE_PATH=" + shaderCache,
+		"__GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1",
+		"ANDROID_EMU_VK_HIDE_REBAR=" + hideRebar,
+	}
+}

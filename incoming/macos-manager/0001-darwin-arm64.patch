new file mode 100644
index 0000000..4bad50b
--- /dev/null
+++ b/internal/ui/window_darwin.go
@@ -0,0 +1,41 @@
+//go:build darwin
+
+package ui
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"time"
+)
+
+type Window struct {
+	Edge    bool
+	Started time.Time
+	Done    <-chan struct{}
+}
+
+func AppDataDir() string {
+	base, e := os.UserConfigDir()
+	if e != nil {
+		base = os.TempDir()
+	}
+	return filepath.Join(base, "ModAVD")
+}
+func LaunchWindow(url string) (*Window, error) {
+	exe, _ := os.Executable()
+	launcher := filepath.Join(filepath.Dir(exe), "modavd-webview")
+	if _, e := os.Stat(launcher); e == nil {
+		cmd := exec.Command(launcher, url)
+		if e := cmd.Start(); e == nil {
+			done := make(chan struct{})
+			go func() { cmd.Wait(); close(done) }()
+			return &Window{true, time.Now(), done}, nil
+		}
+	}
+	if e := shellOpen(url); e != nil {
+		return nil, e
+	}
+	return &Window{Started: time.Now()}, nil
+}
+func shellOpen(target string) error { return exec.Command("/usr/bin/open", target).Run() }

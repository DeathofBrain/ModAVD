+func TestDarwinDownloadSpaceStopKeepsPartial(t *testing.T) {
+	for _, brokenProbe := range []bool{false, true} {
+		name := "low-space"
+		if brokenProbe {
+			name = "probe-error"
+		}
+		t.Run(name, func(t *testing.T) {
+			withSettings(t, SourceGitHub, "")
+			r := writeRoot(t, 36, nil)
+			u := New(r, nil, Options{})
+			const asset = "fixture.zip"
+			part := u.l.downloadAt(asset) + ".part"
+			requests := 0
+			u.httpClient = &http.Client{Transport: fixtureTransport(func(*http.Request) (*http.Response, error) {
+				requests++
+				return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header),
+					Body: io.NopCloser(io.LimitReader(repeatingReader{}, 3*spaceCheckBytes))}, nil
+			})}
+			maxWritten := int64(0)
+			u.diskFree = func(string) (uint64, error) {
+				if st, err := os.Stat(part); err == nil && st.Size() > maxWritten {
+					maxWritten = st.Size()
+				}
+				if maxWritten >= spaceCheckBytes {
+					if brokenProbe {
+						return 0, errors.New("fixture disk probe failed")
+					}
+					return minFreeBytes - 1, nil
+				}
+				return minFreeBytes + spaceCheckBytes, nil
+			}
+			_, err := u.download(context.Background(), &release{source: SourceGitHub, assetName: asset,
+				url: "https://fixture.invalid/payload", size: 3 * spaceCheckBytes, version: Version{0, 37, 0}})
+			if errs.CodeOf(err) != errs.PrecheckFailed {
+				t.Fatalf("wrong stop: %v", err)
+			}
+			st, statErr := os.Stat(part)
+			if statErr != nil || st.Size() != spaceCheckBytes || maxWritten != spaceCheckBytes || requests != 1 {
+				t.Fatalf("partial/retry: %v %v max=%d requests=%d", st, statErr, maxWritten, requests)
+			}
+			if lexists(u.l.downloadAt(asset)) {
+				t.Fatal("incomplete archive was published")
+			}
+			assertPackage(t, r, 36, nil)
+		})
+	}

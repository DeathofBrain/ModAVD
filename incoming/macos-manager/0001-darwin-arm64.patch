+// Arm a deterministic disk probe once a file reaches one MiB. The failure
+// remains sticky even if cleanup removes that partial file.
+func stopAfterMiB(u *Updater, path string, broken bool) *int64 {
+	maxWritten := new(int64)
+	u.diskFree = func(string) (uint64, error) {
+		if st, err := os.Stat(path); err == nil && st.Size() > *maxWritten {
+			*maxWritten = st.Size()
+		}
+		if *maxWritten >= spaceCheckBytes {
+			if broken {
+				return 0, errors.New("fixture disk probe failed")
+			}
+			return minFreeBytes - 1, nil
+		}
+		return minFreeBytes + spaceCheckBytes, nil
+	}
+	return maxWritten
+}

+//go:build darwin
+
+package update
+
+import (
+	"archive/zip"
+	"context"
+	"encoding/json"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"modavd/internal/root"
+)
+
+func nativeFixture(t *testing.T) (string, *nativeManifest) {
+	t.Helper()
+	base := t.TempDir()
+	src := filepath.Join(t.TempDir(), "fixture.c")
+	if err := os.WriteFile(src, []byte("#include <stdio.h>\nint main(void){puts(\"free-page-reporting\");return 0;}\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	bin := filepath.Join(t.TempDir(), "fixture")
+	if out, err := exec.Command("/usr/bin/clang", "-arch", "arm64", "-o", bin, src).CombinedOutput(); err != nil {
+		t.Fatalf("clang: %s %v", out, err)
+	}
+	b, err := os.ReadFile(bin)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, p := range append(managerPaths(), "sdk/emulator/"+root.EmulatorBinary, "sdk/emulator/qemu/"+root.QemuHostDir+"/"+root.QemuBinary, "sdk/emulator/qemu/"+root.QemuHostDir+"/"+root.QemuHeadlessBinary) {
+		dst := filepath.Join(base, filepath.FromSlash(p))
+		os.MkdirAll(filepath.Dir(dst), 0755)
+		if err := os.WriteFile(dst, b, 0755); err != nil {
+			t.Fatal(err)
+		}
+		nativeRun(t, "/usr/bin/codesign", "--force", "--sign", "-", dst)
+	}
+	files := map[string]string{
+		"sdk/emulator/source.properties":              "Pkg.Revision=37.2.10\nPkg.BuildId=mas-37\n",
+		"sdk/emulator/resources/versions/A/value.txt": "linked resource",
+		"ModAVD.app/Contents/Info.plist":              `<?xml version="1.0"?><plist version="1.0"><dict><key>CFBundleExecutable</key><string>ModAVD</string><key>CFBundleIdentifier</key><string>org.modavd.update-fixture</string><key>CFBundlePackageType</key><string>APPL</string><key>CFBundleVersion</key><string>1</string></dict></plist>`,
+		manifestName:                                  `{"version":"v0.37.0","build":37,"platform":"mac-arm64"}`,
+	}
+	for p, b := range files {
+		dst := filepath.Join(base, filepath.FromSlash(p))
+		os.MkdirAll(filepath.Dir(dst), 0755)
+		if err := os.WriteFile(dst, []byte(b), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.Symlink("A", filepath.Join(base, "sdk/emulator/resources/versions/Current")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("versions/Current/value.txt", filepath.Join(base, "sdk/emulator/resources/value.txt")); err != nil {
+		t.Fatal(err)
+	}
+	nativeRun(t, "/usr/bin/codesign", "--force", "--deep", "--sign", "-", filepath.Join(base, "sdk/emulator"))
+	nativeRun(t, "/usr/bin/codesign", "--force", "--deep", "--sign", "-", filepath.Join(base, "ModAVD.app"))
+	m := &nativeManifest{Schema: 1, Format: nativeFormat, Version: "v0.37.0", Build: 37, Platform: "mac-arm64", Units: []string{"sdk/emulator", "ModAVD.app", "tools", manifestName}}
+	nativeInventory(t, base, m)
+	return base, m
+}
+func nativeRun(t *testing.T, name string, args ...string) {
+	t.Helper()
+	if out, err := exec.Command(name, args...).CombinedOutput(); err != nil {
+		t.Fatalf("%s: %s %v", name, out, err)
+	}
+}
+func nativeInventory(t *testing.T, base string, m *nativeManifest) {
+	t.Helper()
+	m.Files = map[string]nativeFile{}
+	for _, unit := range m.Units {
+		err := filepath.WalkDir(filepath.Join(base, filepath.FromSlash(unit)), func(p string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			if d.IsDir() {
+				return nil
+			}
+			rel, _ := filepath.Rel(base, p)
+			info, err := d.Info()
+			if err != nil {
+				return err
+			}
+			s := nativeFile{Type: "file", Mode: uint32(info.Mode().Perm()), Size: info.Size()}
+			if info.Mode()&os.ModeSymlink != 0 {
+				s.Type = "symlink"
+				s.Target, err = os.Readlink(p)
+				s.Size = 0
+				s.Mode = 0
+				s.SHA256 = digestBytes([]byte(s.Target))
+			} else {
+				s.SHA256, err = hashFile(p)
+				s.Xattrs, err = nativeXattrs(p)
+			}
+			if err != nil {
+				return err
+			}
+			m.Files[filepath.ToSlash(rel)] = s
+			return nil
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+func nativeZip(t *testing.T, base string, m *nativeManifest) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "ModAVD-0.37.0-mac-arm64.zip")
+	f, err := os.Create(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w := zip.NewWriter(f)
+	for rel, s := range m.Files {
+		h := &zip.FileHeader{Name: rel, Method: zip.Deflate}
+		mode := os.FileMode(s.Mode)
+		var b []byte
+		if s.Type == "symlink" {
+			mode = os.ModeSymlink | 0777
+			b = []byte(s.Target)
+		} else {
+			b, err = os.ReadFile(filepath.Join(base, filepath.FromSlash(rel)))
+			if err != nil {
+				t.Fatal(err)
+			}
+		}
+		h.SetMode(mode)
+		entry, err := w.CreateHeader(h)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := entry.Write(b); err != nil {
+			t.Fatal(err)
+		}
+	}
+	b, err := json.Marshal(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := &zip.FileHeader{Name: nativeManifestName, Method: zip.Deflate}
+	h.SetMode(0644)
+	e, err := w.CreateHeader(h)
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Write(b)
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+func nativeUpdater(t *testing.T, p string) (*Updater, *root.Root) {
+	t.Helper()
+	withSettings(t, SourceGitHub, "")
+	r := writeRoot(t, 36, nil)
+	sum, err := hashFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	u := New(r, nil, Options{PackagePath: p, PackageSHA256: sum})
+	u.scan = func(bool) ([]processUse, error) { return nil, nil }
+	u.diskFree = func(string) (uint64, error) { return minFreeBytes + 1, nil }
+	return u, r
+}
+
+func TestDarwinNativeSignedPrepareInstall(t *testing.T) {
+	base, m := nativeFixture(t)
+	p := nativeZip(t, base, m)
+	u, r := nativeUpdater(t, p)
+	if st, err := u.Prepare(context.Background()); err != nil || st.PreparedVersion != "v0.37.0" {
+		t.Fatalf("prepare: %+v %v", st, err)
+	}
+	assertProtected(t, r)
+	u.Opt.PackagePath, u.Opt.PackageSHA256 = "", "" // Already prepared installation must be offline.
+	settingsPath = func() string { t.Fatal("local staged install opened credential settings"); return "" }
+	u.httpClient = nil
+	u.githubAPI = "https://invalid.invalid/must-not-query"
+	if st, err := u.Install(context.Background()); err != nil || !st.Updated {
+		t.Fatalf("install: %+v %v", st, err)
+	}
+	assertProtected(t, r)
+	if err := verifyDarwinPackage(r.Dir, m, Version{0, 37, 0}); err != nil {
+		t.Fatal(err)
+	}
+	if got, err := os.ReadFile(filepath.Join(r.Dir, "sdk/emulator/resources/value.txt")); err != nil || string(got) != "linked resource" {
+		t.Fatalf("link: %q %v", got, err)
+	}
+}
+
+func TestDarwinNativeRejectsTamperingAndUnsigned(t *testing.T) {
+	base, m := nativeFixture(t)
+	p := filepath.Join(base, managerPaths()[0])
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Change the signed __TEXT string, not unsealed CodeSignature padding.
+	index := strings.Index(string(b), "free-page-reporting")
+	if index < 0 {
+		t.Fatal("fixture string missing")
+	}
+	b[index] ^= 1
+	if err := os.WriteFile(p, b, 0755); err != nil {
+		t.Fatal(err)
+	}
+	nativeInventory(t, base, m) // A self-consistent hash manifest cannot replace signature verification.
+	if err := verifyDarwinPackage(base, m, Version{0, 37, 0}); err == nil {
+		t.Fatal("modified signed native file accepted")
+	}
+	if err := os.WriteFile(p, []byte("#!/bin/sh\nexit 0\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	nativeInventory(t, base, m)
+	if err := verifyDarwinPackage(base, m, Version{0, 37, 0}); err == nil {
+		t.Fatal("script substitute accepted as native app")
+	}
+}
+

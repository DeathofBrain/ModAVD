+
+// This includes a large single Write from an io.WriterTo source: it must not
+// bypass the MiB limit, and small network reads must not cause a probe per read.
+func TestDarwinSpaceWriterBounds(t *testing.T) {
+	var out bytes.Buffer
+	stopped := errors.New("space stop")
+	checks := 0
+	w := &spaceCheckedWriter{out: &out, check: func() error {
+		checks++
+		if checks == 2 {
+			return stopped
+		}
+		return nil
+	}}
+	n, err := io.Copy(w, strings.NewReader(strings.Repeat("x", 3*spaceCheckBytes)))
+	if !errors.Is(err, stopped) || n != spaceCheckBytes || out.Len() != spaceCheckBytes || checks != 2 {
+		t.Fatalf("large Write crossed stop: %d bytes, %d checks, %v", n, checks, err)
+	}
+	checks = 0
+	out.Reset()
+	w = &spaceCheckedWriter{out: &out, check: func() error { checks++; return nil }}
+	for k := 0; k < 1024; k++ {
+		if _, err := w.Write(make([]byte, 1024)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if checks != 1 {
+		t.Fatalf("small writes probed too often: %d", checks)
+	}
+}

diff --git a/internal/ui/checks_frontend_test.mjs b/internal/ui/checks_frontend_test.mjs
new file mode 100644
index 0000000..d25e158
--- /dev/null
+++ b/internal/ui/checks_frontend_test.mjs
@@ -0,0 +1,130 @@
+// Run with node --test internal/ui/checks_frontend_test.mjs. No browser,
+// external modules, ADB, emulator, server or filesystem mutation is required.
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+
+const moduleURL = (source) => 'data:text/javascript;base64,' + Buffer.from(source).toString('base64');
+const checksURL = moduleURL(await readFile(new URL('./web/js/checks.js', import.meta.url), 'utf8'));
+const { bootBlocked, memoryLimited, checkSummary } = await import(checksURL);
+const storeSource = (await readFile(new URL('./web/js/store.js', import.meta.url), 'utf8')).replace("'./checks.js'", JSON.stringify(checksURL));
+const storeURL = moduleURL(storeSource);
+const base = () => ({ ready: false, items: [
+  { id: 'components', blocking: true, ok: true },
+  { id: 'acceleration', blocking: true, ok: true },
+  { id: 'disk', blocking: true, ok: true },
+  { id: 'memory', blocking: true, ok: false, memory: { instance_mb: 6144, available_mb: 5120, overhead_mb: 1536 } },
+] });
+
+test('default 6 GiB failure allows 3 GiB but blocks 4 and 6 GiB', () => {
+  const c = base();
+  assert.equal(bootBlocked(c, 3072), false);
+  assert.equal(bootBlocked(c, 4096), true);
+  assert.equal(bootBlocked(c, 6144), true);
+  assert.equal(memoryLimited(c), true);
+  assert.equal(c.ready, false); // Default response semantics are preserved.
+});
+
+test('instance threshold includes host overhead and admits the exact boundary', () => {
+  const c = base();
+  c.items.at(-1).memory.available_mb = 4608;
+  assert.equal(bootBlocked(c, 3072), false);
+  c.items.at(-1).memory.available_mb--;
+  assert.equal(bootBlocked(c, 3072), true);
+  c.items.at(-1).memory.available_mb = 0;
+  assert.equal(bootBlocked(c, 3072), true);
+});
+
+test('a passing default check does not admit a larger unaffordable instance', () => {
+  const c = base();
+  c.ready = true;
+  c.items.at(-1).ok = true;
+  c.items.at(-1).memory.available_mb = 8192;
+  assert.equal(bootBlocked(c, 6144), false);
+  assert.equal(bootBlocked(c, 8192), true);
+});
+
+test('path, components, emulator, acceleration and disk remain blocking', () => {
+  for (const id of ['path', 'components', 'emulator', 'acceleration', 'disk']) {
+    const c = base();
+    c.items.push({ id, blocking: true, ok: false });
+    assert.equal(bootBlocked(c, 3072), true, id);
+    assert.equal(bootBlocked(c, 3072, true), true, id + ' restart');
+    assert.equal(memoryLimited(c), false, id + ' summary');
+  }
+});
+
+test('Vulkan warnings and unknown items preserve their nonblocking behavior', () => {
+  const c = base();
+  c.items.push({ id: 'vulkan', blocking: false, ok: false }, { id: 'probe', blocking: true, ok: null });
+  assert.equal(bootBlocked(c, 3072), false);
+});
+
+test('legacy responses, invalid budgets and invalid instance settings stay conservative', () => {
+  for (const budget of [undefined, {}, { instance_mb: 6144, available_mb: '5120', overhead_mb: 1536 },
+    { instance_mb: 6144, available_mb: 5120, overhead_mb: -1 }]) {
+    const c = base();
+    c.items.at(-1).memory = budget;
+    assert.equal(bootBlocked(c, 3072), true);
+    assert.equal(memoryLimited(c), false);
+  }
+  for (const memory of [undefined, 0, -1, '3072', NaN, Infinity]) assert.equal(bootBlocked(base(), memory), true);
+  assert.equal(bootBlocked({ ready: false, items: [] }, 3072), true);
+  assert.equal(bootBlocked({ ready: true, items: [] }, 3072), false);
+  assert.equal(bootBlocked(null, 3072), false);
+});
+
+test('restart defers only memory to the backend after Stop', () => {
+  const c = base();
+  c.items.at(-1).memory.available_mb = 0;
+  assert.equal(bootBlocked(c, 3072), true);
+  assert.equal(bootBlocked(c, 3072, true), false);
+  c.items[0].ok = false;
+  assert.equal(bootBlocked(c, 3072, true), true);
+});
+
+test('memory-only status explains a default budget without saying the whole root cannot boot', () => {
+  const c = base();
+  const summary = checkSummary(c);
+  assert.equal(summary.tone, 'warn');
+  assert.equal(summary.memoryOnly, true);
+  assert.equal(summary.text, '内存需调整');
+  assert.equal(summary.blockers.length, 1); // The default failure remains visible.
+  c.items[0].ok = false;
+  assert.equal(checkSummary(c).tone, 'err');
+  assert.equal(checkSummary(c).text, '不能开机');
+});
+
+test('live store uses updated per-instance settings instead of a captured configuration', async () => {
+  const { S, instance, rootBlocked } = await import(storeURL);
+  S.check = base();
+  S.list = { instances: [{ index: 0, config: { memory_mb: 3072 } }, { index: 1, config: { memory_mb: 6144 } }] };
+  assert.equal(rootBlocked(instance(0)), false);
+  assert.equal(rootBlocked(instance(1)), true);
+  S.list.instances[0] = { index: 0, config: { memory_mb: 8192 } };
+  assert.equal(rootBlocked(instance(0)), true);
+  assert.equal(rootBlocked(instance(0), true), false);
+});
+
+test('actual card menu keeps live window controls and restart available under RAM pressure', async () => {
+  // Load the actual menu function with its real store/policy. DOM-only imports
+  // are unused here; no click handlers, browser or mutation is exercised.
+  const cards = (await readFile(new URL('./web/js/cards.js', import.meta.url), 'utf8')).replace(/^import .*;\n/gm, '');
+  const { menuItems } = await import(moduleURL(`import { S, lastJob, rootBlocked } from ${JSON.stringify(storeURL)};\n` + cards + '\nexport { menuItems };'));
+  const { S } = await import(storeURL);
+  S.check = base();
+  const inst = { index: 0, status: 'offline', running: false, config: { memory_mb: 3072 } };
+  const menu = () => menuItems({ inst, i: 0 }).filter(Boolean);
+  assert.equal(menu().find((x) => x.label === '带窗口开机').disabled, false);
+  inst.config.memory_mb = 6144;
+  assert.equal(menu().find((x) => x.label === '带窗口开机').disabled, true);
+  inst.status = 'online';
+  inst.running = true;
+  S.check.items.at(-1).memory.available_mb = 0;
+  assert.equal(menu().find((x) => x.label === '重启').disabled, false);
+  assert.equal(menu().find((x) => x.label === '显示窗口').disabled, false);
+  assert.equal(menu().find((x) => x.label === '强制关机').disabled, false);
+  S.check.items[0].ok = false;
+  assert.equal(menu().find((x) => x.label === '重启').disabled, true);
+  assert.equal(menu().find((x) => x.label === '显示窗口').disabled, false);
+});

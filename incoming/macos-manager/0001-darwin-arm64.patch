diff --git a/internal/root/fs_darwin.go b/internal/root/fs_darwin.go
new file mode 100644
index 0000000..2d2be63
--- /dev/null
+++ b/internal/root/fs_darwin.go
@@ -0,0 +1,48 @@
+//go:build darwin
+
+package root
+
+import (
+	"errors"
+	"os"
+	"syscall"
+	"time"
+)
+
+func OpenShared(path string) (*os.File, error)   { return os.Open(path) }
+func ReadFileShared(path string) ([]byte, error) { return os.ReadFile(path) }
+func retryableReplaceError(err error) bool {
+	return errors.Is(err, syscall.EBUSY) || errors.Is(err, syscall.EINTR)
+}
+
+type fileLock struct{ file *os.File }
+
+func lockFile(path string, wait time.Duration) (*fileLock, bool, error) {
+	f, err := os.OpenFile(path, os.O_RDWR|os.O_CREATE, 0600)
+	if err != nil {
+		return nil, false, err
+	}
+	deadline := time.Now().Add(wait)
+	for {
+		err = syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
+		if err == nil {
+			return &fileLock{f}, true, nil
+		}
+		if !errors.Is(err, syscall.EWOULDBLOCK) {
+			f.Close()
+			return nil, false, err
+		}
+		if !time.Now().Before(deadline) {
+			f.Close()
+			return nil, false, nil
+		}
+		time.Sleep(25 * time.Millisecond)
+	}
+}
+func (l *fileLock) unlock() {
+	if l != nil && l.file != nil {
+		syscall.Flock(int(l.file.Fd()), syscall.LOCK_UN)
+		l.file.Close()
+		l.file = nil
+	}
+}

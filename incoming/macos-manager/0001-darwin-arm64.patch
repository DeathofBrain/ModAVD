diff --git a/internal/emu/logfiles_darwin.go b/internal/emu/logfiles_darwin.go
new file mode 100644
index 0000000..7808399
--- /dev/null
+++ b/internal/emu/logfiles_darwin.go
@@ -0,0 +1,84 @@
+//go:build darwin
+
+package emu
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"modavd/internal/host"
+)
+
+func lockLogDirectory(dir string) (func(), error) {
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return nil, err
+	}
+	lock, ok, err := host.Lock(filepath.Join(dir, ".writers.lock"), 30*time.Second)
+	if err != nil {
+		return nil, err
+	}
+	if !ok {
+		return nil, fmt.Errorf("log directory is busy: %s", dir)
+	}
+	return lock.Unlock, nil
+}
+
+// Protect every open managed file in this root, not only files opened by this Manager
+// process. libproc identifies actual outputs of orphaned qemu/logcat and launch helpers;
+// PID start times are checked before/after descriptor reads. No cached PID owns a log.
+func activeManagedLogs(dir string) (map[string]bool, error) {
+	canonical, err := filepath.EvalSymlinks(dir)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	procs, err := host.ListProcesses()
+	if err != nil {
+		return nil, err
+	}
+	active := map[string]bool{}
+	for _, p := range procs {
+		// Scan every readable process, including unrelated/manual writers. macOS
+		// denies protected system services' descriptors; a read error only blocks
+		// pruning when the process could be one of this root's managed writers.
+		image, imageErr := p.ImagePath()
+		name := strings.ToLower(p.Name)
+		writer := p.PID == uint32(os.Getpid()) || p.PPID == uint32(os.Getpid()) ||
+			strings.HasPrefix(name, "qemu") || strings.HasPrefix(name, "emulator") ||
+			strings.HasPrefix(name, "adb") || strings.Contains(name, "modavd")
+		if imageErr == nil {
+			rel, err := filepath.Rel(filepath.Dir(canonical), image)
+			writer = writer || (err == nil && rel != ".." && !strings.HasPrefix(rel, "../"))
+		}
+		paths, err := p.OpenFiles()
+		if errors.Is(err, os.ErrProcessDone) {
+			continue
+		}
+		if err != nil {
+			if writer {
+				return nil, err
+			}
+			continue
+		}
+		for _, path := range paths {
+			if filepath.Dir(path) == canonical && isManagedLog(filepath.Base(path)) {
+				active[filepath.Clean(filepath.Join(dir, filepath.Base(path)))] = true
+			}
+		}
+	}
+	return active, nil
+}
+
+func platformFileInUse(path string) (busy, vanished bool) {
+	if _, err := os.Lstat(path); errors.Is(err, os.ErrNotExist) {
+		return false, true
+	}
+	active, err := activeManagedLogs(filepath.Dir(path))
+	return err != nil || active[filepath.Clean(path)], false
+}

+		t.Run(map[bool]string{false: "complete", true: "restore"}[corrupt], func(t *testing.T) {
+			u, r := nativeUpdater(t, p)
+			if _, err := u.Prepare(context.Background()); err != nil {
+				t.Fatal(err)
+			}
+			st, err := u.readNativeState()
+			if err != nil {
+				t.Fatal(err)
+			}
+			st.Phase = phaseSwapping
+			st.From = "v0.36.0"
+			for _, p := range m.Units {
+				st.Units = append(st.Units, nativeUnit{Path: p, HadOld: lexists(u.l.at(p)), Step: "pending"})
+			}
+			if err := u.writeNativeState(st); err != nil {
+				t.Fatal(err)
+			}
+			// Cut immediately after rename, before recording old_moved.
+			old := u.nativeBackup(st.Units[0].Path)
+			os.MkdirAll(filepath.Dir(old), 0755)
+			if err := os.Rename(u.l.at(st.Units[0].Path), old); err != nil {
+				t.Fatal(err)
+			}
+			if corrupt {
+				os.Remove(filepath.Join(u.nativePayload(), "sdk/emulator/source.properties"))
+			}
+			if out, err := u.Recover(context.Background()); err != nil || out.Recovered == "" {
+				t.Fatalf("recover: %+v %v", out, err)
+			}
+			assertProtected(t, r)
+			if corrupt {
+				assertPackage(t, r, 36, nil)
+			} else if err := verifyDarwinPackage(r.Dir, m, Version{0, 37, 0}); err != nil {
+				t.Fatal(err)
+			}
+			if phaseOf(u.l.readState()) != phaseIdle {
+				t.Fatal("recovery not idle")
+			}
+		})
+	}
+}

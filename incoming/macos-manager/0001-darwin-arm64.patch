diff --git a/internal/avd/darwin_test.go b/internal/avd/darwin_test.go
new file mode 100644
index 0000000..4ef2c5a
--- /dev/null
+++ b/internal/avd/darwin_test.go
@@ -0,0 +1,43 @@
+//go:build darwin
+
+package avd
+
+import (
+	"modavd/internal/errs"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestDarwinARM64Lifecycle(t *testing.T) {
+	r := newRoot(t)
+	inst, err := Create(r, 3, CreateOptions{MemoryMB: 4096, CPU: 4, DataPartitionGB: 64, FPS: 60})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for key, want := range map[string]string{"abi.type": "arm64-v8a", "hw.cpu.arch": "arm64", "image.sysdir.1": "system-images/android-34/google_apis/arm64-v8a/"} {
+		if got := inst.Config.Value(key); got != want {
+			t.Errorf("%s=%q want %q", key, got, want)
+		}
+	}
+	ini, err := ReadIni(IniPath(r, 3))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ini.Value("path") != Dir(r, 3) || ini.Value("path.rel") != filepath.Join("avd", "mas_3.avd") {
+		t.Fatal("invalid Darwin AVD paths")
+	}
+	if strings.Contains(string(readFile(t, ConfigPath(r, 3))), "windows-x86_64") {
+		t.Fatal("Windows profile leaked")
+	}
+	if _, err := Create(r, 5, CreateOptions{}); errs.CodeOf(err) != errs.InvalidArgument {
+		t.Fatalf("reserved port accepted: %v", err)
+	}
+	if err := Delete(r, 3); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(Dir(r, 3)); !os.IsNotExist(err) {
+		t.Fatalf("instance directory left: %v", err)
+	}
+}

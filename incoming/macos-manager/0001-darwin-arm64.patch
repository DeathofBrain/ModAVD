diff --git a/internal/update/space.go b/internal/update/space.go
new file mode 100644
index 0000000..f74d1c7
--- /dev/null
+++ b/internal/update/space.go
@@ -0,0 +1,58 @@
+//go:build windows || darwin
+
+package update
+
+import "io"
+
+const spaceCheckBytes = 1 << 20
+
+// spaceCheckedWriter checks before each MiB, even when an io.WriterTo source
+// supplies a single large Write. A fresh writer also checks each file entry.
+// Only Darwin layouts supply a check; Windows retains its original I/O path.
+type spaceCheckedWriter struct {
+	out       io.Writer
+	check     func() error
+	remaining int
+}
+
+func (w *spaceCheckedWriter) Write(p []byte) (int, error) {
+	total := 0
+	for len(p) > 0 {
+		if w.remaining == 0 {
+			if err := w.check(); err != nil {
+				return total, err
+			}
+			w.remaining = spaceCheckBytes
+		}
+		chunk := min(len(p), w.remaining)
+		n, err := w.out.Write(p[:chunk])
+		total += n
+		w.remaining -= n
+		p = p[n:]
+		if err != nil {
+			return total, err
+		}
+		if n != chunk {
+			return total, io.ErrShortWrite
+		}
+	}
+	return total, nil
+}
+
+func copyWithSpace(out io.Writer, in io.Reader, check func() error) (int64, error) {
+	if check == nil {
+		return io.Copy(out, in)
+	}
+	n, err := io.Copy(&spaceCheckedWriter{out: out, check: check}, in)
+	if err == nil {
+		err = check() // include the last partial MiB, before declaring the entry complete
+	}
+	return n, err
+}
+
+func (l layout) checkSpace() error {
+	if l.spaceCheck != nil {
+		return l.spaceCheck()
+	}
+	return nil
+}

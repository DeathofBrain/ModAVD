+#if defined(__APPLE__) && defined(__aarch64__) && defined(TARGET_AARCH64)
+static int appleArmMaxGuestCores(int hostCores) {
+    // Apple's cores have no SMT siblings to reserve. The current virt machine
+    // uses GICv2 (GIC_NCPU == 8); advertising more CPUs makes it fail to boot.
+    int maxCores = std::max(1, std::min(hostCores, 8));
+    uint32_t hvfMaxCores = 0;
+    if (hv_vm_get_max_vcpu_count(&hvfMaxCores) == HV_SUCCESS &&
+        hvfMaxCores > 0 && hvfMaxCores < static_cast<uint32_t>(maxCores)) {
+        maxCores = static_cast<int>(hvfMaxCores);
+    }
+    return maxCores;
+}
+#endif

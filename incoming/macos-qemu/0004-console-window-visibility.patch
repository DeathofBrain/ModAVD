+TEST(Console, WindowCommandsRejectUnavailableUI) {
+    const char expected[] = "KO: Qt window is not ready or has closed\r\n";
+    for (const char* command : {"window show", "window hide"}) {
+        int sock[2];
+        ASSERT_EQ(0, socketCreatePair(&sock[0], &sock[1]));
+        void* client = test_control_client_create(sock[1]);
+        ASSERT_NE(nullptr, client);
+        send_test_string(client, command);
+        char response[sizeof(expected)] = {};
+        socketRecvAll(sock[0], response, sizeof(expected) - 1);
+        EXPECT_STREQ(expected, response);
+        test_control_client_close(client);
+        socketClose(sock[1]);
+        socketClose(sock[0]);
+    }
+}

+int skin_winsys_set_window_visible(bool visible) {
+    auto window = EmulatorQtWindow::getInstancePtr();
+    if (!window) {
+        return -1;
+    }
+    if (onMainQtThread()) {
+        return window->setHostWindowVisible(visible) ? 0 : -1;
+    }
+    bool changed = false;
+    QSemaphore semaphore;
+    window->runOnUiThread([window, visible, &changed]() {
+        changed = window->setHostWindowVisible(visible);
+    }, &semaphore);
+    semaphore.acquire();
+    return changed ? 0 : -1;
+}

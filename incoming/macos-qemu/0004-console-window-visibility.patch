+            display.second->show();
+        }
+        mContainer.raise();
+        mContainer.activateWindow();
+    } else {
+        mToolWindow->hideExtendedWindow();
+        mToolWindow->hide();
+        mOverlay.hide();
+        QFrame::hide();
+        mContainer.hide();
+        if (mCarClusterWindow) {
+            mCarClusterWindow->hide();
+        }
+        for (auto& display : mMultiDisplayWindow) {
+            display.second->hide();
+        }
+    }
+    return true;
+}

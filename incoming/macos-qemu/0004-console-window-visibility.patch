+bool EmulatorQtWindow::setHostWindowVisible(bool visible) {
+    if (mClosed || (visible && (!mBackingSurface || !mHostWindowRect.isValid()))) {
+        return false;
+    }
+    mHostVisibilityOverridden = true;
+    mHostWindowHidden = !visible;

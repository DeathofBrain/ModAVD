+static int do_window_visibility(ControlClient client, char* args, bool visible) {
+    if (args && *args) {
+        control_write(client, "KO: window show|hide takes no arguments\r\n");
+        return -1;
+    }
+    if (getConsoleAgents()->settings->host_emulator_is_headless()) {
+        control_write(client, "KO: window visibility is unsupported in headless mode\r\n");
+        return -1;
+    }
+    if (skin_winsys_set_window_visible(visible) != 0) {
+        control_write(client, "KO: Qt window is not ready or has closed\r\n");
+        return -1;
+    }
+    control_write(client, "windows=1\r\n");
+    return 0;
+}
+
+static int do_window_show(ControlClient client, char* args) {
+    return do_window_visibility(client, args, true);
+}
+
+static int do_window_hide(ControlClient client, char* args) {
+    return do_window_visibility(client, args, false);
+}
+
+static const CommandDefRec window_commands[] = {
+        {"show", "show this instance's Qt window",

+#elif defined(__APPLE__)
+// Query the destination volume rather than assuming all Mac paths are APFS:
+// removable volumes without sparse files still need the full raw image size.
+static bool volumeSupportsSparseFiles(const std::string& dir) {
+    struct attrlist attributes = {};
+    attributes.bitmapcount = ATTR_BIT_MAP_COUNT;
+    attributes.volattr = ATTR_VOL_CAPABILITIES;
+    struct {
+        uint32_t length;
+        vol_capabilities_attr_t volume;
+    } result = {};
+    if (getattrlist(dir.c_str(), &attributes, &result, sizeof(result), 0) != 0) {
+        return false;
+    }
+    const auto format = VOL_CAPABILITIES_FORMAT;
+    return (result.volume.valid[format] & VOL_CAP_FMT_SPARSE_FILES) &&
+           (result.volume.capabilities[format] & VOL_CAP_FMT_SPARSE_FILES);
+}
 #endif
 

// QA shims surrounding exact source functions. Not a renderer implementation.
#include "modavd-asg-external-ownership.h"
#include "sysemu/dma-sized.h"
#include <algorithm>
#include <atomic>
#include <cassert>
#include <cerrno>
#include <cstdint>
#include <cstdlib>
#include <functional>
#include <iostream>

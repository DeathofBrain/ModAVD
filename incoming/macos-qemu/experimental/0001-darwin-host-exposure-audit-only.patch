diff --git a/include/exec/ram-reclaim-audit-model.h b/include/exec/ram-reclaim-audit-model.h
new file mode 100644
index 00000000..a2be3098
--- /dev/null
+++ b/include/exec/ram-reclaim-audit-model.h
@@ -0,0 +1,210 @@
+/* Experimental metadata only. No host memory replacement or discard API. */
+#ifndef RAM_RECLAIM_AUDIT_MODEL_H
+#define RAM_RECLAIM_AUDIT_MODEL_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef enum RraBacking {
+    RRA_UNKNOWN, RRA_PRIVATE, RRA_SHARED, RRA_FILE, RRA_EXTERNAL,
+    RRA_RESIZABLE, RRA_CUSTOM,
+} RraBacking;
+
+typedef struct RraCause {
+    const char *name; /* Caller supplies a static string. */
+    uint64_t calls, bytes, invalid;
+} RraCause;
+
+/* All access, including reads, requires the caller's registry mutex. */
+typedef struct RraState {
+    uint64_t size, page_size, pages, generation;
+    uint64_t tainted_pages, exposures, exposure_bytes;
+    uint64_t reports, report_bytes, candidate_bytes, reports_skipped;
+    uint64_t report_maps, report_map_bytes;
+    uint64_t reservation_id, next_id, reserved_start, reserved_length;
+    uint8_t *bits;
+    RraBacking backing;
+    const char *whole_reason;
+    RraCause causes[16];
+    unsigned causes_used;
+} RraState;
+
+typedef struct RraReservation {
+    uint64_t id, generation, start, length;
+} RraReservation;
+
+static inline uint64_t rra_add(uint64_t a, uint64_t b)
+{
+    return b > UINT64_MAX - a ? UINT64_MAX : a + b;
+}
+
+static inline bool rra_range(const RraState *s, uint64_t start, uint64_t length)
+{
+    return length && start < s->size && length <= s->size - start;
+}
+
+static inline bool rra_init(RraState *s, uint64_t size, uint64_t page_size,
+                            RraBacking backing)
+{
+    uint64_t bytes;
+    memset(s, 0, sizeof(*s));
+    s->size = size;
+    s->page_size = page_size;
+    s->generation = s->next_id = 1;
+    s->backing = backing;
+    if (!size || !page_size || (page_size & (page_size - 1))) {
+        s->whole_reason = "invalid-metadata";
+        return false;
+    }
+    s->pages = size / page_size + (size % page_size != 0);
+    bytes = s->pages / 8 + (s->pages % 8 != 0);
+    if (bytes > SIZE_MAX || !(s->bits = calloc((size_t)bytes, 1))) {
+        s->whole_reason = "bitmap-allocation-failed";
+        s->tainted_pages = s->pages;
+        return false;
+    }
+    return true;
+}
+
+static inline bool rra_taint_all(RraState *s, const char *reason)
+{
+    if (s->reservation_id) {
+        return false;
+    }
+    if (!s->whole_reason) {
+        s->whole_reason = reason;
+    }
+    s->tainted_pages = s->pages;
+    return true;
+}
+
+/* Unknown or overflowing extents exclude the whole block. A future mutating
+ * backend would wait/retry before returning any pointer on false. */
+static inline bool rra_expose(RraState *s, uint64_t start, uint64_t length,
+                              const char *reason)
+{
+    uint64_t first, last, page;
+    unsigned cause;
+    bool valid = rra_range(s, start, length);
+    if (s->reservation_id && (!valid ||
+        (start < s->reserved_start + s->reserved_length &&
+         s->reserved_start < start + length))) {
+        return false;
+    }
+    s->exposures = rra_add(s->exposures, 1);
+    s->exposure_bytes = rra_add(s->exposure_bytes, length);
+    for (cause = 0; cause < s->causes_used; cause++) {
+        if (!strcmp(s->causes[cause].name, reason)) {
+            break;
+        }
+    }
+    if (cause == s->causes_used) {
+        if (cause == sizeof(s->causes) / sizeof(s->causes[0])) {
+            return rra_taint_all(s, "unclassified-ingress");
+        }
+        s->causes[cause].name = reason;
+        s->causes_used++;
+    }
+    s->causes[cause].calls = rra_add(s->causes[cause].calls, 1);
+    s->causes[cause].bytes = rra_add(s->causes[cause].bytes, length);
+    s->causes[cause].invalid = rra_add(s->causes[cause].invalid, !valid);
+    if (!valid) {
+        return rra_taint_all(s, reason);
+    }
+    if (s->whole_reason) {
+        return true;
+    }
+    first = start / s->page_size;
+    last = (start + length - 1) / s->page_size;
+    for (page = first; page <= last; page++) {
+        uint8_t mask = (uint8_t)(1u << (page % 8));
+        if (!(s->bits[page / 8] & mask)) {
+            s->bits[page / 8] |= mask;
+            s->tainted_pages++;
+        }
+    }
+    return true;
+}
+
+/* Only balloon report data receives this exemption; ring/descriptor reads
+ * remain normal exposures. This does not assert that other users are absent. */
+static inline bool rra_map(RraState *s, uint64_t start, uint64_t length,
+                           bool report_owner, const char *reason)
+{
+    if (!report_owner) {
+        return rra_expose(s, start, length, reason);
+    }
+    s->report_maps = rra_add(s->report_maps, 1);
+    s->report_map_bytes = rra_add(s->report_map_bytes, length);
+    return rra_range(s, start, length) ||
+           rra_taint_all(s, "invalid-report-map");
+}
+
+static inline uint64_t rra_candidates(const RraState *s, uint64_t start,
+                                       uint64_t length)
+{
+    uint64_t page, end, count = 0;
+    if (s->backing != RRA_PRIVATE || s->whole_reason ||
+        !rra_range(s, start, length) ||
+        ((start | length) & (s->page_size - 1))) {
+        return 0;
+    }
+    page = start / s->page_size;
+    end = (start + length) / s->page_size;
+    for (; page < end; page++) {
+        count += !(s->bits[page / 8] & (1u << (page % 8)));
+    }
+    return count * s->page_size;
+}
+
+/* Deliberately not called by QEMU. Tests exercise the reservation contract;
+ * this prototype has no executable reclaim/remap entry point. */
+static inline bool rra_reserve(RraState *s, uint64_t start, uint64_t length,
+                               uint64_t generation, RraReservation *r)
+{
+    if (s->reservation_id || generation != s->generation ||
+        !s->next_id || s->next_id == UINT64_MAX ||
+        rra_candidates(s, start, length) != length || !length) {
+        return false;
+    }
+    r->id = s->reservation_id = s->next_id++;
+    r->generation = s->generation;
+    r->start = s->reserved_start = start;
+    r->length = s->reserved_length = length;
+    return true;
+}
+
+static inline bool rra_reservation_valid(const RraState *s,
+                                         const RraReservation *r)
+{
+    return r->id && r->id == s->reservation_id &&
+           r->generation == s->generation &&
+           r->start == s->reserved_start && r->length == s->reserved_length &&
+           s->backing == RRA_PRIVATE && !s->whole_reason;
+}
+
+static inline void rra_release(RraState *s, const RraReservation *r)
+{
+    if (rra_reservation_valid(s, r)) {
+        s->reservation_id = 0;
+    }
+}
+
+static inline void rra_invalidate(RraState *s, const char *reason)
+{
+    s->generation = rra_add(s->generation, 1);
+    s->reservation_id = 0;
+    s->backing = RRA_UNKNOWN;
+    s->whole_reason = reason;
+    s->tainted_pages = s->pages;
+}
+
+static inline void rra_destroy(RraState *s)
+{
+    free(s->bits);
+    s->bits = NULL;
+}
+#endif

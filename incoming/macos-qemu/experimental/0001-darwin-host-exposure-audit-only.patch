+/* Audit only: no reservation or replacement operation is exposed to QEMU. */
+static QemuMutex ram_audit_lock;
+static gsize ram_audit_once;
+static bool ram_audit_enabled;
+static const char *ram_audit_inhibited;
+
+static bool ram_audit_active(void)
+{
+    if (g_once_init_enter(&ram_audit_once)) {
+#if defined(__APPLE__) && defined(__aarch64__)
+        const char *value = getenv("MODAVD_HVF_RAM_AUDIT");
+#endif
+        qemu_mutex_init(&ram_audit_lock);
+#if defined(__APPLE__) && defined(__aarch64__)
+        ram_audit_enabled = value && !strcmp(value, "1");
+#endif
+        g_once_init_leave(&ram_audit_once, 1);
+    }
+    return ram_audit_enabled;
+}
+
+bool qemu_ram_audit_is_enabled(void)
+{
+    return ram_audit_active();
+}
+
+static void ram_audit_log_locked(RAMBlock *rb, const char *event,
+                                 uint64_t offset, uint64_t length,
+                                 uint64_t candidates)
+{
+    RraState *s = rb->reclaim_audit;
+    info_report("hvf-ram-audit: event=%s block=%s kind=%d generation=%" PRIu64
+                " size=%" PRIu64 " host_page=%" PRIu64
+                " exposed_pages=%" PRIu64 "/%" PRIu64
+                " whole_reason=%s exposures=%" PRIu64
+                " exposure_bytes_total=%" PRIu64 " report_maps=%" PRIu64
+                " report_map_bytes_total=%" PRIu64 " reports_skipped=%" PRIu64
+                " report_sg_total=%" PRIu64 " report_bytes_total=%" PRIu64
+                " candidate_bytes_total=%" PRIu64
+                " range=%" PRIu64 "+%" PRIu64 " range_upper_bound=%" PRIu64
+                " ingress_complete=0 permissions_complete=0 coverage_tainted=1"
+                " strict_eligible_bytes=0 reclaim_enabled=0",
+                event, memory_region_name(rb->mr), (int)s->backing,
+                s->generation, s->size, s->page_size, s->tainted_pages, s->pages,
+                s->whole_reason ? s->whole_reason : "none", s->exposures,
+                s->exposure_bytes, s->report_maps, s->report_map_bytes,
+                s->reports_skipped,
+                s->reports, s->report_bytes, s->candidate_bytes,
+                offset, length, candidates);
+}
+
+static void ram_audit_causes_locked(RAMBlock *rb)
+{
+    RraState *s = rb->reclaim_audit;
+    unsigned i;
+    for (i = 0; i < s->causes_used; i++) {
+        RraCause *c = &s->causes[i];
+        info_report("hvf-ram-audit: event=cause block=%s cause=%s"
+                    " calls=%" PRIu64 " bytes=%" PRIu64 " invalid=%" PRIu64,
+                    memory_region_name(rb->mr), c->name,
+                    c->calls, c->bytes, c->invalid);
+    }
+}
+
+static void ram_audit_note(RAMBlock *rb, uint64_t offset, uint64_t length,
+                           const char *reason)
+{
+    RraState *s = rb->reclaim_audit;
+    bool whole_before, noted;
+    unsigned causes_before;
+    if (!s) {
+        return;
+    }
+    qemu_mutex_lock(&ram_audit_lock);
+    whole_before = s->whole_reason != NULL;
+    causes_before = s->causes_used;
+    /* No QEMU caller can reserve in this audit-only prototype. */
+    noted = rra_map(s, offset, length, false, reason);
+    assert(noted);
+    if ((!whole_before && s->whole_reason) || s->exposures <= 8 ||
+        causes_before != s->causes_used) {
+        ram_audit_log_locked(rb, reason, offset, length, 0);
+    }
+    qemu_mutex_unlock(&ram_audit_lock);
+}
+
+static void ram_audit_report_map(RAMBlock *rb, uint64_t offset, uint64_t length)
+{
+    RraState *s = rb->reclaim_audit;
+    bool noted;
+    if (!s) {
+        return;
+    }
+    qemu_mutex_lock(&ram_audit_lock);
+    noted = rra_map(s, offset, length, true, "report-owner");
+    assert(noted);
+    qemu_mutex_unlock(&ram_audit_lock);
+}
+
+static void ram_audit_invalidate(RAMBlock *rb, const char *reason)
+{
+    if (rb->reclaim_audit) {
+        qemu_mutex_lock(&ram_audit_lock);
+        rra_invalidate(rb->reclaim_audit, reason);
+        ram_audit_log_locked(rb, reason, 0, 0, 0);
+        qemu_mutex_unlock(&ram_audit_lock);
+    }
+}
+
+void qemu_ram_audit_inhibit(const char *reason)
+{
+    RAMBlock *rb;
+    if (!ram_audit_active()) {
+        return;
+    }
+    rcu_read_lock();
+    qemu_mutex_lock(&ram_audit_lock);
+    ram_audit_inhibited = reason;
+    RAMBLOCK_FOREACH(rb) {
+        if (rb->reclaim_audit) {
+            rra_taint_all(rb->reclaim_audit, reason);
+            ram_audit_log_locked(rb, reason, 0, 0, 0);
+        }
+    }
+    qemu_mutex_unlock(&ram_audit_lock);
+    rcu_read_unlock();
+}
+
+void qemu_ram_audit_host_pointer(void *host, uint64_t length, const char *reason)
+{
+    RAMBlock *rb;
+    uintptr_t address = (uintptr_t)host;
+    if (!host || !ram_audit_active()) {
+        return;
+    }
+    if (length > UINTPTR_MAX - address) {
+        qemu_ram_audit_inhibit("overflowing-host-pointer");
+        return;
+    }
+    rcu_read_lock();
+    RAMBLOCK_FOREACH(rb) {
+        uintptr_t base = (uintptr_t)rb->host;
+        uint64_t offset;
+        if (!base || rb->max_length > UINTPTR_MAX - base) {
+            continue;
+        }
+        if (!length) {
+            if (address >= base && address - base < rb->max_length) {
+                ram_audit_note(rb, 0, 0, reason);
+            }
+        } else if (address < base + rb->max_length && base < address + length) {
+            uintptr_t first = MAX(address, base);
+            uintptr_t last = MIN(address + length, base + rb->max_length);
+            offset = first - base;
+            ram_audit_note(rb, offset, last - first, reason);
+        }
+    }
+    rcu_read_unlock();
+}
+
+void qemu_ram_audit_report(RAMBlock *rb, uint64_t offset, uint64_t length,
+                           const char *skip_reason)
+{
+    RraState *s = rb->reclaim_audit;
+    uint64_t candidates;
+    if (!s) {
+        return;
+    }
+    qemu_mutex_lock(&ram_audit_lock);
+    if (!skip_reason && !rra_range(s, offset, length)) {
+        skip_reason = "report-invalid-range";
+    }
+    if (!skip_reason && ((offset | length) & (s->page_size - 1))) {
+        skip_reason = "report-host-page-unaligned";
+    }
+    candidates = skip_reason ? 0 : rra_candidates(s, offset, length);
+    s->reports = rra_add(s->reports, 1);
+    s->report_bytes = rra_add(s->report_bytes, length);
+    s->candidate_bytes = rra_add(s->candidate_bytes, candidates);
+    s->reports_skipped = rra_add(s->reports_skipped, skip_reason != NULL);
+    if (s->reports == 1 || !(s->reports % 64)) {
+        ram_audit_log_locked(rb, skip_reason ? skip_reason : "report",
+                             offset, length, candidates);
+        ram_audit_causes_locked(rb);
+    }
+    qemu_mutex_unlock(&ram_audit_lock);
+}
+
+void qemu_ram_audit_untracked_report(uint64_t length)
+{
+    static uint64_t reports, bytes;
+    if (!ram_audit_active()) {
+        return;
+    }
+    qemu_mutex_lock(&ram_audit_lock);
+    reports = rra_add(reports, 1);
+    bytes = rra_add(bytes, length);
+    info_report("hvf-ram-audit: event=report-untracked report_sg_total=%" PRIu64
+                " report_bytes_total=%" PRIu64 " strict_eligible_bytes=0"
+                " reclaim_enabled=0", reports, bytes);
+    qemu_mutex_unlock(&ram_audit_lock);
+}

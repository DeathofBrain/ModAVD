+static void ram_audit_allocate(RAMBlock *rb, bool shared)
+{
+    RraBacking kind;
+    if (!ram_audit_active()) {
+        return;
+    }
+    if (rb->fd >= 0 || (rb->flags & RAM_MAPPED)) {
+        kind = RRA_FILE;
+    } else if (rb->flags & (RAM_PREALLOC | RAM_USER_BACKED)) {
+        kind = RRA_EXTERNAL;
+    } else if (rb->flags & RAM_RESIZEABLE) {
+        kind = RRA_RESIZABLE;
+    } else if (phys_mem_alloc != qemu_anon_ram_alloc) {
+        kind = RRA_CUSTOM;
+    } else {
+        kind = shared ? RRA_SHARED : RRA_PRIVATE;
+    }
+    rb->reclaim_audit = g_new0(RraState, 1);
+    qemu_mutex_lock(&ram_audit_lock);
+    rra_init(rb->reclaim_audit, rb->max_length, rb->page_size, kind);
+    if (ram_audit_inhibited || rb->mr->readonly) {
+        rra_taint_all(rb->reclaim_audit,
+                      ram_audit_inhibited ? ram_audit_inhibited : "readonly");
+    }
+    ram_audit_log_locked(rb, "allocate", 0, 0, 0);
+    qemu_mutex_unlock(&ram_audit_lock);
+}
+
+static void ram_audit_published(RAMBlock *rb)
+{
+    if (!rb->reclaim_audit) {
+        return;
+    }
+    /* Close the gap between initialization and RCU list publication: an
+     * inhibit that did not see this block must still apply to it. */
+    qemu_mutex_lock(&ram_audit_lock);
+    if (ram_audit_inhibited) {
+        rra_taint_all(rb->reclaim_audit, ram_audit_inhibited);
+        ram_audit_log_locked(rb, "inhibit-at-publication", 0, 0, 0);
+    }
+    qemu_mutex_unlock(&ram_audit_lock);
+}

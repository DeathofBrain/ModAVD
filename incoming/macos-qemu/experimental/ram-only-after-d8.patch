diff --git a/include/qemu/darwin-chunked-ram.h b/include/qemu/darwin-chunked-ram.h
new file mode 100644
--- /dev/null
+++ b/include/qemu/darwin-chunked-ram.h
@@ -0,0 +1,187 @@
+/* Private Darwin RAM backing primitive; no QEMU types or authorization.
+ * A successful initial construction preserves the caller's virtual range and
+ * gives each <=2 MiB extent its own anonymous VM object without touching data.
+ * The caller must reject shared/file/user backing and publish provenance only
+ * after complete success. A failed construction must never be published or
+ * silently used as a monolithic fallback. */
+#ifndef MODAVD_DARWIN_CHUNKED_RAM_H
+#define MODAVD_DARWIN_CHUNKED_RAM_H
+#if defined(__APPLE__) && defined(__aarch64__)
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#define DCR_CHUNK_SIZE ((size_t)2 * 1024 * 1024)
+
+typedef struct DcrMapping {
+    void *base;
+    void *reservation;
+    size_t length;
+    size_t reserved_length;
+} DcrMapping;
+
+typedef struct DcrAttributes {
+    vm_prot_t current, maximum;
+    vm_inherit_t inheritance;
+} DcrAttributes;
+
+static inline bool dcr_attributes(void *address, size_t length,
+                                   DcrAttributes *attributes)
+{
+    mach_vm_address_t region = (mach_vm_address_t)address;
+    mach_vm_size_t region_size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    kern_return_t result = mach_vm_region(mach_task_self(), &region, &region_size,
+        VM_REGION_BASIC_INFO_64, (vm_region_info_t)&info, &count, &object);
+    if (object != MACH_PORT_NULL) {
+        mach_port_deallocate(mach_task_self(), object);
+    }
+    uintptr_t target = (uintptr_t)address;
+    if (result != KERN_SUCCESS || region > target ||
+        target - region >= region_size ||
+        length > region_size - (target - region)) {
+        return false;
+    }
+    attributes->current = info.protection;
+    attributes->maximum = info.max_protection;
+    attributes->inheritance = info.inheritance;
+    return true;
+}
+
+/* On false, mapping may still own a reservation. Always call dcr_release().
+ * Guard pages prevent adjacent anonymous RW mmap entries from coalescing
+ * before Mach remap has materialized the independent backing VM object. */
+static inline bool dcr_allocate_fresh(size_t length, DcrMapping *mapping)
+{
+    size_t page = getpagesize();
+    memset(mapping, 0, sizeof(*mapping));
+    if (!page || (page & (page - 1)) || !length || length > DCR_CHUNK_SIZE ||
+        (length & (page - 1)) || page > (SIZE_MAX - length) / 2) {
+        return false;
+    }
+    size_t reserved_length = length + 2 * page;
+    void *reservation = mmap(NULL, reserved_length, PROT_NONE,
+                             MAP_ANON | MAP_PRIVATE, -1, 0);
+    if (reservation == MAP_FAILED) {
+        return false;
+    }
+    mapping->reservation = reservation;
+    mapping->reserved_length = reserved_length;
+    mapping->length = length;
+    void *base = (char *)reservation + page;
+    if (mmap(base, length, PROT_READ | PROT_WRITE,
+             MAP_FIXED | MAP_ANON | MAP_PRIVATE, -1, 0) == MAP_FAILED) {
+        return false;
+    }
+    mapping->base = base;
+    return true;
+}
+
+/* Retain the handle when cleanup fails so ownership is never lost. */
+static inline bool dcr_release(DcrMapping *mapping)
+{
+    if (mapping->reservation &&
+        munmap(mapping->reservation, mapping->reserved_length) != 0) {
+        return false;
+    }
+    memset(mapping, 0, sizeof(*mapping));
+    return true;
+}
+
+static inline bool dcr_apply_attributes(void *address, size_t length,
+                                         const DcrAttributes *expected)
+{
+    DcrAttributes actual;
+    if (!dcr_attributes(address, length, &actual)) {
+        return false;
+    }
+    /* Do not reapply an unchanged RWX maximum: W^X policy can reject it. */
+    if (actual.maximum != expected->maximum &&
+        mach_vm_protect(mach_task_self(), (uintptr_t)address, length, true,
+                        expected->maximum) != KERN_SUCCESS) {
+        return false;
+    }
+    if (actual.current != expected->current &&
+        mach_vm_protect(mach_task_self(), (uintptr_t)address, length, false,
+                        expected->current) != KERN_SUCCESS) {
+        return false;
+    }
+    return mach_vm_inherit(mach_task_self(), (uintptr_t)address, length,
+                           expected->inheritance) == KERN_SUCCESS;
+}
+
+/* Success leaves retained empty. Failure leaves the target partially rebuilt;
+ * caller must destroy its complete original reservation. If temporary cleanup
+ * fails, retained owns that additional reservation and can be retried. */
+static inline bool dcr_map_initial(void *target, size_t length,
+                                     DcrMapping *retained)
+{
+    size_t page = getpagesize();
+    memset(retained, 0, sizeof(*retained));
+    if (!page || (page & (page - 1)) || !target || !length ||
+        length > UINTPTR_MAX - (uintptr_t)target ||
+        (((uintptr_t)target | length) & (page - 1))) {
+        return false;
+    }
+    /* Darwin can split a single large mmap at 128 MiB. Validate each planned
+     * backing extent instead of requiring one region for the complete block. */
+    for (size_t offset = 0; offset < length;) {
+        size_t chunk = length - offset;
+        DcrAttributes original;
+        if (chunk > DCR_CHUNK_SIZE) {
+            chunk = DCR_CHUNK_SIZE;
+        }
+        if (!dcr_attributes((char *)target + offset, chunk, &original) ||
+            original.current != (VM_PROT_READ | VM_PROT_WRITE) ||
+            original.inheritance == VM_INHERIT_SHARE) {
+            return false;
+        }
+        offset += chunk;
+    }
+    for (size_t offset = 0; offset < length;) {
+        size_t chunk = length - offset;
+        DcrAttributes original;
+        if (chunk > DCR_CHUNK_SIZE) {
+            chunk = DCR_CHUNK_SIZE;
+        }
+        if (!dcr_attributes((char *)target + offset, chunk, &original)) {
+            return false;
+        }
+        bool success = dcr_allocate_fresh(chunk, retained);
+        if (success) {
+            success = dcr_apply_attributes(retained->base, chunk, &original);
+        }
+        if (success) {
+            mach_vm_address_t destination = (uintptr_t)target + offset;
+            vm_prot_t current, maximum;
+            kern_return_t result = mach_vm_remap(mach_task_self(), &destination,
+                chunk, 0, VM_FLAGS_FIXED | VM_FLAGS_OVERWRITE, mach_task_self(),
+                (uintptr_t)retained->base, false, &current, &maximum,
+                original.inheritance);
+            DcrAttributes actual;
+            success = result == KERN_SUCCESS &&
+                destination == (uintptr_t)target + offset &&
+                current == original.current && maximum == original.maximum &&
+                dcr_attributes((void *)destination, chunk, &actual) &&
+                actual.current == original.current &&
+                actual.maximum == original.maximum &&
+                actual.inheritance == original.inheritance;
+        }
+        if (!dcr_release(retained)) {
+            return false;
+        }
+        if (!success) {
+            return false;
+        }
+        offset += chunk;
+    }
+    return true;
+}
+#endif
+#endif

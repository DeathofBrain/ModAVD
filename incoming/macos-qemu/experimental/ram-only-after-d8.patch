+
+static void virtio_balloon_handle_report(VirtIODevice *vdev, VirtQueue *vq);
+
+static void balloon_report_bh(void *opaque)
+{
+    VirtIOBalloon *s = opaque;
+    VirtIODevice *vdev = VIRTIO_DEVICE(s);
+    /* A conforming Linux guest clears PAGE_POISON when neither init_on_free
+     * nor page poisoning is active. REPORTING remains valid in that case.
+     * Keep poison==0 and the complete negotiated feature snapshot checks. */
+    const uint64_t required = 1ULL << VIRTIO_BALLOON_F_REPORTING;
+    RplSnapshot before = balloon_report_snapshot(s), after;
+    GArray *paused_cpus = g_array_new(false, false, sizeof(BalloonPausedCpu));
+    CPUState *cpu;
+    bool paused = false, valid = false, topology_same = true;
+    unsigned index = 0;
+    assert(qemu_mutex_iothread_locked() && !qemu_in_vcpu_thread());
+    s->report_active = true;
+    if (!rpl_ready(&before, required, VIRTIO_CONFIG_S_DRIVER_OK) ||
+        before.vm_epoch != s->report_scheduled_vm_epoch ||
+        before.queue_epoch != s->report_scheduled_queue_epoch ||
+        before.device_epoch != s->report_scheduled_device_epoch) {
+        goto done;
+    }
+    CPU_FOREACH(cpu) {
+        BalloonPausedCpu entry = {cpu, cpu->stopped, cpu->stop};
+        object_ref(OBJECT(cpu));
+        g_array_append_val(paused_cpus, entry);
+    }
+    /* No exposure registry or HVF lock is held. pause_all_vcpus temporarily
+     * releases BQL, so every value above is untrusted until revalidated. */
+    pause_all_vcpus_for_reclaim();
+    paused = true;
+    after = balloon_report_snapshot(s);
+    CPU_FOREACH(cpu) {
+        if (index >= paused_cpus->len ||
+            g_array_index(paused_cpus, BalloonPausedCpu, index).cpu != cpu ||
+            !cpu->stopped) {
+            topology_same = false;
+        }
+        index++;
+    }
+    topology_same &= index == paused_cpus->len;
+    valid = topology_same && rpl_unchanged(&before, &after, required,
+                                           VIRTIO_CONFIG_S_DRIVER_OK);
+    if (valid) {
+        VirtQueue *current = virtio_get_queue(vdev, s->report_queue_index);
+        /* No operation in this bounded synchronous drain may release BQL. */
+        virtio_balloon_drain_report(vdev, current, 32);
+        s->report_pause_batches++;
+    }
+done:
+    if (!valid) {
+        s->report_pause_canceled++;
+    }
+    if (paused) {
+        /* CPU code retained stop/resume requests issued while BQL was dropped.
+         * A changed epoch cancels the report but does not lose a later start. */
+        resume_vcpus_after_reclaim();
+    }
+    for (unsigned i = 0; i < paused_cpus->len; i++) {
+        object_unref(OBJECT(g_array_index(paused_cpus, BalloonPausedCpu, i).cpu));
+    }
+    g_array_free(paused_cpus, true);
+    if (!valid || s->report_pause_batches == 1 || !(s->report_pause_batches % 32)) {
+        info_report("hvf-ram-pause: batches=%" PRIu64 " canceled=%" PRIu64
+                    " popped_after_pause=%d topology_same=%d",
+                    s->report_pause_batches, s->report_pause_canceled,
+                    valid, topology_same);
+    }
+    s->report_active = false;
+    s->report_pending = false;
+    /* A notify while BQL was released may have described a fresh queue epoch.
+     * Read the current queue only; the old queue pointer was never retained. */
+    if (DEVICE(vdev)->realized && s->report_bh && qemu_vm_reclaim_running() &&
+        (vdev->status & VIRTIO_CONFIG_S_DRIVER_OK) &&
+        s->report_queue_index < virtio_get_num_queues(vdev)) {
+        VirtQueue *current = virtio_get_queue(vdev, s->report_queue_index);
+        if (virtio_queue_ready(current) && !virtio_queue_empty(current)) {
+            virtio_balloon_handle_report(vdev, current);
+        }
+    }
+    object_unref(OBJECT(s));
+}

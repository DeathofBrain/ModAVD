diff --git a/include/exec/darwin-hvf-reclaim-transaction.h b/include/exec/darwin-hvf-reclaim-transaction.h
new file mode 100644
--- /dev/null
+++ b/include/exec/darwin-hvf-reclaim-transaction.h
@@ -0,0 +1,293 @@
+/* Native Darwin transaction component. It does not authorize a RAM range.
+ * Caller must prove private backing, no escaped pointers or aliases, a current
+ * report owner, exact effective HVF flags, and stopped vCPUs before calling.
+ * Caller holds the exposure registry and HVF mapping locks through return.
+ * DHRT_FATAL forbids guest/report completion or resumption: fail-stop. */
+#ifndef MODAVD_DARWIN_HVF_RECLAIM_TRANSACTION_H
+#define MODAVD_DARWIN_HVF_RECLAIM_TRANSACTION_H
+#if defined(__APPLE__) && defined(__aarch64__)
+#include <Hypervisor/Hypervisor.h>
+#include <errno.h>
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/sysctl.h>
+#include <unistd.h>
+#include "qemu/darwin-chunked-ram.h"
+
+typedef enum DhrtResult {
+    DHRT_SKIPPED, DHRT_COMMITTED, DHRT_ROLLED_BACK, DHRT_FATAL,
+} DhrtResult;
+typedef enum DhrtFault {
+    DHRT_NO_FAULT, DHRT_FAIL_UNMAP, DHRT_FAIL_MAP, DHRT_FAIL_REPLACE,
+    /* Native verifier only: exercise the real-error fail-stop branch. */
+    DHRT_FAIL_UNMAP_UNCERTAIN,
+} DhrtFault;
+typedef struct DhrtAttributes {
+    vm_prot_t current, maximum;
+    vm_inherit_t inheritance;
+    bool shared;
+} DhrtAttributes;
+typedef struct DhrtOutcome {
+    DhrtResult result;
+    int stage; /* 1 validation, 2 resources, 3 unmap, 4 replace, 5 map, 6 restore */
+    hv_return_t hv_error;
+    kern_return_t mach_error;
+    hv_return_t restore_hv_error;
+    kern_return_t restore_mach_error;
+    bool cleanup_failed;
+    mach_vm_address_t retained_old_alias, retained_fresh;
+    uint64_t retained_fresh_length;
+    bool observation_enabled;
+    uint64_t old_object_id, old_ref_min, old_ref_max;
+    uint64_t old_present_pages, old_paged_out_pages, old_reusable_pages;
+    uint64_t old_page_query_errors;
+    uint64_t free_pages_before, free_pages_after;
+    uint64_t speculative_pages_before, speculative_pages_after;
+    int physical_query_error;
+} DhrtOutcome;
+
+/* Kernel metadata only. Never read, fault, zero or add a diagnostic alias to
+ * guest data. Direct sysctl counters avoid host_statistics64's sample cache. */
+static inline int dhrt_page_counter(const char *name, uint64_t *value)
+{
+    size_t size = sizeof(*value);
+    *value = 0;
+    if (sysctlbyname(name, value, &size, NULL, 0)) return errno;
+    return (size == sizeof(uint32_t) || size == sizeof(uint64_t)) ? 0 : EINVAL;
+}
+
+static inline void dhrt_observe_old(mach_vm_address_t alias, uint64_t length,
+                                     DhrtOutcome *outcome)
+{
+    uint64_t page = getpagesize();
+    outcome->old_ref_min = UINT64_MAX;
+    for (uint64_t offset = 0; offset < length; offset += page) {
+        vm_page_info_basic_data_t info;
+        mach_msg_type_number_t count = VM_PAGE_INFO_BASIC_COUNT;
+        kern_return_t error = mach_vm_page_info(mach_task_self(), alias + offset,
+            VM_PAGE_INFO_BASIC, (vm_page_info_t)&info, &count);
+        if (error != KERN_SUCCESS) {
+            outcome->old_page_query_errors++;
+            continue;
+        }
+        if (!offset) outcome->old_object_id = info.object_id;
+        if (info.object_id != outcome->old_object_id || info.offset != offset) {
+            outcome->old_page_query_errors++;
+        }
+        if ((uint64_t)info.ref_count < outcome->old_ref_min) outcome->old_ref_min = info.ref_count;
+        if ((uint64_t)info.ref_count > outcome->old_ref_max) outcome->old_ref_max = info.ref_count;
+        outcome->old_present_pages += !!(info.disposition & VM_PAGE_QUERY_PAGE_PRESENT);
+        outcome->old_paged_out_pages += !!(info.disposition & VM_PAGE_QUERY_PAGE_PAGED_OUT);
+        outcome->old_reusable_pages += !!(info.disposition & VM_PAGE_QUERY_PAGE_REUSABLE);
+    }
+}
+
+static inline bool dhrt_attributes(void *address, uint64_t length,
+                                    DhrtAttributes *attributes)
+{
+    mach_vm_address_t region = (mach_vm_address_t)address;
+    mach_vm_size_t region_size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    kern_return_t result = mach_vm_region(mach_task_self(), &region, &region_size,
+        VM_REGION_BASIC_INFO_64, (vm_region_info_t)&info, &count, &object);
+    if (object != MACH_PORT_NULL) {
+        mach_port_deallocate(mach_task_self(), object);
+    }
+    uint64_t target = (uintptr_t)address;
+    if (result != KERN_SUCCESS || region > target ||
+        target - region >= region_size || length > region_size - (target - region)) {
+        return false;
+    }
+    attributes->current = info.protection;
+    attributes->maximum = info.max_protection;
+    attributes->inheritance = info.inheritance;
+    attributes->shared = info.shared;
+    return true;
+}
+
+static inline bool dhrt_attributes_match(void *address, uint64_t length,
+                                          const DhrtAttributes *expected)
+{
+    DhrtAttributes actual;
+    return dhrt_attributes(address, length, &actual) &&
+           actual.current == expected->current &&
+           actual.maximum == expected->maximum &&
+           actual.inheritance == expected->inheritance;
+}
+
+static inline kern_return_t dhrt_replace_alias(void *target, uint64_t length,
+                                                mach_vm_address_t source,
+                                                const DhrtAttributes *expected)
+{
+    mach_vm_address_t destination = (mach_vm_address_t)target;
+    vm_prot_t current, maximum;
+    kern_return_t result = mach_vm_remap(mach_task_self(), &destination, length,
+        0, VM_FLAGS_FIXED | VM_FLAGS_OVERWRITE, mach_task_self(), source, false,
+        &current, &maximum, expected->inheritance);
+    if (result == KERN_SUCCESS &&
+        (destination != (mach_vm_address_t)target || current != expected->current ||
+         maximum != expected->maximum || !dhrt_attributes_match(target, length, expected))) {
+        result = KERN_PROTECTION_FAILURE;
+    }
+    return result;
+}
+
+static inline DhrtOutcome dhrt_replace_private(void *target, uint64_t gpa,
+                                                uint64_t length,
+                                                hv_memory_flags_t effective_flags,
+                                                DhrtFault fault)
+{
+    DhrtOutcome outcome;
+    DhrtAttributes original;
+    vm_prot_t alias_current, alias_maximum;
+    mach_vm_address_t old_alias = 0;
+    DcrMapping fresh_mapping = {0};
+    void *fresh = MAP_FAILED;
+    uint64_t page = getpagesize();
+    bool attempted_map = false;
+    memset(&outcome, 0, sizeof(outcome));
+    outcome.result = DHRT_SKIPPED;
+    outcome.stage = 1;
+    const char *observe = getenv("MODAVD_HVF_RAM_RECLAIM_RESIDENCY");
+    outcome.observation_enabled = observe && !strcmp(observe, "1");
+    if (!page || (page & (page - 1)) || !target || !length || length > SIZE_MAX ||
+        length != DCR_CHUNK_SIZE ||
+        length > UINT64_MAX - gpa || length > UINTPTR_MAX - (uintptr_t)target ||
+        ((gpa | (uintptr_t)target | length) & (page - 1)) ||
+        (effective_flags & ~(HV_MEMORY_READ | HV_MEMORY_WRITE | HV_MEMORY_EXEC)) ||
+        /* VM_REGION_BASIC_INFO.shared is true for an anonymous allocation
+         * pinned by HVF too. The caller's allocation provenance, registry and
+         * no-alias proof authorize private ownership; this bit cannot. */
+        !dhrt_attributes(target, length, &original) ||
+        original.current != (VM_PROT_READ | VM_PROT_WRITE) ||
+        original.inheritance == VM_INHERIT_SHARE) {
+        return outcome;
+    }
+    outcome.stage = 2;
+    if (!dcr_allocate_fresh(length, &fresh_mapping)) {
+        goto cleanup;
+    }
+    fresh = fresh_mapping.base;
+    DhrtAttributes fresh_attributes;
+    if (!dhrt_attributes(fresh, length, &fresh_attributes)) {
+        goto cleanup;
+    }
+    /* mmap RW commonly has max=RWX. Reapplying that unchanged maximum with
+     * vm_protect may fail W^X policy; only narrow a differing maximum. */
+    if (fresh_attributes.maximum != original.maximum) {
+        outcome.mach_error = mach_vm_protect(mach_task_self(), (uintptr_t)fresh,
+            length, true, original.maximum);
+        if (outcome.mach_error != KERN_SUCCESS) {
+            goto cleanup;
+        }
+    }
+    if (fresh_attributes.current != original.current) {
+        outcome.mach_error = mach_vm_protect(mach_task_self(), (uintptr_t)fresh,
+            length, false, original.current);
+        if (outcome.mach_error != KERN_SUCCESS) {
+            goto cleanup;
+        }
+    }
+    outcome.mach_error = mach_vm_inherit(mach_task_self(), (uintptr_t)fresh,
+        length, original.inheritance);
+    if (outcome.mach_error != KERN_SUCCESS) {
+        goto cleanup;
+    }
+    outcome.mach_error = mach_vm_remap(mach_task_self(), &old_alias, length, 0,
+        VM_FLAGS_ANYWHERE, mach_task_self(), (uintptr_t)target, false,
+        &alias_current, &alias_maximum, VM_INHERIT_NONE);
+    if (outcome.mach_error != KERN_SUCCESS || alias_current != original.current ||
+        alias_maximum != original.maximum) {
+        goto cleanup;
+    }
+    outcome.stage = 3;
+    outcome.hv_error = (fault == DHRT_FAIL_UNMAP ||
+                        fault == DHRT_FAIL_UNMAP_UNCERTAIN) ?
+        hv_vm_unmap(gpa + 1, length) : hv_vm_unmap(gpa, length);
+    if (outcome.hv_error != HV_SUCCESS) {
+        if (fault == DHRT_FAIL_UNMAP) {
+            /* The explicit invalid-alignment probe cannot have reached a
+             * valid mapping. No such atomicity is assumed for real errors. */
+            outcome.result = DHRT_ROLLED_BACK;
+            goto cleanup;
+        }
+        /* A real unmap error has an uncertain postcondition. Retain both VM
+         * objects and fail-stop; never assert that the original map survived. */
+        goto fatal;
+    }
+    outcome.stage = 4;
+    outcome.mach_error = fault == DHRT_FAIL_REPLACE ? KERN_FAILURE :
+        dhrt_replace_alias(target, length, (uintptr_t)fresh, &original);
+    if (outcome.mach_error != KERN_SUCCESS) {
+        goto rollback;
+    }
+    outcome.stage = 5;
+    attempted_map = true;
+    outcome.hv_error = hv_vm_map(target, gpa,
+        fault == DHRT_FAIL_MAP ? length - 1 : length, effective_flags);
+    if (outcome.hv_error != HV_SUCCESS) {
+        goto rollback;
+    }
+    outcome.result = DHRT_COMMITTED;
+    goto cleanup;
+
+rollback:
+    outcome.stage = 6;
+    /* Do not assume an unsuccessful mapping syscall left no partial entry.
+     * Remove the entire attempted extent before restoring its VM object. */
+    if (attempted_map) {
+        outcome.restore_hv_error = hv_vm_unmap(gpa, length);
+        if (outcome.restore_hv_error != HV_SUCCESS) {
+            goto fatal;
+        }
+    }
+    /* Even a failed fixed Mach remap must restore from the retained VM object;
+     * do not assume its failure left the previous HVA mapping intact. */
+    outcome.restore_mach_error = dhrt_replace_alias(target, length, old_alias, &original);
+    if (outcome.restore_mach_error != KERN_SUCCESS) {
+        goto fatal;
+    }
+    outcome.restore_hv_error = hv_vm_map(target, gpa, length, effective_flags);
+    if (outcome.restore_hv_error != HV_SUCCESS) {
+        goto fatal;
+    }
+    outcome.result = DHRT_ROLLED_BACK;
+cleanup:
+    if (!dcr_release(&fresh_mapping)) outcome.cleanup_failed = true;
+    if (old_alias) {
+        if (outcome.observation_enabled) {
+            dhrt_observe_old(old_alias, length, &outcome);
+            int error = dhrt_page_counter("vm.page_free_count", &outcome.free_pages_before);
+            if (error) outcome.physical_query_error = error;
+            error = dhrt_page_counter("vm.page_speculative_count", &outcome.speculative_pages_before);
+            if (error) outcome.physical_query_error = error;
+        }
+        /* Between these direct counters, only destruction of the already
+         * required rollback alias occurs. No allocation or guest access. */
+        if (mach_vm_deallocate(mach_task_self(), old_alias, length) != KERN_SUCCESS) {
+            outcome.cleanup_failed = true;
+        }
+        if (outcome.observation_enabled) {
+            int error = dhrt_page_counter("vm.page_free_count", &outcome.free_pages_after);
+            if (error) outcome.physical_query_error = error;
+            error = dhrt_page_counter("vm.page_speculative_count", &outcome.speculative_pages_after);
+            if (error) outcome.physical_query_error = error;
+        }
+    }
+    return outcome;
+fatal:
+    outcome.result = DHRT_FATAL;
+    outcome.retained_old_alias = old_alias;
+    outcome.retained_fresh = (uintptr_t)fresh_mapping.reservation;
+    outcome.retained_fresh_length = fresh_mapping.reserved_length;
+    return outcome;
+}
+#endif
+#endif
diff --git a/include/exec/hvf-map-registry.h b/include/exec/hvf-map-registry.h
new file mode 100644
--- /dev/null
+++ b/include/exec/hvf-map-registry.h
@@ -0,0 +1,152 @@
+/* Exact successful HVF mapping intervals. Caller holds mem_lock throughout. */
+#ifndef MODAVD_HVF_MAP_REGISTRY_H
+#define MODAVD_HVF_MAP_REGISTRY_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#define HMR_CAPACITY 2048
+typedef struct HmrMap {
+    uint64_t gpa, hva, size, flags;
+} HmrMap;
+typedef struct HmrRegistry {
+    HmrMap maps[HMR_CAPACITY];
+    unsigned count;
+    uint64_t generation;
+    bool complete;
+} HmrRegistry;
+
+static inline bool hmr_range(uint64_t start, uint64_t size)
+{
+    return size && size <= UINT64_MAX - start;
+}
+
+static inline void hmr_init(HmrRegistry *r)
+{
+    memset(r, 0, sizeof(*r));
+    r->generation = 1;
+    r->complete = true;
+}
+
+static inline bool hmr_append(HmrRegistry *r, HmrMap m)
+{
+    if (!m.size) {
+        return true;
+    }
+    if (r->count == HMR_CAPACITY || !hmr_range(m.gpa, m.size) ||
+        !hmr_range(m.hva, m.size)) {
+        return false;
+    }
+    r->maps[r->count++] = m;
+    return true;
+}
+
+/* Called only AFTER a successful kernel mutation. Any lost metadata makes
+ * all subsequent mutation proofs fail closed for the life of the VM. */
+static inline bool hmr_update(HmrRegistry *r, uint64_t start, uint64_t size,
+                               uint64_t hva, uint64_t flags,
+                               bool mapping, bool protect)
+{
+    HmrRegistry next;
+    uint64_t end, covered = 0;
+    unsigned i, j;
+    bool ok = r->complete && hmr_range(start, size) &&
+              (!mapping || hmr_range(hva, size));
+    if (!ok || r->generation == UINT64_MAX) {
+        r->complete = false;
+        return false;
+    }
+    hmr_init(&next);
+    end = start + size;
+    for (i = 0; i < r->count && ok; i++) {
+        HmrMap m = r->maps[i];
+        uint64_t mend = m.gpa + m.size;
+        if (m.gpa >= end || mend <= start) {
+            ok = hmr_append(&next, m);
+            continue;
+        }
+        uint64_t first = m.gpa > start ? m.gpa : start;
+        uint64_t last = mend < end ? mend : end;
+        covered += last - first;
+        ok = hmr_append(&next, (HmrMap){m.gpa, m.hva,
+                        first - m.gpa, m.flags});
+        if (ok && protect) {
+            ok = hmr_append(&next, (HmrMap){first,
+                            m.hva + first - m.gpa, last - first, flags});
+        }
+        if (ok) {
+            ok = hmr_append(&next, (HmrMap){last, m.hva + last - m.gpa,
+                            mend - last, m.flags});
+        }
+    }
+    if (protect && covered != size) {
+        ok = false;
+    }
+    if (ok && mapping) {
+        ok = hmr_append(&next, (HmrMap){start, hva, size, flags});
+    }
+    if (!ok) {
+        r->complete = false;
+        r->generation++;
+        return false;
+    }
+    /* Insertion sort, then merge only intervals with identical permissions
+     * and a contiguous one-to-one HVA/GPA correspondence. */
+    for (i = 1; i < next.count; i++) {
+        HmrMap m = next.maps[i];
+        for (j = i; j && next.maps[j - 1].gpa > m.gpa; j--) {
+            next.maps[j] = next.maps[j - 1];
+        }
+        next.maps[j] = m;
+    }
+    unsigned count = 0;
+    for (i = 0; i < next.count; i++) {
+        HmrMap m = next.maps[i];
+        if (count && next.maps[count - 1].gpa + next.maps[count - 1].size == m.gpa &&
+            next.maps[count - 1].hva + next.maps[count - 1].size == m.hva &&
+            next.maps[count - 1].flags == m.flags) {
+            next.maps[count - 1].size += m.size;
+        } else {
+            next.maps[count++] = m;
+        }
+    }
+    next.count = count;
+    next.generation = r->generation + 1;
+    *r = next;
+    return true;
+}
+
+static inline const HmrMap *hmr_lookup(const HmrRegistry *r, uint64_t gpa,
+                                       uint64_t size)
+{
+    unsigned i;
+    if (!r->complete || !hmr_range(gpa, size)) {
+        return NULL;
+    }
+    for (i = 0; i < r->count; i++) {
+        const HmrMap *m = &r->maps[i];
+        if (gpa >= m->gpa && gpa - m->gpa < m->size &&
+            size <= m->size - (gpa - m->gpa)) {
+            return m;
+        }
+    }
+    return NULL;
+}
+
+static inline bool hmr_no_alias(const HmrRegistry *r, const HmrMap *owner,
+                                 uint64_t hva, uint64_t size)
+{
+    unsigned i;
+    if (!r->complete || !hmr_range(hva, size)) {
+        return false;
+    }
+    for (i = 0; i < r->count; i++) {
+        const HmrMap *m = &r->maps[i];
+        if (m != owner && hva < m->hva + m->size && m->hva < hva + size) {
+            return false;
+        }
+    }
+    return true;
+}
+#endif

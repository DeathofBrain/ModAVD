+                        " old_ref_max=%" PRIu64 " old_present_pages=%" PRIu64
+                        " old_paged_out_pages=%" PRIu64 " old_reusable_pages=%" PRIu64
+                        " old_page_query_errors=%" PRIu64
+                        " free_pages_before=%" PRIu64 " free_pages_after=%" PRIu64

+static uint64_t ram_reclaim_target_resident(void *host, uint64_t length, int *error)
+{
+    char states[1024]; /* bounded 4 MiB transaction, minimum Darwin page 4 KiB */
+    long page = sysconf(_SC_PAGESIZE);
+    uint64_t resident = 0;
+    *error = 0;
+    if (page <= 0 || !length || length > 4 * 1024 * 1024 ||
+        length % page || length / page > sizeof(states)) {
+        *error = EINVAL;
+        return 0;
+    }
+    if (mincore(host, length, states)) {
+        *error = errno;
+        return 0;
+    }
+    for (uint64_t i = 0; i < length / page; i++) {
+        if (states[i] & MINCORE_INCORE) resident += page;
+    }

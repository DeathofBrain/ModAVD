+        s->report_scheduled_vm_epoch = qemu_vm_reclaim_epoch();
+        s->report_scheduled_queue_epoch = vdev->reclaim_epoch;
+        s->report_scheduled_device_epoch = s->report_device_epoch;
+        s->report_pending = true;
+        object_ref(OBJECT(s));
+        qemu_bh_schedule(s->report_bh);

diff --git a/include/exec/report-pause-lifecycle.h b/include/exec/report-pause-lifecycle.h
new file mode 100644
--- /dev/null
+++ b/include/exec/report-pause-lifecycle.h
@@ -0,0 +1,39 @@
+#ifndef MODAVD_REPORT_PAUSE_LIFECYCLE_H
+#define MODAVD_REPORT_PAUSE_LIFECYCLE_H
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct RplSnapshot {
+    uint64_t vm_epoch, queue_epoch, device_epoch, features;
+    uint32_t poison;
+    uint8_t status;
+    bool realized, running, queue_ready;
+} RplSnapshot;
+
+static inline bool rpl_ready(const RplSnapshot *s, uint64_t required_features,
+                              uint8_t driver_ok)
+{
+    return s->realized && s->running && s->queue_ready && !s->poison &&
+           s->vm_epoch != UINT64_MAX && s->queue_epoch != UINT64_MAX &&
+           s->device_epoch != UINT64_MAX && (s->status & driver_ok) &&
+           (s->features & required_features) == required_features;
+}
+
+static inline bool rpl_unchanged(const RplSnapshot *before,
+                                 const RplSnapshot *after,
+                                 uint64_t required_features, uint8_t driver_ok)
+{
+    return rpl_ready(before, required_features, driver_ok) &&
+           rpl_ready(after, required_features, driver_ok) &&
+           before->vm_epoch == after->vm_epoch &&
+           before->queue_epoch == after->queue_epoch &&
+           before->device_epoch == after->device_epoch &&
+           before->features == after->features && before->status == after->status;
+}
+
+static inline bool rpl_resume_cpu(bool stopped_before, bool stop_before,
+                                   bool same_vm_epoch, bool running_now)
+{
+    return !stopped_before && !stop_before && same_vm_epoch && running_now;
+}
+#endif

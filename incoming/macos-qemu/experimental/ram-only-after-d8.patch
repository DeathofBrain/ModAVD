+                    " flags=%" PRIu64 " mapping_generation=%" PRIu64
+                    " fault=%d hv=0x%x mach=%u strict_bytes_total=%" PRIu64
+                    " committed_bytes_total=%" PRIu64 " committed_ranges=%" PRIu64
+                    " rolled_back_ranges=%" PRIu64 " cleanup_failed=%d"

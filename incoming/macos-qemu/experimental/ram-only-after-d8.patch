+void *memory_region_get_ram_ptr_sized(MemoryRegion *mr, uint64_t offset,
+                                      uint64_t length)
+{
+    void *ptr = NULL;
+    unsigned depth = 0;
+
+    if (!length) {
+        return NULL;
+    }
+    rcu_read_lock();
+    for (;;) {
+        if (++depth > 64 || int128_ge(int128_make64(offset), mr->size) ||
+            int128_gt(int128_make64(length),
+                      int128_sub(mr->size, int128_make64(offset)))) {
+            break;
+        }
+        if (!mr->alias) {
+            RAMBlock *rb = mr->ram_block;
+            if (rb && rb->host && offset < rb->used_length &&
+                length <= rb->used_length - offset) {
+                ptr = qemu_map_ram_ptr_sized(rb, offset, length);
+            }
+            break;
+        }
+        if (mr->alias_offset > UINT64_MAX - offset) {
+            break;
+        }
+        offset += mr->alias_offset;
+        mr = mr->alias;
+    }
+    rcu_read_unlock();
+    return ptr;
+}
+
+void *memory_region_get_ram_ptr_for_accel(MemoryRegion *mr)
+{
+    return memory_region_ram_ptr_internal(mr, true);
 }
 

 void VideoFrameSharer::start() {
+    std::lock_guard<std::mutex> lock(mLifecycleLock);
+    if (mStarted) {
+        return;
+    }
     gpu_register_shared_memory_callback(&VideoFrameSharer::frameCallbackForwarder, this);
+    mStarted = true;
 }
 
 void VideoFrameSharer::stop() {
+    std::lock_guard<std::mutex> lock(mLifecycleLock);
+    if (!mStarted) {
+        return;
+    }
+    // unregister waits for in-flight callbacks before the memory can be closed.
     gpu_unregister_shared_memory_callback(this);
+    mStarted = false;
 }
 
